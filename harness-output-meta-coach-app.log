{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_012fxibbZvebCt4ESZoyewaX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H2D1kXj8pQuBHYyxmTQpK2","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/email-service.ts","content":"import { supabaseAdmin } from './supabase'\n\nexport interface EmailTemplate {\n  subject: string\n  body: string\n  html: string\n  attachments?: {\n    filename: string\n    content: Buffer | string\n    contentType: string\n  }[]\n}\n\nexport interface ReportSchedule {\n  id: string\n  meta_account_id: string\n  frequency: 'daily' | 'weekly' | 'monthly'\n  send_day?: number // 0-6 for weekly, 1-31 for monthly\n  send_time: string // HH:MM format\n  recipients: string[]\n  enabled: boolean\n  created_at: string\n  updated_at: string\n}\n\nexport class EmailService {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Send a report via email\n   */\n  async sendReportEmail(\n    recipients: string[],\n    reportData: {\n      title: string\n      period: string\n      metrics: any\n      attachment: {\n        filename: string\n        content: Buffer | string\n      }\n    }\n  ): Promise<{\n    success: boolean\n    messageId?: string\n    error?: string\n  }> {\n    try {\n      const template = this.generateEmailTemplate(reportData)\n\n      // In production, integrate with email service (SendGrid, AWS SES, etc.)\n      // For now, we'll store in database and log\n      const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`\n\n      // Store email record\n      await this.supabase.from('meta_email_logs').insert([\n        {\n          id: messageId,\n          recipients: recipients.join(','),\n          subject: template.subject,\n          status: 'sent',\n          sent_at: new Date().toISOString(),\n          attachment_filename: reportData.attachment.filename,\n        },\n      ])\n\n      return {\n        success: true,\n        messageId,\n      }\n    } catch (error: any) {\n      return {\n        success: false,\n        error: error.message,\n      }\n    }\n  }\n\n  /**\n   * Generate email template for report\n   */\n  private generateEmailTemplate(reportData: {\n    title: string\n    period: string\n    metrics: any\n  }): EmailTemplate {\n    const { title, period, metrics } = reportData\n\n    const htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: #007bff; color: white; padding: 20px; text-align: center; border-radius: 4px 4px 0 0; }\n    .header h1 { margin: 0; }\n    .content { background: #f9f9f9; padding: 20px; border: 1px solid #eee; }\n    .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin: 20px 0; }\n    .metric { background: white; padding: 15px; border-radius: 4px; border-left: 3px solid #007bff; }\n    .metric-label { font-size: 12px; color: #666; text-transform: uppercase; }\n    .metric-value { font-size: 20px; font-weight: bold; color: #333; }\n    .cta { text-align: center; margin: 20px 0; }\n    .cta a { background: #007bff; color: white; padding: 12px 30px; text-decoration: none; border-radius: 4px; display: inline-block; }\n    .footer { margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee; font-size: 12px; color: #999; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>${title}</h1>\n      <p>Performance Report for ${period}</p>\n    </div>\n\n    <div class=\"content\">\n      <p>Hi there,</p>\n      <p>Your monthly performance report is ready. Here are the highlights:</p>\n\n      <div class=\"metrics\">\n        <div class=\"metric\">\n          <div class=\"metric-label\">Total Spend</div>\n          <div class=\"metric-value\">$${metrics.total_spend.toFixed(2)}</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">Conversions</div>\n          <div class=\"metric-value\">${Math.round(metrics.total_conversions)}</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">ROAS</div>\n          <div class=\"metric-value\">${metrics.avg_roas.toFixed(2)}x</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">CTR</div>\n          <div class=\"metric-value\">${(metrics.avg_ctr * 100).toFixed(2)}%</div>\n        </div>\n      </div>\n\n      <p>Your full detailed report is attached as a PDF. It includes campaign analysis, performance trends, and actionable recommendations.</p>\n\n      <div class=\"cta\">\n        <a href=\"https://metacoach.example.com/reports\">View Full Report</a>\n      </div>\n\n      <p>Have questions? Reply to this email or contact our support team.</p>\n\n      <div class=\"footer\">\n        <p>MetaCoach &mdash; Intelligent Meta Ads Coaching Platform</p>\n        <p>&copy; 2024. All rights reserved.</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n    `\n\n    return {\n      subject: `${title} - ${period}`,\n      body: `Your ${title} is ready for ${period}. See attached PDF for full details.`,\n      html: htmlBody,\n    }\n  }\n\n  /**\n   * Create a report schedule\n   */\n  async createSchedule(schedule: Omit<ReportSchedule, 'id' | 'created_at' | 'updated_at'>): Promise<ReportSchedule> {\n    const id = `schedule_${Date.now()}`\n    const now = new Date().toISOString()\n\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .insert([\n        {\n          id,\n          ...schedule,\n          created_at: now,\n          updated_at: now,\n        },\n      ])\n      .select()\n      .single()\n\n    if (error) throw error\n\n    return {\n      ...data,\n    }\n  }\n\n  /**\n   * Update a report schedule\n   */\n  async updateSchedule(scheduleId: string, updates: Partial<ReportSchedule>): Promise<ReportSchedule> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .update({\n        ...updates,\n        updated_at: new Date().toISOString(),\n      })\n      .eq('id', scheduleId)\n      .select()\n      .single()\n\n    if (error) throw error\n\n    return data\n  }\n\n  /**\n   * Delete a report schedule\n   */\n  async deleteSchedule(scheduleId: string): Promise<void> {\n    const { error } = await this.supabase\n      .from('meta_report_schedules')\n      .delete()\n      .eq('id', scheduleId)\n\n    if (error) throw error\n  }\n\n  /**\n   * Get all schedules for an account\n   */\n  async getSchedules(accountId: string): Promise<ReportSchedule[]> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('created_at', { ascending: false })\n\n    if (error) throw error\n\n    return data || []\n  }\n\n  /**\n   * Get a specific schedule\n   */\n  async getSchedule(scheduleId: string): Promise<ReportSchedule | null> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('id', scheduleId)\n      .single()\n\n    if (error) return null\n\n    return data\n  }\n\n  /**\n   * Check if a report should be sent based on schedule\n   */\n  shouldSendReport(schedule: ReportSchedule): boolean {\n    const now = new Date()\n    const currentDay = now.getDay() // 0-6\n    const currentDate = now.getDate() // 1-31\n    const currentTime = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0')\n\n    // Check if enabled\n    if (!schedule.enabled) return false\n\n    // Check time\n    if (currentTime !== schedule.send_time) return false\n\n    // Check frequency\n    switch (schedule.frequency) {\n      case 'daily':\n        return true\n      case 'weekly':\n        return currentDay === (schedule.send_day || 0)\n      case 'monthly':\n        return currentDate === (schedule.send_day || 1)\n      default:\n        return false\n    }\n  }\n\n  /**\n   * Get all schedules that should send reports now\n   */\n  async getSchedulesToProcess(): Promise<ReportSchedule[]> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('enabled', true)\n\n    if (error) return []\n\n    return (data || []).filter((schedule) => this.shouldSendReport(schedule))\n  }\n}\n\nexport default new EmailService()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3920,"cache_read_input_tokens":134705,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3920},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"9a0d6afa-4df3-4dd8-b09a-79ac7bcdac55"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H2D1kXj8pQuBHYyxmTQpK2","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/MetaCoach/lib/email-service.ts"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"b42400f5-6436-49ff-a023-ce11e6bcab08","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/email-service.ts","content":"import { supabaseAdmin } from './supabase'\n\nexport interface EmailTemplate {\n  subject: string\n  body: string\n  html: string\n  attachments?: {\n    filename: string\n    content: Buffer | string\n    contentType: string\n  }[]\n}\n\nexport interface ReportSchedule {\n  id: string\n  meta_account_id: string\n  frequency: 'daily' | 'weekly' | 'monthly'\n  send_day?: number // 0-6 for weekly, 1-31 for monthly\n  send_time: string // HH:MM format\n  recipients: string[]\n  enabled: boolean\n  created_at: string\n  updated_at: string\n}\n\nexport class EmailService {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Send a report via email\n   */\n  async sendReportEmail(\n    recipients: string[],\n    reportData: {\n      title: string\n      period: string\n      metrics: any\n      attachment: {\n        filename: string\n        content: Buffer | string\n      }\n    }\n  ): Promise<{\n    success: boolean\n    messageId?: string\n    error?: string\n  }> {\n    try {\n      const template = this.generateEmailTemplate(reportData)\n\n      // In production, integrate with email service (SendGrid, AWS SES, etc.)\n      // For now, we'll store in database and log\n      const messageId = `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`\n\n      // Store email record\n      await this.supabase.from('meta_email_logs').insert([\n        {\n          id: messageId,\n          recipients: recipients.join(','),\n          subject: template.subject,\n          status: 'sent',\n          sent_at: new Date().toISOString(),\n          attachment_filename: reportData.attachment.filename,\n        },\n      ])\n\n      return {\n        success: true,\n        messageId,\n      }\n    } catch (error: any) {\n      return {\n        success: false,\n        error: error.message,\n      }\n    }\n  }\n\n  /**\n   * Generate email template for report\n   */\n  private generateEmailTemplate(reportData: {\n    title: string\n    period: string\n    metrics: any\n  }): EmailTemplate {\n    const { title, period, metrics } = reportData\n\n    const htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: #007bff; color: white; padding: 20px; text-align: center; border-radius: 4px 4px 0 0; }\n    .header h1 { margin: 0; }\n    .content { background: #f9f9f9; padding: 20px; border: 1px solid #eee; }\n    .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin: 20px 0; }\n    .metric { background: white; padding: 15px; border-radius: 4px; border-left: 3px solid #007bff; }\n    .metric-label { font-size: 12px; color: #666; text-transform: uppercase; }\n    .metric-value { font-size: 20px; font-weight: bold; color: #333; }\n    .cta { text-align: center; margin: 20px 0; }\n    .cta a { background: #007bff; color: white; padding: 12px 30px; text-decoration: none; border-radius: 4px; display: inline-block; }\n    .footer { margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee; font-size: 12px; color: #999; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>${title}</h1>\n      <p>Performance Report for ${period}</p>\n    </div>\n\n    <div class=\"content\">\n      <p>Hi there,</p>\n      <p>Your monthly performance report is ready. Here are the highlights:</p>\n\n      <div class=\"metrics\">\n        <div class=\"metric\">\n          <div class=\"metric-label\">Total Spend</div>\n          <div class=\"metric-value\">$${metrics.total_spend.toFixed(2)}</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">Conversions</div>\n          <div class=\"metric-value\">${Math.round(metrics.total_conversions)}</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">ROAS</div>\n          <div class=\"metric-value\">${metrics.avg_roas.toFixed(2)}x</div>\n        </div>\n        <div class=\"metric\">\n          <div class=\"metric-label\">CTR</div>\n          <div class=\"metric-value\">${(metrics.avg_ctr * 100).toFixed(2)}%</div>\n        </div>\n      </div>\n\n      <p>Your full detailed report is attached as a PDF. It includes campaign analysis, performance trends, and actionable recommendations.</p>\n\n      <div class=\"cta\">\n        <a href=\"https://metacoach.example.com/reports\">View Full Report</a>\n      </div>\n\n      <p>Have questions? Reply to this email or contact our support team.</p>\n\n      <div class=\"footer\">\n        <p>MetaCoach &mdash; Intelligent Meta Ads Coaching Platform</p>\n        <p>&copy; 2024. All rights reserved.</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n    `\n\n    return {\n      subject: `${title} - ${period}`,\n      body: `Your ${title} is ready for ${period}. See attached PDF for full details.`,\n      html: htmlBody,\n    }\n  }\n\n  /**\n   * Create a report schedule\n   */\n  async createSchedule(schedule: Omit<ReportSchedule, 'id' | 'created_at' | 'updated_at'>): Promise<ReportSchedule> {\n    const id = `schedule_${Date.now()}`\n    const now = new Date().toISOString()\n\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .insert([\n        {\n          id,\n          ...schedule,\n          created_at: now,\n          updated_at: now,\n        },\n      ])\n      .select()\n      .single()\n\n    if (error) throw error\n\n    return {\n      ...data,\n    }\n  }\n\n  /**\n   * Update a report schedule\n   */\n  async updateSchedule(scheduleId: string, updates: Partial<ReportSchedule>): Promise<ReportSchedule> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .update({\n        ...updates,\n        updated_at: new Date().toISOString(),\n      })\n      .eq('id', scheduleId)\n      .select()\n      .single()\n\n    if (error) throw error\n\n    return data\n  }\n\n  /**\n   * Delete a report schedule\n   */\n  async deleteSchedule(scheduleId: string): Promise<void> {\n    const { error } = await this.supabase\n      .from('meta_report_schedules')\n      .delete()\n      .eq('id', scheduleId)\n\n    if (error) throw error\n  }\n\n  /**\n   * Get all schedules for an account\n   */\n  async getSchedules(accountId: string): Promise<ReportSchedule[]> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('created_at', { ascending: false })\n\n    if (error) throw error\n\n    return data || []\n  }\n\n  /**\n   * Get a specific schedule\n   */\n  async getSchedule(scheduleId: string): Promise<ReportSchedule | null> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('id', scheduleId)\n      .single()\n\n    if (error) return null\n\n    return data\n  }\n\n  /**\n   * Check if a report should be sent based on schedule\n   */\n  shouldSendReport(schedule: ReportSchedule): boolean {\n    const now = new Date()\n    const currentDay = now.getDay() // 0-6\n    const currentDate = now.getDate() // 1-31\n    const currentTime = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0')\n\n    // Check if enabled\n    if (!schedule.enabled) return false\n\n    // Check time\n    if (currentTime !== schedule.send_time) return false\n\n    // Check frequency\n    switch (schedule.frequency) {\n      case 'daily':\n        return true\n      case 'weekly':\n        return currentDay === (schedule.send_day || 0)\n      case 'monthly':\n        return currentDate === (schedule.send_day || 1)\n      default:\n        return false\n    }\n  }\n\n  /**\n   * Get all schedules that should send reports now\n   */\n  async getSchedulesToProcess(): Promise<ReportSchedule[]> {\n    const { data, error } = await this.supabase\n      .from('meta_report_schedules')\n      .select('*')\n      .eq('enabled', true)\n\n    if (error) return []\n\n    return (data || []).filter((schedule) => this.shouldSendReport(schedule))\n  }\n}\n\nexport default new EmailService()\n","structuredPatch":[],"originalFile":null}}
