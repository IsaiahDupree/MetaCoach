{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01Kg1dkhmAbpgLEznzDJMwRi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DrPLAFjTZVotbhtZh2eBXT","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/health/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\n\ninterface HealthResponse {\n  status: 'healthy' | 'degraded' | 'unhealthy'\n  timestamp: string\n  version: string\n  services: {\n    database: {\n      status: 'up' | 'down'\n      latency_ms: number\n    }\n  }\n  uptime_ms?: number\n}\n\nconst startTime = Date.now()\n\nexport async function GET(req: NextRequest): Promise<NextResponse<HealthResponse>> {\n  const requestStart = Date.now()\n\n  try {\n    // Check database connectivity\n    const dbStart = Date.now()\n    const supabase = supabaseAdmin()\n\n    // Perform a simple query to verify database connection\n    const { error } = await supabase\n      .from('users')\n      .select('count', { count: 'exact', head: true })\n      .limit(0)\n\n    const dbLatency = Date.now() - dbStart\n\n    if (error && error.code !== 'PGRST116') {\n      // PGRST116 is \"no rows returned\" which is expected for a limit(0) query\n      throw error\n    }\n\n    const responseTime = Date.now() - requestStart\n    let overallStatus: 'healthy' | 'degraded' | 'unhealthy' = 'healthy'\n\n    // Degrade if database latency is high\n    if (dbLatency > 1000) {\n      overallStatus = 'degraded'\n    }\n\n    return NextResponse.json<HealthResponse>(\n      {\n        status: overallStatus,\n        timestamp: new Date().toISOString(),\n        version: '1.0.0',\n        services: {\n          database: {\n            status: 'up',\n            latency_ms: dbLatency,\n          },\n        },\n        uptime_ms: Date.now() - startTime,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Health check failed:', error)\n\n    return NextResponse.json<HealthResponse>(\n      {\n        status: 'unhealthy',\n        timestamp: new Date().toISOString(),\n        version: '1.0.0',\n        services: {\n          database: {\n            status: 'down',\n            latency_ms: Date.now() - requestStart,\n          },\n        },\n        uptime_ms: Date.now() - startTime,\n      },\n      { status: 503 }\n    )\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":771,"cache_read_input_tokens":104493,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":771},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"03b2985d-d4af-47fa-a466-9d415166bdc7"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrPLAFjTZVotbhtZh2eBXT","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/MetaCoach/app/api/health/route.ts"}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"43db5475-f9bf-4561-ac84-c164e5040d34","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/health/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\n\ninterface HealthResponse {\n  status: 'healthy' | 'degraded' | 'unhealthy'\n  timestamp: string\n  version: string\n  services: {\n    database: {\n      status: 'up' | 'down'\n      latency_ms: number\n    }\n  }\n  uptime_ms?: number\n}\n\nconst startTime = Date.now()\n\nexport async function GET(req: NextRequest): Promise<NextResponse<HealthResponse>> {\n  const requestStart = Date.now()\n\n  try {\n    // Check database connectivity\n    const dbStart = Date.now()\n    const supabase = supabaseAdmin()\n\n    // Perform a simple query to verify database connection\n    const { error } = await supabase\n      .from('users')\n      .select('count', { count: 'exact', head: true })\n      .limit(0)\n\n    const dbLatency = Date.now() - dbStart\n\n    if (error && error.code !== 'PGRST116') {\n      // PGRST116 is \"no rows returned\" which is expected for a limit(0) query\n      throw error\n    }\n\n    const responseTime = Date.now() - requestStart\n    let overallStatus: 'healthy' | 'degraded' | 'unhealthy' = 'healthy'\n\n    // Degrade if database latency is high\n    if (dbLatency > 1000) {\n      overallStatus = 'degraded'\n    }\n\n    return NextResponse.json<HealthResponse>(\n      {\n        status: overallStatus,\n        timestamp: new Date().toISOString(),\n        version: '1.0.0',\n        services: {\n          database: {\n            status: 'up',\n            latency_ms: dbLatency,\n          },\n        },\n        uptime_ms: Date.now() - startTime,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Health check failed:', error)\n\n    return NextResponse.json<HealthResponse>(\n      {\n        status: 'unhealthy',\n        timestamp: new Date().toISOString(),\n        version: '1.0.0',\n        services: {\n          database: {\n            status: 'down',\n            latency_ms: Date.now() - requestStart,\n          },\n        },\n        uptime_ms: Date.now() - startTime,\n      },\n      { status: 503 }\n    )\n  }\n}\n","structuredPatch":[],"originalFile":null}}
