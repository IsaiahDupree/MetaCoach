{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01SZXCuJs7t4uqsaP8W1CyGh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ax68P5uT538Jrr8f9TC6kv","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/components/RecommendationModal.tsx","content":"'use client'\n\nimport { X } from 'lucide-react'\n\nexport interface Recommendation {\n  id: string\n  title: string\n  description: string\n  priority: 'high' | 'medium' | 'low'\n  confidence_score: number\n  estimated_impact: number\n  estimated_effort?: 'low' | 'medium' | 'high'\n  implementation_instructions?: string\n  recommendation_type?: string\n}\n\ninterface RecommendationModalProps {\n  recommendation: Recommendation | null\n  isOpen: boolean\n  onClose: () => void\n  onImplement?: (id: string) => void\n}\n\nexport function RecommendationModal({\n  recommendation,\n  isOpen,\n  onClose,\n  onImplement,\n}: RecommendationModalProps) {\n  if (!isOpen || !recommendation) return null\n\n  const priorityColors = {\n    high: {\n      bg: 'bg-red-50',\n      border: 'border-red-200',\n      text: 'text-red-800',\n      badge: 'bg-red-100 text-red-800',\n    },\n    medium: {\n      bg: 'bg-yellow-50',\n      border: 'border-yellow-200',\n      text: 'text-yellow-800',\n      badge: 'bg-yellow-100 text-yellow-800',\n    },\n    low: {\n      bg: 'bg-blue-50',\n      border: 'border-blue-200',\n      text: 'text-blue-800',\n      badge: 'bg-blue-100 text-blue-800',\n    },\n  }\n\n  const colors = priorityColors[recommendation.priority]\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto\">\n      {/* Overlay */}\n      <div\n        className=\"fixed inset-0 bg-black/50 transition-opacity\"\n        onClick={onClose}\n      />\n\n      {/* Modal */}\n      <div className=\"flex min-h-screen items-center justify-center p-4 sm:p-0\">\n        <div className=\"relative w-full max-w-2xl transform transition-all\">\n          <div className={`rounded-lg shadow-xl ${colors.bg} border ${colors.border}`}>\n            {/* Header */}\n            <div className=\"flex items-start justify-between border-b p-6\">\n              <div className=\"flex-1 pr-4\">\n                <div className=\"flex items-center gap-3\">\n                  <h2 className=\"text-2xl font-bold text-gray-900\">\n                    {recommendation.title}\n                  </h2>\n                  <span\n                    className={`inline-block px-3 py-1 rounded-full text-xs font-medium ${colors.badge}`}\n                  >\n                    {recommendation.priority.charAt(0).toUpperCase() +\n                      recommendation.priority.slice(1)}{' '}\n                    Priority\n                  </span>\n                </div>\n                {recommendation.recommendation_type && (\n                  <p className=\"text-sm text-gray-600 mt-2\">\n                    Type: {recommendation.recommendation_type}\n                  </p>\n                )}\n              </div>\n              <button\n                onClick={onClose}\n                className=\"text-gray-400 hover:text-gray-600\"\n              >\n                <X size={24} />\n              </button>\n            </div>\n\n            {/* Content */}\n            <div className=\"p-6 space-y-6\">\n              {/* Overview */}\n              <div>\n                <h3 className=\"font-semibold text-gray-900 mb-2\">Overview</h3>\n                <p className=\"text-gray-700\">{recommendation.description}</p>\n              </div>\n\n              {/* Metrics Grid */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                <div className=\"bg-white rounded-lg p-4 border border-gray-200\">\n                  <p className=\"text-sm text-gray-600\">Confidence Score</p>\n                  <p className=\"text-2xl font-bold text-gray-900 mt-1\">\n                    {(recommendation.confidence_score * 100).toFixed(0)}%\n                  </p>\n                </div>\n\n                <div className=\"bg-white rounded-lg p-4 border border-gray-200\">\n                  <p className=\"text-sm text-gray-600\">Estimated Impact</p>\n                  <p className=\"text-2xl font-bold text-gray-900 mt-1\">\n                    {(recommendation.estimated_impact * 100).toFixed(0)}%\n                  </p>\n                </div>\n\n                {recommendation.estimated_effort && (\n                  <div className=\"bg-white rounded-lg p-4 border border-gray-200\">\n                    <p className=\"text-sm text-gray-600\">Implementation Effort</p>\n                    <p className=\"text-xl font-bold text-gray-900 mt-1\">\n                      {recommendation.estimated_effort.charAt(0).toUpperCase() +\n                        recommendation.estimated_effort.slice(1)}\n                    </p>\n                  </div>\n                )}\n              </div>\n\n              {/* Implementation Instructions */}\n              {recommendation.implementation_instructions && (\n                <div>\n                  <h3 className=\"font-semibold text-gray-900 mb-2\">\n                    How to Implement\n                  </h3>\n                  <div className=\"bg-white rounded-lg p-4 border border-gray-200\">\n                    <p className=\"text-gray-700 whitespace-pre-line\">\n                      {recommendation.implementation_instructions}\n                    </p>\n                  </div>\n                </div>\n              )}\n\n              {/* Why This Matters */}\n              <div>\n                <h3 className=\"font-semibold text-gray-900 mb-2\">Why This Matters</h3>\n                <div className=\"bg-white rounded-lg p-4 border border-gray-200\">\n                  <p className=\"text-gray-700\">\n                    Based on your current performance metrics, implementing this\n                    recommendation could improve your results by approximately{' '}\n                    <span className=\"font-semibold\">\n                      {(recommendation.estimated_impact * 100).toFixed(0)}%\n                    </span>\n                    .\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Footer */}\n            <div className=\"flex gap-3 border-t bg-gray-50 px-6 py-4 sm:flex-row\">\n              <button\n                onClick={onClose}\n                className=\"flex-1 px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-100\"\n              >\n                Dismiss\n              </button>\n              {onImplement && (\n                <button\n                  onClick={() => {\n                    onImplement(recommendation.id)\n                    onClose()\n                  }}\n                  className=\"flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n                >\n                  Mark as Implemented\n                </button>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":285,"cache_read_input_tokens":120949,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":285},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"0a7a6962-707b-432a-94ba-10b2e85c8b93","uuid":"4f878216-c7ca-4cc9-aa94-15cd63bf41cc"}
