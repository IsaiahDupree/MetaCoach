{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_015AgDcracFTEAc25RhpnbHj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H4xs9qcm6mtSv2fVVB7cEW","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/recommendations/list/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { createProtectedRoute } from '@/lib/auth-middleware'\n\nconst handler = async (req: NextRequest & { userId?: string }) => {\n  try {\n    if (!req.userId) {\n      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })\n    }\n\n    const supabase = supabaseAdmin()\n    const accountId = req.nextUrl.searchParams.get('account_id')\n    const implementedOnly = req.nextUrl.searchParams.get('implemented') === 'true'\n    const type = req.nextUrl.searchParams.get('type')\n\n    if (!accountId) {\n      return NextResponse.json(\n        { error: 'account_id query parameter is required' },\n        { status: 400 }\n      )\n    }\n\n    // Verify account ownership\n    const { data: account } = await supabase\n      .from('meta_accounts')\n      .select('id')\n      .eq('id', accountId)\n      .eq('user_id', req.userId)\n      .single()\n\n    if (!account) {\n      return NextResponse.json(\n        { error: 'Account not found or unauthorized' },\n        { status: 404 }\n      )\n    }\n\n    // Build query\n    let query = supabase\n      .from('meta_coach_recommendations')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('created_at', { ascending: false })\n\n    if (implementedOnly) {\n      query = query.eq('is_implemented', true)\n    }\n\n    if (type) {\n      query = query.eq('recommendation_type', type)\n    }\n\n    const { data: recommendations, error } = await query\n\n    if (error) {\n      console.error('Error fetching recommendations:', error)\n      return NextResponse.json(\n        { error: 'Failed to fetch recommendations' },\n        { status: 500 }\n      )\n    }\n\n    // Calculate summary stats\n    const summary = {\n      total: recommendations?.length || 0,\n      implemented: recommendations?.filter((r: any) => r.is_implemented).length || 0,\n      pending: recommendations?.filter((r: any) => !r.is_implemented).length || 0,\n      byType: {\n        budget: recommendations?.filter((r: any) => r.recommendation_type === 'budget').length || 0,\n        creative: recommendations?.filter((r: any) => r.recommendation_type === 'creative').length || 0,\n        audience: recommendations?.filter((r: any) => r.recommendation_type === 'audience').length || 0,\n        targeting: recommendations?.filter((r: any) => r.recommendation_type === 'targeting').length || 0,\n      },\n    }\n\n    return NextResponse.json(\n      {\n        success: true,\n        summary,\n        recommendations: recommendations || [],\n        count: recommendations?.length || 0,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Error fetching recommendations:', error)\n    return NextResponse.json(\n      { error: 'An error occurred' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const GET = createProtectedRoute(handler)\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":433,"cache_read_input_tokens":156774,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":433},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"619909d4-1885-4a59-a48d-44a919ec516b"}
