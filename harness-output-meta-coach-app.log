        \"Filterable by status/objective\",\n        \"Pagination for 100+ campaigns\",\n        \"Click row to view campaign details\"\n      ],\n      \"dependencies\": [\n        \"META-004\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-UI-001\",\n      \"name\": \"Recommendations Panel & Display\",\n      \"description\": \"Display coaching recommendations in priority order\",\n      \"priority\": \"P0\",\n      \"phase\": 5,\n      \"effort\": \"6h\",\n      \"passes\": true,\n      \"category\": \"ui\",\n      \"files\": [\n        \"components/RecommendationsPanel.tsx\"\n      ],\n      \"acceptance\": [\n        \"Top recommendations displayed prominently\",\n        \"Color-coded by priority/impact\",\n        \"Recommendation details expandable\",\n        \"Implementation instructions clear\",\n        \"Dismiss/snooze options available\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-UI-002\",\n      \"name\": \"Recommendation Details Modal\",\n      \"description\": \"Detailed view of individual recommendations with rationale\",\n      \"priority\": \"P1\",\n      \"phase\": 5,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"ui\",\n      \"files\": [\n        \"components/RecommendationModal.tsx\"\n      ],\n      \"acceptance\": [\n        \"Recommendation details clearly explained\",\n        \"Data supporting recommendation shown\",\n        \"Implementation steps listed\",\n        \"Expected impact quantified\",\n        \"Link to implement (external or internal)\"\n      ],\n      \"dependencies\": [\n        \"COACH-UI-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"REPORT-001\",\n      \"name\": \"Client Report Generation\",\n      \"description\": \"Generate comprehensive performance reports for clients\",\n      \"priority\": \"P1\",\n      \"phase\": 5,\n      \"effort\": \"8h\",\n      \"passes\": false,\n      \"category\": \"reporting\",\n      \"files\": [\n        \"lib/report-generator.ts\",\n        \"api/reports/generate.ts\"\n      ],\n      \"acceptance\": [\n        \"Report includes executive summary\",\n        \"Performance metrics for period\",\n        \"Top recommendations listed\",\n        \"Budget vs spend analysis\",\n        \"Charts and visualizations included\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\",\n        \"PERF-001\"\n      ]\n    },\n    {\n      \"id\": \"REPORT-002\",\n      \"name\": \"PDF Report Export\",\n      \"description\": \"Export reports as downloadable PDF\",\n      \"priority\": \"P1\",\n      \"phase\": 5,\n      \"effort\": \"4h\",\n      \"passes\": false,\n      \"category\": \"reporting\",\n      \"files\": [\n        \"lib/pdf-export.ts\"\n      ],\n      \"acceptance\": [\n        \"PDF generated with correct formatting\",\n        \"All charts embedded as images\",\n        \"Branding and logo included\",\n        \"File size < 5MB\",\n        \"Compatible with all PDF readers\"\n      ],\n      \"dependencies\": [\n        \"REPORT-001\"\n      ]\n    },\n    {\n      \"id\": \"REPORT-003\",\n      \"name\": \"Email Report Delivery\",\n      \"description\": \"Send reports to clients via email automatically\",\n      \"priority\": \"P1\",\n      \"phase\": 5,\n      \"effort\": \"6h\",\n      \"passes\": false,\n      \"category\": \"reporting\",\n      \"files\": [\n        \"api/reports/email.ts\",\n        \"lib/email.ts\"\n      ],\n      \"acceptance\": [\n        \"Reports scheduled for weekly/monthly delivery\",\n        \"Email template professional and branded\",\n        \"PDF attachment included\",\n        \"Recipient list configurable\",\n        \"Delivery status tracked\"\n      ],\n      \"dependencies\": [\n        \"REPORT-002\"\n      ]\n    },\n    {\n      \"id\": \"REPORT-004\",\n      \"name\": \"Report Scheduling & Autom