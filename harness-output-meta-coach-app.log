{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W5teAAV5BT2hKzehkrFYQi","type":"tool_result","content":"     1→import { supabaseAdmin } from './supabase'\n     2→\n     3→export interface Recommendation {\n     4→  id: string\n     5→  meta_account_id: string\n     6→  recommendation_type: 'budget' | 'creative' | 'audience' | 'targeting'\n     7→  title: string\n     8→  description: string\n     9→  confidence_score: number\n    10→  estimated_impact: number\n    11→  estimated_effort: 'low' | 'medium' | 'high'\n    12→  implementation_instructions: string\n    13→  priority: 'high' | 'medium' | 'low'\n    14→}\n    15→\n    16→export interface PerformanceData {\n    17→  impressions: number\n    18→  clicks: number\n    19→  spend: number\n    20→  actions: number\n    21→  action_value: number\n    22→  ctr: number\n    23→  cpc: number\n    24→  cpa: number\n    25→  roas: number\n    26→}\n    27→\n    28→export class RecommendationEngine {\n    29→  private supabase = supabaseAdmin()\n    30→\n    31→  /**\n    32→   * Generate recommendations for an ad account\n    33→   */\n    34→  async generateRecommendations(accountId: string): Promise<Recommendation[]> {\n    35→    const recommendations: Recommendation[] = []\n    36→\n    37→    // Get ad performance data for the last 30 days\n    38→    const thirtyDaysAgo = new Date()\n    39→    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n    40→\n    41→    const { data: metrics } = await this.supabase\n    42→      .from('meta_ad_performance')\n    43→      .select(\n    44→        `\n    45→        meta_ad_id,\n    46→        date,\n    47→        impressions,\n    48→        clicks,\n    49→        spend,\n    50→        actions,\n    51→        action_value,\n    52→        ctr,\n    53→        cpc,\n    54→        cpa,\n    55→        roas,\n    56→        meta_ads(\n    57→          id,\n    58→          meta_ad_set_id,\n    59→          meta_ad_sets(\n    60→            meta_account_id\n    61→          )\n    62→        )\n    63→      `\n    64→      )\n    65→      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n    66→\n    67→    if (!metrics || metrics.length === 0) {\n    68→      return recommendations\n    69→    }\n    70→\n    71→    // Analyze performance and generate recommendations\n    72→    recommendations.push(...this.generateBudgetRecommendations(metrics))\n    73→    recommendations.push(...this.generateCreativeRecommendations(metrics))\n    74→    recommendations.push(...this.generateAudienceRecommendations(metrics))\n    75→\n    76→    return recommendations\n    77→  }\n    78→\n    79→  /**\n    80→   * Generate budget optimization recommendations\n    81→   */\n    82→  private generateBudgetRecommendations(metrics: any[]): Recommendation[] {\n    83→    const recommendations: Recommendation[] = []\n    84→\n    85→    // Group metrics by ad set\n    86→    const adSetMetrics: { [key: string]: any[] } = {}\n    87→    metrics.forEach((metric) => {\n    88→      const adSetId = metric.meta_ads?.meta_ad_set_id\n    89→      if (adSetId) {\n    90→        if (!adSetMetrics[adSetId]) {\n    91→          adSetMetrics[adSetId] = []\n    92→        }\n    93→        adSetMetrics[adSetId].push(metric)\n    94→      }\n    95→    })\n    96→\n    97→    // Analyze each ad set\n    98→    Object.entries(adSetMetrics).forEach(([adSetId, adSetMetrics]) => {\n    99→      const avgRoas = adSetMetrics.reduce((sum, m) => sum + (m.roas || 0), 0) / adSetMetrics.length\n   100→      const avgCtr = adSetMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / adSetMetrics.length\n   101→      const totalSpend = adSetMetrics.reduce((sum, m) => sum + (m.spend || 0), 0)\n   102→\n   103→      // Recommendation: Increase budget for high-performing ad sets\n   104→      if (avgRoas > 2.0 && totalSpend < 1000) {\n   105→        recommendations.push({\n   106→          id: `budget-increase-${adSetId}`,\n   107→          meta_account_id: '',\n   108→          recommendation_type: 'budget',\n   109→          title: 'Increase Budget for High-Performing Ad Set',\n   110→          description: `This ad set is showing strong performance with a ${avgRoas.toFixed(2)}x ROAS. Consider increasing the daily budget to scale results.`,\n   111→          confidence_score: 0.85,\n   112→          estimated_impact: avgRoas > 3 ? 40 : 25,\n   113→          estimated_effort: 'low',\n   114→          implementation_instructions: `Increase the daily budget by 25-50% in Meta Ads Manager. Monitor for 5-7 days and adjust if performance declines.`,\n   115→          priority: 'high',\n   116→        })\n   117→      }\n   118→\n   119→      // Recommendation: Decrease budget for low-performing ad sets\n   120→      if (avgRoas < 1.0 && totalSpend > 500) {\n   121→        recommendations.push({\n   122→          id: `budget-decrease-${adSetId}`,\n   123→          meta_account_id: '',\n   124→          recommendation_type: 'budget',\n   125→          title: 'Decrease Budget for Underperforming Ad Set',\n   126→          description: `This ad set has a ROAS of ${avgRoas.toFixed(2)}x, which is below profitability. Consider reducing the budget or pausing the ad set.`,\n   127→          confidence_score: 0.8,\n   128→          estimated_impact: -15,\n   129→          estimated_effort: 'low',\n   130→          implementation_instructions: `Reduce daily budget by 25-50% or pause the ad set entirely. Reallocate budget to higher-performing campaigns.`,\n   131→          priority: 'high',\n   132→        })\n   133→      }\n   134→\n   135→      // Recommendation: Optimize CTR\n   136→      if (avgCtr < 1.0) {\n   137→        recommendations.push({\n   138→          id: `ctr-optimization-${adSetId}`,\n   139→          meta_account_id: '',\n   140→          recommendation_type: 'budget',\n   141→          title: 'Budget Pacing Issue',\n   142→          description: `CTR is below 1%, suggesting possible audience fatigue or poor targeting.`,\n   143→          confidence_score: 0.7,\n   144→          estimated_impact: 20,\n   145→          estimated_effort: 'medium',\n   146→          implementation_instructions: `Review audience targeting. Consider expanding audience or creating new ad sets with fresh creative.`,\n   147→          priority: 'medium',\n   148→        })\n   149→      }\n   150→    })\n   151→\n   152→    return recommendations\n   153→  }\n   154→\n   155→  /**\n   156→   * Generate creative refresh recommendations\n   157→   */\n   158→  private generateCreativeRecommendations(metrics: any[]): Recommendation[] {\n   159→    const recommendations: Recommendation[] = []\n   160→\n   161→    // Group by creative/ad\n   162→    const adMetrics: { [key: string]: any[] } = {}\n   163→    metrics.forEach((metric) => {\n   164→      const adId = metric.meta_ad_id\n   165→      if (adId) {\n   166→        if (!adMetrics[adId]) {\n   167→          adMetrics[adId] = []\n   168→        }\n   169→        adMetrics[adId].push(metric)\n   170→      }\n   171→    })\n   172→\n   173→    // Analyze creative performance\n   174→    Object.entries(adMetrics).forEach(([adId, creativeMetrics]) => {\n   175→      const avgCtr = creativeMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / creativeMetrics.length\n   176→      const daysActive = creativeMetrics.length\n   177→      const impressions = creativeMetrics.reduce((sum, m) => sum + (m.impressions || 0), 0)\n   178→\n   179→      // Ad fatigue detection\n   180→      if (daysActive > 14 && impressions > 100000 && avgCtr < 1.0) {\n   181→        recommendations.push({\n   182→          id: `creative-fatigue-${adId}`,\n   183→          meta_account_id: '',\n   184→          recommendation_type: 'creative',\n   185→          title: 'Ad Fatigue Detected',\n   186→          description: `This creative has been running for ${daysActive} days with ${impressions} impressions. CTR is declining, indicating audience fatigue.`,\n   187→          confidence_score: 0.8,\n   188→          estimated_impact: 30,\n   189→          estimated_effort: 'medium',\n   190→          implementation_instructions: `Create 2-3 new variations of this creative with different images, copy, or format. Run A/B tests to identify best performer.`,\n   191→          priority: 'high',\n   192→        })\n   193→      }\n   194→\n   195→      // Low engagement creative\n   196→      if (avgCtr < 0.5 && daysActive > 7) {\n   197→        recommendations.push({\n   198→          id: `low-engagement-${adId}`,\n   199→          meta_account_id: '',\n   200→          recommendation_type: 'creative',\n   201→          title: 'Low Engagement Creative',\n   202→          description: `This creative is underperforming with a CTR of ${avgCtr.toFixed(2)}%.`,\n   203→          confidence_score: 0.75,\n   204→          estimated_impact: 25,\n   205→          estimated_effort: 'high',\n   206→          implementation_instructions: `Review creative elements. Test different headlines, images, or calls-to-action. Consider pausing if no improvement after 7 more days.`,\n   207→          priority: 'medium',\n   208→        })\n   209→      }\n   210→    })\n   211→\n   212→    return recommendations\n   213→  }\n   214→\n   215→  /**\n   216→   * Generate audience targeting recommendations\n   217→   */\n   218→  private generateAudienceRecommendations(metrics: any[]): Recommendation[] {\n   219→    const recommendations: Recommendation[] = []\n   220→\n   221→    // Analyze by age, gender, or other demographics if available\n   222→    // This is a simplified version - in production, you'd have demographic data\n   223→\n   224→    const avgCpa = metrics.reduce((sum, m) => sum + (m.cpa || 0), 0) / metrics.length\n   225→    const avgRoas = metrics.reduce((sum, m) => sum + (m.roas || 0), 0) / metrics.length\n   226→\n   227→    if (avgRoas > 2.0) {\n   228→      recommendations.push({\n   229→        id: 'audience-expansion',\n   230→        meta_account_id: '',\n   231→        recommendation_type: 'audience',\n   232→        title: 'Expand Winning Audience',\n   233→        description: `Your campaigns are performing well with an average ROAS of ${avgRoas.toFixed(2)}x. Consider creating lookalike audiences to scale.`,\n   234→        confidence_score: 0.8,\n   235→        estimated_impact: 35,\n   236→        estimated_effort: 'medium',\n   237→        implementation_instructions: `Create a 1-2% lookalike audience in Meta Ads Manager based on your best converting customers. Start with a test budget.`,\n   238→        priority: 'high',\n   239→      })\n   240→    }\n   241→\n   242→    if (avgCpa > 100) {\n   243→      recommendations.push({\n   244→        id: 'audience-refinement',\n   245→        meta_account_id: '',\n   246→        recommendation_type: 'audience',\n   247→        title: 'Refine Targeting to Reduce CPA',\n   248→        description: `CPA is high at ${avgCpa.toFixed(2)}. Refining your target audience could improve efficiency.`,\n   249→        confidence_score: 0.7,\n   250→        estimated_impact: 20,\n   251→        estimated_effort: 'medium',\n   252→        implementation_instructions: `Review audience demographics and interests. Remove underperforming interests or locations. Test age ranges.`,\n   253→        priority: 'medium',\n   254→      })\n   255→    }\n   256→\n   257→    return recommendations\n   258→  }\n   259→\n   260→  /**\n   261→   * Score and rank recommendations by estimated impact\n   262→   */\n   263→  scoreRecommendations(recommendations: Recommendation[]): Recommendation[] {\n   264→    return recommendations.sort((a, b) => {\n   265→      // Score based on confidence, impact, and effort\n   266→      const scoreA = (a.confidence_score * a.estimated_impact) / (a.estimated_effort === 'high' ? 3 : a.estimated_effort === 'medium' ? 2 : 1)\n   267→      const scoreB = (b.confidence_score * b.estimated_impact) / (b.estimated_effort === 'high' ? 3 : b.estimated_effort === 'medium' ? 2 : 1)\n   268→      return scoreB - scoreA\n   269→    })\n   270→  }\n   271→}\n   272→\n   273→export default new RecommendationEngine()\n   274→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"539145fe-9ba3-4d50-9633-709b7bdb2480","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/recommendation-engine.ts","content":"import { supabaseAdmin } from './supabase'\n\nexport interface Recommendation {\n  id: string\n  meta_account_id: string\n  recommendation_type: 'budget' | 'creative' | 'audience' | 'targeting'\n  title: string\n  description: string\n  confidence_score: number\n  estimated_impact: number\n  estimated_effort: 'low' | 'medium' | 'high'\n  implementation_instructions: string\n  priority: 'high' | 'medium' | 'low'\n}\n\nexport interface PerformanceData {\n  impressions: number\n  clicks: number\n  spend: number\n  actions: number\n  action_value: number\n  ctr: number\n  cpc: number\n  cpa: number\n  roas: number\n}\n\nexport class RecommendationEngine {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Generate recommendations for an ad account\n   */\n  async generateRecommendations(accountId: string): Promise<Recommendation[]> {\n    const recommendations: Recommendation[] = []\n\n    // Get ad performance data for the last 30 days\n    const thirtyDaysAgo = new Date()\n    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n\n    const { data: metrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select(\n        `\n        meta_ad_id,\n        date,\n        impressions,\n        clicks,\n        spend,\n        actions,\n        action_value,\n        ctr,\n        cpc,\n        cpa,\n        roas,\n        meta_ads(\n          id,\n          meta_ad_set_id,\n          meta_ad_sets(\n            meta_account_id\n          )\n        )\n      `\n      )\n      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n\n    if (!metrics || metrics.length === 0) {\n      return recommendations\n    }\n\n    // Analyze performance and generate recommendations\n    recommendations.push(...this.generateBudgetRecommendations(metrics))\n    recommendations.push(...this.generateCreativeRecommendations(metrics))\n    recommendations.push(...this.generateAudienceRecommendations(metrics))\n\n    return recommendations\n  }\n\n  /**\n   * Generate budget optimization recommendations\n   */\n  private generateBudgetRecommendations(metrics: any[]): Recommendation[] {\n    const recommendations: Recommendation[] = []\n\n    // Group metrics by ad set\n    const adSetMetrics: { [key: string]: any[] } = {}\n    metrics.forEach((metric) => {\n      const adSetId = metric.meta_ads?.meta_ad_set_id\n      if (adSetId) {\n        if (!adSetMetrics[adSetId]) {\n          adSetMetrics[adSetId] = []\n        }\n        adSetMetrics[adSetId].push(metric)\n      }\n    })\n\n    // Analyze each ad set\n    Object.entries(adSetMetrics).forEach(([adSetId, adSetMetrics]) => {\n      const avgRoas = adSetMetrics.reduce((sum, m) => sum + (m.roas || 0), 0) / adSetMetrics.length\n      const avgCtr = adSetMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / adSetMetrics.length\n      const totalSpend = adSetMetrics.reduce((sum, m) => sum + (m.spend || 0), 0)\n\n      // Recommendation: Increase budget for high-performing ad sets\n      if (avgRoas > 2.0 && totalSpend < 1000) {\n        recommendations.push({\n          id: `budget-increase-${adSetId}`,\n          meta_account_id: '',\n          recommendation_type: 'budget',\n          title: 'Increase Budget for High-Performing Ad Set',\n          description: `This ad set is showing strong performance with a ${avgRoas.toFixed(2)}x ROAS. Consider increasing the daily budget to scale results.`,\n          confidence_score: 0.85,\n          estimated_impact: avgRoas > 3 ? 40 : 25,\n          estimated_effort: 'low',\n          implementation_instructions: `Increase the daily budget by 25-50% in Meta Ads Manager. Monitor for 5-7 days and adjust if performance declines.`,\n          priority: 'high',\n        })\n      }\n\n      // Recommendation: Decrease budget for low-performing ad sets\n      if (avgRoas < 1.0 && totalSpend > 500) {\n        recommendations.push({\n          id: `budget-decrease-${adSetId}`,\n          meta_account_id: '',\n          recommendation_type: 'budget',\n          title: 'Decrease Budget for Underperforming Ad Set',\n          description: `This ad set has a ROAS of ${avgRoas.toFixed(2)}x, which is below profitability. Consider reducing the budget or pausing the ad set.`,\n          confidence_score: 0.8,\n          estimated_impact: -15,\n          estimated_effort: 'low',\n          implementation_instructions: `Reduce daily budget by 25-50% or pause the ad set entirely. Reallocate budget to higher-performing campaigns.`,\n          priority: 'high',\n        })\n      }\n\n      // Recommendation: Optimize CTR\n      if (avgCtr < 1.0) {\n        recommendations.push({\n          id: `ctr-optimization-${adSetId}`,\n          meta_account_id: '',\n          recommendation_type: 'budget',\n          title: 'Budget Pacing Issue',\n          description: `CTR is below 1%, suggesting possible audience fatigue or poor targeting.`,\n          confidence_score: 0.7,\n          estimated_impact: 20,\n          estimated_effort: 'medium',\n          implementation_instructions: `Review audience targeting. Consider expanding audience or creating new ad sets with fresh creative.`,\n          priority: 'medium',\n        })\n      }\n    })\n\n    return recommendations\n  }\n\n  /**\n   * Generate creative refresh recommendations\n   */\n  private generateCreativeRecommendations(metrics: any[]): Recommendation[] {\n    const recommendations: Recommendation[] = []\n\n    // Group by creative/ad\n    const adMetrics: { [key: string]: any[] } = {}\n    metrics.forEach((metric) => {\n      const adId = metric.meta_ad_id\n      if (adId) {\n        if (!adMetrics[adId]) {\n          adMetrics[adId] = []\n        }\n        adMetrics[adId].push(metric)\n      }\n    })\n\n    // Analyze creative performance\n    Object.entries(adMetrics).forEach(([adId, creativeMetrics]) => {\n      const avgCtr = creativeMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / creativeMetrics.length\n      const daysActive = creativeMetrics.length\n      const impressions = creativeMetrics.reduce((sum, m) => sum + (m.impressions || 0), 0)\n\n      // Ad fatigue detection\n      if (daysActive > 14 && impressions > 100000 && avgCtr < 1.0) {\n        recommendations.push({\n          id: `creative-fatigue-${adId}`,\n          meta_account_id: '',\n          recommendation_type: 'creative',\n          title: 'Ad Fatigue Detected',\n          description: `This creative has been running for ${daysActive} days with ${impressions} impressions. CTR is declining, indicating audience fatigue.`,\n          confidence_score: 0.8,\n          estimated_impact: 30,\n          estimated_effort: 'medium',\n          implementation_instructions: `Create 2-3 new variations of this creative with different images, copy, or format. Run A/B tests to identify best performer.`,\n          priority: 'high',\n        })\n      }\n\n      // Low engagement creative\n      if (avgCtr < 0.5 && daysActive > 7) {\n        recommendations.push({\n          id: `low-engagement-${adId}`,\n          meta_account_id: '',\n          recommendation_type: 'creative',\n          title: 'Low Engagement Creative',\n          description: `This creative is underperforming with a CTR of ${avgCtr.toFixed(2)}%.`,\n          confidence_score: 0.75,\n          estimated_impact: 25,\n          estimated_effort: 'high',\n          implementation_instructions: `Review creative elements. Test different headlines, images, or calls-to-action. Consider pausing if no improvement after 7 more days.`,\n          priority: 'medium',\n        })\n      }\n    })\n\n    return recommendations\n  }\n\n  /**\n   * Generate audience targeting recommendations\n   */\n  private generateAudienceRecommendations(metrics: any[]): Recommendation[] {\n    const recommendations: Recommendation[] = []\n\n    // Analyze by age, gender, or other demographics if available\n    // This is a simplified version - in production, you'd have demographic data\n\n    const avgCpa = metrics.reduce((sum, m) => sum + (m.cpa || 0), 0) / metrics.length\n    const avgRoas = metrics.reduce((sum, m) => sum + (m.roas || 0), 0) / metrics.length\n\n    if (avgRoas > 2.0) {\n      recommendations.push({\n        id: 'audience-expansion',\n        meta_account_id: '',\n        recommendation_type: 'audience',\n        title: 'Expand Winning Audience',\n        description: `Your campaigns are performing well with an average ROAS of ${avgRoas.toFixed(2)}x. Consider creating lookalike audiences to scale.`,\n        confidence_score: 0.8,\n        estimated_impact: 35,\n        estimated_effort: 'medium',\n        implementation_instructions: `Create a 1-2% lookalike audience in Meta Ads Manager based on your best converting customers. Start with a test budget.`,\n        priority: 'high',\n      })\n    }\n\n    if (avgCpa > 100) {\n      recommendations.push({\n        id: 'audience-refinement',\n        meta_account_id: '',\n        recommendation_type: 'audience',\n        title: 'Refine Targeting to Reduce CPA',\n        description: `CPA is high at ${avgCpa.toFixed(2)}. Refining your target audience could improve efficiency.`,\n        confidence_score: 0.7,\n        estimated_impact: 20,\n        estimated_effort: 'medium',\n        implementation_instructions: `Review audience demographics and interests. Remove underperforming interests or locations. Test age ranges.`,\n        priority: 'medium',\n      })\n    }\n\n    return recommendations\n  }\n\n  /**\n   * Score and rank recommendations by estimated impact\n   */\n  scoreRecommendations(recommendations: Recommendation[]): Recommendation[] {\n    return recommendations.sort((a, b) => {\n      // Score based on confidence, impact, and effort\n      const scoreA = (a.confidence_score * a.estimated_impact) / (a.estimated_effort === 'high' ? 3 : a.estimated_effort === 'medium' ? 2 : 1)\n      const scoreB = (b.confidence_score * b.estimated_impact) / (b.estimated_effort === 'high' ? 3 : b.estimated_effort === 'medium' ? 2 : 1)\n      return scoreB - scoreA\n    })\n  }\n}\n\nexport default new RecommendationEngine()\n","numLines":274,"startLine":1,"totalLines":274}}}
