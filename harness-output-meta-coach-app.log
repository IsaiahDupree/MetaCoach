{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_013P2cuhWEsUBRtqn63scYqy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U2Ao5fZN7X49AchfS411iF","name":"mcp__supabase__apply_migration","input":{"name":"004_metacoach_ad_schema","query":"\n-- Create MetaCoach ad sets table\nCREATE TABLE IF NOT EXISTS meta_ad_sets (\n  id TEXT PRIMARY KEY,\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  ad_set_name TEXT NOT NULL,\n  ad_set_status TEXT,\n  daily_budget DECIMAL(15, 2),\n  lifetime_budget DECIMAL(15, 2),\n  optimization_goal TEXT,\n  targeting JSONB,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create MetaCoach ads table\nCREATE TABLE IF NOT EXISTS meta_ads (\n  id TEXT PRIMARY KEY,\n  meta_ad_set_id TEXT NOT NULL REFERENCES meta_ad_sets(id) ON DELETE CASCADE,\n  ad_name TEXT NOT NULL,\n  ad_status TEXT,\n  creative_id TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ad performance metrics table\nCREATE TABLE IF NOT EXISTS meta_ad_performance (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_ad_id TEXT NOT NULL REFERENCES meta_ads(id) ON DELETE CASCADE,\n  date DATE NOT NULL,\n  impressions BIGINT DEFAULT 0,\n  clicks BIGINT DEFAULT 0,\n  spend DECIMAL(15, 4) DEFAULT 0,\n  actions BIGINT DEFAULT 0,\n  action_value DECIMAL(15, 4) DEFAULT 0,\n  ctr DECIMAL(8, 4),\n  cpc DECIMAL(15, 4),\n  cpa DECIMAL(15, 4),\n  roas DECIMAL(8, 4),\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE(meta_ad_id, date)\n);\n\n-- Create MetaCoach recommendations table\nCREATE TABLE IF NOT EXISTS meta_coach_recommendations (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  recommendation_type TEXT NOT NULL,\n  title TEXT NOT NULL,\n  description TEXT,\n  confidence_score DECIMAL(5, 2),\n  estimated_impact DECIMAL(8, 2),\n  estimated_effort TEXT,\n  implementation_instructions TEXT,\n  is_implemented BOOLEAN DEFAULT FALSE,\n  implemented_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create MetaCoach alerts table\nCREATE TABLE IF NOT EXISTS meta_coach_alerts (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  alert_type TEXT NOT NULL,\n  severity TEXT DEFAULT 'info',\n  title TEXT NOT NULL,\n  description TEXT,\n  threshold_value DECIMAL(15, 4),\n  current_value DECIMAL(15, 4),\n  is_resolved BOOLEAN DEFAULT FALSE,\n  resolved_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create indexes\nCREATE INDEX IF NOT EXISTS idx_meta_ad_sets_account ON meta_ad_sets(meta_account_id);\nCREATE INDEX IF NOT EXISTS idx_meta_ads_adset ON meta_ads(meta_ad_set_id);\nCREATE INDEX IF NOT EXISTS idx_meta_ad_performance_ad ON meta_ad_performance(meta_ad_id);\nCREATE INDEX IF NOT EXISTS idx_meta_ad_performance_date ON meta_ad_performance(date);\nCREATE INDEX IF NOT EXISTS idx_meta_coach_recommendations_account ON meta_coach_recommendations(meta_account_id);\nCREATE INDEX IF NOT EXISTS idx_meta_coach_alerts_account ON meta_coach_alerts(meta_account_id);\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":853,"cache_read_input_tokens":120424,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":853},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"55ed3161-1a3a-4dce-94dc-5fdd6534d422"}
