tion\": \"Sync campaign, ad set, and ad data from Meta API\",\n      \"priority\": \"P0\",\n      \"phase\": 2,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"meta_integration\",\n      \"files\": [\n        \"api/sync/campaigns.ts\",\n        \"lib/meta-sync.ts\"\n      ],\n      \"acceptance\": [\n        \"Campaigns, ad sets, ads fetched from Meta\",\n        \"Data stored in Supabase tables\",\n        \"Sync runs on schedule (hourly)\",\n        \"Manual sync trigger available\",\n        \"Sync status logged and tracked\"\n      ],\n      \"dependencies\": [\n        \"META-003\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"PERF-001\",\n      \"name\": \"Ad Performance Metrics Fetch\",\n      \"description\": \"Fetch daily/hourly performance metrics from Meta API\",\n      \"priority\": \"P0\",\n      \"phase\": 3,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"performance_analysis\",\n      \"files\": [\n        \"api/metrics/fetch.ts\",\n        \"lib/meta-insights.ts\"\n      ],\n      \"acceptance\": [\n        \"Metrics include impressions, clicks, spend, actions\",\n        \"CTR, CPC, ROAS calculated\",\n        \"Historical data retrieved for 30+ days\",\n        \"Metrics stored with timestamps\",\n        \"API rate limits handled gracefully\"\n      ],\n      \"dependencies\": [\n        \"META-004\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"PERF-002\",\n      \"name\": \"Performance Trending & Time Series\",\n      \"description\": \"Calculate performance trends and generate time series data\",\n      \"priority\": \"P1\",\n      \"phase\": 3,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"performance_analysis\",\n      \"files\": [\n        \"lib/trend-analysis.ts\",\n        \"api/metrics/trends.ts\"\n      ],\n      \"acceptance\": [\n        \"Daily/weekly/monthly trend calculated\",\n        \"Trend