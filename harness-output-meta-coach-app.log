{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01AN6p6fPMfjvepimUNLeVjp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WYaPVmzWRazQ4YseXpCyU2","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/__tests__/lib/recommendation-engine.test.ts","content":"import { RecommendationEngine } from '@/lib/recommendation-engine'\n\ndescribe('RecommendationEngine', () => {\n  let engine: RecommendationEngine\n\n  beforeEach(() => {\n    engine = new RecommendationEngine()\n  })\n\n  describe('scoreRecommendations', () => {\n    it('should assign impact scores to recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'Increase Budget',\n          description: 'Increase budget for high-performing campaign',\n          confidence: 0.8,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Refresh Creative',\n          description: 'Ad fatigue detected',\n          confidence: 0.6,\n          estimatedImpact: 200,\n          effort: 2,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toHaveLength(2)\n      expect(scored[0].score).toBeDefined()\n      expect(scored[0].score).toBeGreaterThan(0)\n      expect(scored[0].score).toBeLessThanOrEqual(100)\n      scored.forEach((rec) => {\n        expect(rec.score).toBeDefined()\n        expect(typeof rec.score).toBe('number')\n      })\n    })\n\n    it('should rank recommendations by impact-to-effort ratio', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'High Impact, Low Effort',\n          description: 'Test',\n          confidence: 0.9,\n          estimatedImpact: 1000,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Low Impact, High Effort',\n          description: 'Test',\n          confidence: 0.5,\n          estimatedImpact: 100,\n          effort: 5,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n\n    it('should filter out low-confidence recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'High Confidence',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Low Confidence',\n          description: 'Test',\n          confidence: 0.2,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      // Low confidence recommendations should have lower scores\n      const highConfScore = scored.find((r) => r.id === '1')?.score || 0\n      const lowConfScore = scored.find((r) => r.id === '2')?.score || 0\n\n      expect(highConfScore).toBeGreaterThan(lowConfScore)\n    })\n\n    it('should handle empty recommendations list', () => {\n      const recommendations: any[] = []\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toEqual([])\n    })\n\n    it('should assign higher scores to high-impact recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'High Impact',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 5000,\n          effort: 2,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Low Impact',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 100,\n          effort: 2,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n      const highImpactScore = scored.find((r) => r.id === '1')?.score || 0\n      const lowImpactScore = scored.find((r) => r.id === '2')?.score || 0\n\n      expect(highImpactScore).toBeGreaterThan(lowImpactScore)\n    })\n  })\n\n  describe('generateRecommendations', () => {\n    it('should return an array of recommendations', async () => {\n      // Mock Supabase for this test\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(Array.isArray(recommendations)).toBe(true)\n    })\n\n    it('should include different recommendation types', async () => {\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      const types = recommendations.map((r) => r.type)\n      expect(types.length).toBeGreaterThanOrEqual(0)\n    })\n  })\n})\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2424,"cache_read_input_tokens":100626,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2424},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"1e842643-3ab1-4c43-8e35-e386b90c3ea2"}
