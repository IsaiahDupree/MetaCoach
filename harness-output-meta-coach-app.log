{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EACbSksfMj3oBcoKqknxWB","type":"tool_result","content":"     1→import { NextRequest, NextResponse } from 'next/server'\n     2→import { exchangeCodeForToken, MetaClient } from '@/lib/meta'\n     3→import { supabaseAdmin } from '@/lib/supabase'\n     4→\n     5→export async function GET(req: NextRequest) {\n     6→  try {\n     7→    const searchParams = req.nextUrl.searchParams\n     8→    const code = searchParams.get('code')\n     9→    const state = searchParams.get('state')\n    10→    const storedState = req.cookies.get('oauth_state')?.value\n    11→\n    12→    // Verify state for CSRF protection\n    13→    if (!state || !storedState || state !== storedState) {\n    14→      return NextResponse.redirect(\n    15→        new URL('/connect?error=invalid_state', req.url)\n    16→      )\n    17→    }\n    18→\n    19→    if (!code) {\n    20→      return NextResponse.redirect(\n    21→        new URL('/connect?error=no_code', req.url)\n    22→      )\n    23→    }\n    24→\n    25→    // Exchange code for short-lived token\n    26→    const tokenResponse = await exchangeCodeForToken(code)\n    27→\n    28→    // Exchange for long-lived token (60 days)\n    29→    const longLivedToken = await MetaClient.exchangeForLongLivedToken(\n    30→      tokenResponse.access_token\n    31→    )\n    32→\n    33→    // Calculate token expiration\n    34→    const expiresAt = new Date()\n    35→    expiresAt.setSeconds(expiresAt.getSeconds() + (longLivedToken.expires_in || 5184000)) // 60 days default\n    36→\n    37→    // Get the current user from Supabase auth\n    38→    const supabase = supabaseAdmin()\n    39→    const { data: { user }, error: userError } = await supabase.auth.admin.getUserBySub(\n    40→      tokenResponse.user_id\n    41→    )\n    42→\n    43→    if (!user) {\n    44→      return NextResponse.redirect(\n    45→        new URL('/connect?error=auth_failed', req.url)\n    46→      )\n    47→    }\n    48→\n    49→    // Get ad accounts for this user\n    50→    const client = new MetaClient(longLivedToken.access_token)\n    51→    const adAccounts = await client.getAdAccounts()\n    52→\n    53→    // Store the access token and ad account info in Supabase\n    54→    if (adAccounts && adAccounts.length > 0) {\n    55→      // Store each ad account in meta_accounts table\n    56→      for (const account of adAccounts) {\n    57→        const { error } = await supabase\n    58→          .from('meta_accounts')\n    59→          .upsert({\n    60→            id: account.id,\n    61→            user_id: user.id,\n    62→            account_name: account.name,\n    63→            account_currency: account.currency,\n    64→            account_timezone: account.timezone_name,\n    65→            access_token: longLivedToken.access_token,\n    66→            token_expires_at: expiresAt.toISOString(),\n    67→            is_active: true,\n    68→          }, {\n    69→            onConflict: 'id'\n    70→          })\n    71→\n    72→        if (error) {\n    73→          console.error('Failed to store ad account:', error)\n    74→        }\n    75→      }\n    76→    }\n    77→\n    78→    const response = NextResponse.redirect(new URL('/dashboard', req.url))\n    79→\n    80→    // Store access token in httpOnly cookie as backup\n    81→    response.cookies.set('meta_access_token', longLivedToken.access_token, {\n    82→      httpOnly: true,\n    83→      secure: process.env.NODE_ENV === 'production',\n    84→      sameSite: 'lax',\n    85→      maxAge: longLivedToken.expires_in || 5184000, // 60 days\n    86→    })\n    87→\n    88→    response.cookies.set('meta_token_expires', expiresAt.toISOString(), {\n    89→      httpOnly: true,\n    90→      secure: process.env.NODE_ENV === 'production',\n    91→      sameSite: 'lax',\n    92→      maxAge: longLivedToken.expires_in || 5184000,\n    93→    })\n    94→\n    95→    // Clear the state cookie\n    96→    response.cookies.delete('oauth_state')\n    97→\n    98→    return response\n    99→  } catch (error: any) {\n   100→    console.error('OAuth callback error:', error)\n   101→    const errorMessage = error?.message || 'Unknown error'\n   102→    const detailsParam = encodeURIComponent(errorMessage)\n   103→    return NextResponse.redirect(\n   104→      new URL(`/connect?error=callback_failed&details=${detailsParam}`, req.url)\n   105→    )\n   106→  }\n   107→}\n   108→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"e9f5f6b1-30c5-4d26-9edd-8491eab55971","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/oauth/callback/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { exchangeCodeForToken, MetaClient } from '@/lib/meta'\nimport { supabaseAdmin } from '@/lib/supabase'\n\nexport async function GET(req: NextRequest) {\n  try {\n    const searchParams = req.nextUrl.searchParams\n    const code = searchParams.get('code')\n    const state = searchParams.get('state')\n    const storedState = req.cookies.get('oauth_state')?.value\n\n    // Verify state for CSRF protection\n    if (!state || !storedState || state !== storedState) {\n      return NextResponse.redirect(\n        new URL('/connect?error=invalid_state', req.url)\n      )\n    }\n\n    if (!code) {\n      return NextResponse.redirect(\n        new URL('/connect?error=no_code', req.url)\n      )\n    }\n\n    // Exchange code for short-lived token\n    const tokenResponse = await exchangeCodeForToken(code)\n\n    // Exchange for long-lived token (60 days)\n    const longLivedToken = await MetaClient.exchangeForLongLivedToken(\n      tokenResponse.access_token\n    )\n\n    // Calculate token expiration\n    const expiresAt = new Date()\n    expiresAt.setSeconds(expiresAt.getSeconds() + (longLivedToken.expires_in || 5184000)) // 60 days default\n\n    // Get the current user from Supabase auth\n    const supabase = supabaseAdmin()\n    const { data: { user }, error: userError } = await supabase.auth.admin.getUserBySub(\n      tokenResponse.user_id\n    )\n\n    if (!user) {\n      return NextResponse.redirect(\n        new URL('/connect?error=auth_failed', req.url)\n      )\n    }\n\n    // Get ad accounts for this user\n    const client = new MetaClient(longLivedToken.access_token)\n    const adAccounts = await client.getAdAccounts()\n\n    // Store the access token and ad account info in Supabase\n    if (adAccounts && adAccounts.length > 0) {\n      // Store each ad account in meta_accounts table\n      for (const account of adAccounts) {\n        const { error } = await supabase\n          .from('meta_accounts')\n          .upsert({\n            id: account.id,\n            user_id: user.id,\n            account_name: account.name,\n            account_currency: account.currency,\n            account_timezone: account.timezone_name,\n            access_token: longLivedToken.access_token,\n            token_expires_at: expiresAt.toISOString(),\n            is_active: true,\n          }, {\n            onConflict: 'id'\n          })\n\n        if (error) {\n          console.error('Failed to store ad account:', error)\n        }\n      }\n    }\n\n    const response = NextResponse.redirect(new URL('/dashboard', req.url))\n\n    // Store access token in httpOnly cookie as backup\n    response.cookies.set('meta_access_token', longLivedToken.access_token, {\n      httpOnly: true,\n      secure: process.env.NODE_ENV === 'production',\n      sameSite: 'lax',\n      maxAge: longLivedToken.expires_in || 5184000, // 60 days\n    })\n\n    response.cookies.set('meta_token_expires', expiresAt.toISOString(), {\n      httpOnly: true,\n      secure: process.env.NODE_ENV === 'production',\n      sameSite: 'lax',\n      maxAge: longLivedToken.expires_in || 5184000,\n    })\n\n    // Clear the state cookie\n    response.cookies.delete('oauth_state')\n\n    return response\n  } catch (error: any) {\n    console.error('OAuth callback error:', error)\n    const errorMessage = error?.message || 'Unknown error'\n    const detailsParam = encodeURIComponent(errorMessage)\n    return NextResponse.redirect(\n      new URL(`/connect?error=callback_failed&details=${detailsParam}`, req.url)\n    )\n  }\n}\n","numLines":108,"startLine":1,"totalLines":108}}}
