esponse cached for 5 minutes\"\n      ],\n      \"dependencies\": [\n        \"META-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"META-003\",\n      \"name\": \"Account Connection & Linking\",\n      \"description\": \"Allow users to connect and link Meta ad accounts to their profile\",\n      \"priority\": \"P0\",\n      \"phase\": 2,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"meta_integration\",\n      \"files\": [\n        \"api/accounts/link.ts\",\n        \"pages/accounts/connect.tsx\"\n      ],\n      \"acceptance\": [\n        \"User can select accounts to link\",\n        \"Linked accounts stored in user profile\",\n        \"Multiple accounts supported per user\",\n        \"Account selection persists\",\n        \"Account unlink removes access\"\n      ],\n      \"dependencies\": [\n        \"META-002\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"META-004\",\n      \"name\": \"Campaign Data Sync from Meta\",\n      \"description\": \"Sync campaign, ad set, and ad data from Meta API\",\n      \"priority\": \"P0\",\n      \"phase\": 2,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"meta_integration\",\n      \"files\": [\n        \"api/sync/campaigns.ts\",\n        \"lib/meta-sync.ts\"\n      ],\n      \"acceptance\": [\n        \"Campaigns, ad sets, ads fetched from Meta\",\n        \"Data stored in Supabase tables\",\n        \"Sync runs on schedule (hourly)\",\n        \"Manual sync trigger available\",\n        \"Sync status logged and tracked\"\n      ],\n      \"dependencies\": [\n        \"META-003\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"PERF-001\",\n      \"name\": \"Ad Performance Metrics Fetch\",\n      \"description\": \"Fetch daily/hourly performance metrics from Meta API\",\n      \"priority\": \"P0\",\n      \"phase\": 3,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"ca