{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01CiAiBqnE6MpNJvWL9yQ15h","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G2qZpD6JmtBnz9C8Gpjmg5","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/pdf-export.ts","content":"import type { ClientReport } from './report-generator'\n\nexport interface PDFExportOptions {\n  includeCharts?: boolean\n  includeBranding?: boolean\n  paperSize?: 'A4' | 'Letter'\n}\n\nexport class PDFExporter {\n  private defaultOptions: PDFExportOptions = {\n    includeCharts: true,\n    includeBranding: true,\n    paperSize: 'A4',\n  }\n\n  /**\n   * Convert report to HTML for PDF generation\n   */\n  private generateHTML(report: ClientReport, options: PDFExportOptions): string {\n    const now = new Date().toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric',\n    })\n\n    return `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      line-height: 1.6;\n      color: #333;\n      max-width: 850px;\n      margin: 0 auto;\n      padding: 40px;\n    }\n    .header {\n      border-bottom: 2px solid #007bff;\n      padding-bottom: 20px;\n      margin-bottom: 30px;\n    }\n    .header h1 {\n      margin: 0;\n      color: #007bff;\n      font-size: 28px;\n    }\n    .header p {\n      margin: 5px 0 0 0;\n      color: #666;\n      font-size: 14px;\n    }\n    .section {\n      margin-bottom: 40px;\n      page-break-inside: avoid;\n    }\n    .section h2 {\n      font-size: 20px;\n      color: #333;\n      border-bottom: 1px solid #eee;\n      padding-bottom: 10px;\n      margin-bottom: 15px;\n    }\n    .metrics-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 20px;\n      margin-bottom: 20px;\n    }\n    .metric-card {\n      border: 1px solid #eee;\n      padding: 15px;\n      border-radius: 4px;\n      background: #f9f9f9;\n    }\n    .metric-label {\n      font-size: 12px;\n      color: #666;\n      text-transform: uppercase;\n      margin-bottom: 5px;\n    }\n    .metric-value {\n      font-size: 24px;\n      font-weight: bold;\n      color: #333;\n    }\n    .achievements {\n      background: #f0f8ff;\n      border-left: 4px solid #007bff;\n      padding: 15px;\n      margin-bottom: 15px;\n      border-radius: 4px;\n    }\n    .achievements ul {\n      margin: 10px 0;\n      padding-left: 20px;\n    }\n    .achievements li {\n      margin-bottom: 8px;\n    }\n    .table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-bottom: 20px;\n    }\n    .table th {\n      background: #f9f9f9;\n      padding: 12px;\n      text-align: left;\n      border-bottom: 2px solid #ddd;\n      font-weight: 600;\n      font-size: 13px;\n    }\n    .table td {\n      padding: 12px;\n      border-bottom: 1px solid #eee;\n    }\n    .table tbody tr:hover {\n      background: #f9f9f9;\n    }\n    .recommendations {\n      background: #fff3cd;\n      border-left: 4px solid #ffc107;\n      padding: 15px;\n      margin-bottom: 15px;\n      border-radius: 4px;\n    }\n    .recommendation-item {\n      margin-bottom: 15px;\n      padding-bottom: 15px;\n      border-bottom: 1px solid #ffe8a1;\n    }\n    .recommendation-item:last-child {\n      border-bottom: none;\n      margin-bottom: 0;\n      padding-bottom: 0;\n    }\n    .recommendation-title {\n      font-weight: bold;\n      color: #333;\n      margin-bottom: 5px;\n    }\n    .recommendation-priority {\n      display: inline-block;\n      padding: 3px 8px;\n      border-radius: 3px;\n      font-size: 11px;\n      font-weight: 600;\n      margin-bottom: 8px;\n    }\n    .priority-high {\n      background: #f8d7da;\n      color: #721c24;\n    }\n    .priority-medium {\n      background: #fff3cd;\n      color: #856404;\n    }\n    .priority-low {\n      background: #d1ecf1;\n      color: #0c5460;\n    }\n    .chart-placeholder {\n      background: #f9f9f9;\n      border: 1px solid #eee;\n      padding: 40px;\n      text-align: center;\n      color: #999;\n      margin-bottom: 20px;\n      border-radius: 4px;\n      min-height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      border-top: 1px solid #eee;\n      font-size: 12px;\n      color: #999;\n      text-align: center;\n    }\n    .date-range {\n      color: #666;\n      font-size: 14px;\n      margin-bottom: 10px;\n    }\n    @media print {\n      body {\n        padding: 20px;\n      }\n      .section {\n        page-break-inside: avoid;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Performance Report</h1>\n    <p>${report.account_id}</p>\n    <p class=\"date-range\">Period: ${report.date_range.from} to ${report.date_range.to}</p>\n    <p class=\"date-range\">Generated: ${now}</p>\n  </div>\n\n  <!-- Executive Summary -->\n  <div class=\"section\">\n    <h2>Executive Summary</h2>\n    <p><strong>Period:</strong> ${report.executive_summary.period}</p>\n\n    ${\n      report.executive_summary.key_achievements.length > 0\n        ? `\n    <div class=\"achievements\">\n      <strong>Key Achievements:</strong>\n      <ul>\n        ${report.executive_summary.key_achievements.map((item) => `<li>${item}</li>`).join('')}\n      </ul>\n    </div>\n    `\n        : ''\n    }\n\n    ${\n      report.executive_summary.action_items.length > 0\n        ? `\n    <div class=\"recommendations\">\n      <strong>Priority Action Items:</strong>\n      <ul>\n        ${report.executive_summary.action_items.map((item) => `<li>${item}</li>`).join('')}\n      </ul>\n    </div>\n    `\n        : ''\n    }\n  </div>\n\n  <!-- Performance Metrics -->\n  <div class=\"section\">\n    <h2>Performance Metrics</h2>\n    <div class=\"metrics-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Total Spend</div>\n        <div class=\"metric-value\">$${report.summary.total_spend.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Impressions</div>\n        <div class=\"metric-value\">${report.summary.total_impressions.toLocaleString()}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Conversions</div>\n        <div class=\"metric-value\">${Math.round(report.summary.total_conversions)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">ROAS</div>\n        <div class=\"metric-value\">${report.summary.avg_roas.toFixed(2)}x</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CTR</div>\n        <div class=\"metric-value\">${(report.summary.avg_ctr * 100).toFixed(2)}%</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CPC</div>\n        <div class=\"metric-value\">$${report.summary.avg_cpc.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CPA</div>\n        <div class=\"metric-value\">$${report.summary.avg_cpa.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Click Through Rate</div>\n        <div class=\"metric-value\">${report.summary.total_clicks.toLocaleString()}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Charts -->\n  ${\n    options.includeCharts && report.charts.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Performance Trends</h2>\n    ${report.charts\n      .map(\n        (chart) => `\n      <div>\n        <h3 style=\"font-size: 16px; margin-bottom: 10px;\">${chart.title}</h3>\n        <div class=\"chart-placeholder\">Chart: ${chart.title}</div>\n      </div>\n    `\n      )\n      .join('')}\n  </div>\n  `\n      : ''\n  }\n\n  <!-- Top Campaigns -->\n  ${\n    report.top_campaigns.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Top Performing Campaigns</h2>\n    <table class=\"table\">\n      <thead>\n        <tr>\n          <th>Campaign Name</th>\n          <th>Spend</th>\n          <th>Conversions</th>\n          <th>ROAS</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${report.top_campaigns\n          .slice(0, 10)\n          .map(\n            (c) => `\n          <tr>\n            <td>${c.name}</td>\n            <td>$${c.spend.toFixed(2)}</td>\n            <td>${Math.round(c.conversions)}</td>\n            <td>${c.roas.toFixed(2)}x</td>\n          </tr>\n        `\n          )\n          .join('')}\n      </tbody>\n    </table>\n  </div>\n  `\n      : ''\n  }\n\n  <!-- Recommendations -->\n  ${\n    report.recommendations.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Recommendations</h2>\n    ${report.recommendations\n      .slice(0, 5)\n      .map(\n        (rec) => `\n      <div class=\"recommendation-item\">\n        <div class=\"recommendation-priority priority-${rec.priority}\">${rec.priority.toUpperCase()}</div>\n        <div class=\"recommendation-title\">${rec.title}</div>\n        <p style=\"margin: 5px 0; color: #666;\">${rec.description}</p>\n        <p style=\"margin: 5px 0; font-size: 13px; color: #999;\">\n          <strong>Implementation:</strong> ${rec.implementation_instructions}\n        </p>\n        <p style=\"margin: 5px 0; font-size: 13px; color: #999;\">\n          <strong>Estimated Impact:</strong> ${rec.estimated_impact}%\n        </p>\n      </div>\n    `\n      )\n      .join('')}\n  </div>\n  `\n      : ''\n  }\n\n  <div class=\"footer\">\n    <p>MetaCoach &bull; Automated Performance Report</p>\n    <p>For questions or support, contact your account manager.</p>\n  </div>\n</body>\n</html>\n    `\n  }\n\n  /**\n   * Export report as PDF\n   * Note: In a real implementation, you would use a library like pdfkit or html2pdf\n   * For now, this returns the HTML that can be converted to PDF\n   */\n  async exportAsPDF(report: ClientReport, options?: PDFExportOptions): Promise<Blob> {\n    const mergedOptions = { ...this.defaultOptions, ...options }\n    const html = this.generateHTML(report, mergedOptions)\n\n    // In a real implementation, you would use a PDF library here\n    // For now, we're returning a Blob that contains the HTML\n    // In production, use: html2pdf, pdfkit, or call a server-side PDF conversion service\n\n    const htmlBlob = new Blob([html], { type: 'text/html' })\n    return htmlBlob\n  }\n\n  /**\n   * Generate PDF as data URI (for downloads)\n   */\n  async generatePDFDataUri(report: ClientReport, options?: PDFExportOptions): Promise<string> {\n    const blob = await this.exportAsPDF(report, options)\n    return URL.createObjectURL(blob)\n  }\n\n  /**\n   * Validate PDF before delivery\n   */\n  validatePDF(pdfData: Blob): {\n    isValid: boolean\n    fileSizeKB: number\n    issues: string[]\n  } {\n    const issues: string[] = []\n    const fileSizeKB = pdfData.size / 1024\n\n    if (fileSizeKB > 5000) {\n      issues.push('PDF file size exceeds 5MB limit')\n    }\n\n    if (pdfData.size === 0) {\n      issues.push('PDF is empty')\n    }\n\n    if (!pdfData.type.includes('pdf') && !pdfData.type.includes('octet-stream')) {\n      issues.push('Invalid PDF file type')\n    }\n\n    return {\n      isValid: issues.length === 0,\n      fileSizeKB,\n      issues,\n    }\n  }\n}\n\nexport default new PDFExporter()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3514,"cache_read_input_tokens":131191,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3514},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"f0a3b0fd-c78c-4c3d-af56-fe2c72c05ae1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G2qZpD6JmtBnz9C8Gpjmg5","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/MetaCoach/lib/pdf-export.ts"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"fe34dd79-4ba6-4147-99b8-7c98c6b0110b","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/pdf-export.ts","content":"import type { ClientReport } from './report-generator'\n\nexport interface PDFExportOptions {\n  includeCharts?: boolean\n  includeBranding?: boolean\n  paperSize?: 'A4' | 'Letter'\n}\n\nexport class PDFExporter {\n  private defaultOptions: PDFExportOptions = {\n    includeCharts: true,\n    includeBranding: true,\n    paperSize: 'A4',\n  }\n\n  /**\n   * Convert report to HTML for PDF generation\n   */\n  private generateHTML(report: ClientReport, options: PDFExportOptions): string {\n    const now = new Date().toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric',\n    })\n\n    return `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      line-height: 1.6;\n      color: #333;\n      max-width: 850px;\n      margin: 0 auto;\n      padding: 40px;\n    }\n    .header {\n      border-bottom: 2px solid #007bff;\n      padding-bottom: 20px;\n      margin-bottom: 30px;\n    }\n    .header h1 {\n      margin: 0;\n      color: #007bff;\n      font-size: 28px;\n    }\n    .header p {\n      margin: 5px 0 0 0;\n      color: #666;\n      font-size: 14px;\n    }\n    .section {\n      margin-bottom: 40px;\n      page-break-inside: avoid;\n    }\n    .section h2 {\n      font-size: 20px;\n      color: #333;\n      border-bottom: 1px solid #eee;\n      padding-bottom: 10px;\n      margin-bottom: 15px;\n    }\n    .metrics-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 20px;\n      margin-bottom: 20px;\n    }\n    .metric-card {\n      border: 1px solid #eee;\n      padding: 15px;\n      border-radius: 4px;\n      background: #f9f9f9;\n    }\n    .metric-label {\n      font-size: 12px;\n      color: #666;\n      text-transform: uppercase;\n      margin-bottom: 5px;\n    }\n    .metric-value {\n      font-size: 24px;\n      font-weight: bold;\n      color: #333;\n    }\n    .achievements {\n      background: #f0f8ff;\n      border-left: 4px solid #007bff;\n      padding: 15px;\n      margin-bottom: 15px;\n      border-radius: 4px;\n    }\n    .achievements ul {\n      margin: 10px 0;\n      padding-left: 20px;\n    }\n    .achievements li {\n      margin-bottom: 8px;\n    }\n    .table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-bottom: 20px;\n    }\n    .table th {\n      background: #f9f9f9;\n      padding: 12px;\n      text-align: left;\n      border-bottom: 2px solid #ddd;\n      font-weight: 600;\n      font-size: 13px;\n    }\n    .table td {\n      padding: 12px;\n      border-bottom: 1px solid #eee;\n    }\n    .table tbody tr:hover {\n      background: #f9f9f9;\n    }\n    .recommendations {\n      background: #fff3cd;\n      border-left: 4px solid #ffc107;\n      padding: 15px;\n      margin-bottom: 15px;\n      border-radius: 4px;\n    }\n    .recommendation-item {\n      margin-bottom: 15px;\n      padding-bottom: 15px;\n      border-bottom: 1px solid #ffe8a1;\n    }\n    .recommendation-item:last-child {\n      border-bottom: none;\n      margin-bottom: 0;\n      padding-bottom: 0;\n    }\n    .recommendation-title {\n      font-weight: bold;\n      color: #333;\n      margin-bottom: 5px;\n    }\n    .recommendation-priority {\n      display: inline-block;\n      padding: 3px 8px;\n      border-radius: 3px;\n      font-size: 11px;\n      font-weight: 600;\n      margin-bottom: 8px;\n    }\n    .priority-high {\n      background: #f8d7da;\n      color: #721c24;\n    }\n    .priority-medium {\n      background: #fff3cd;\n      color: #856404;\n    }\n    .priority-low {\n      background: #d1ecf1;\n      color: #0c5460;\n    }\n    .chart-placeholder {\n      background: #f9f9f9;\n      border: 1px solid #eee;\n      padding: 40px;\n      text-align: center;\n      color: #999;\n      margin-bottom: 20px;\n      border-radius: 4px;\n      min-height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      border-top: 1px solid #eee;\n      font-size: 12px;\n      color: #999;\n      text-align: center;\n    }\n    .date-range {\n      color: #666;\n      font-size: 14px;\n      margin-bottom: 10px;\n    }\n    @media print {\n      body {\n        padding: 20px;\n      }\n      .section {\n        page-break-inside: avoid;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Performance Report</h1>\n    <p>${report.account_id}</p>\n    <p class=\"date-range\">Period: ${report.date_range.from} to ${report.date_range.to}</p>\n    <p class=\"date-range\">Generated: ${now}</p>\n  </div>\n\n  <!-- Executive Summary -->\n  <div class=\"section\">\n    <h2>Executive Summary</h2>\n    <p><strong>Period:</strong> ${report.executive_summary.period}</p>\n\n    ${\n      report.executive_summary.key_achievements.length > 0\n        ? `\n    <div class=\"achievements\">\n      <strong>Key Achievements:</strong>\n      <ul>\n        ${report.executive_summary.key_achievements.map((item) => `<li>${item}</li>`).join('')}\n      </ul>\n    </div>\n    `\n        : ''\n    }\n\n    ${\n      report.executive_summary.action_items.length > 0\n        ? `\n    <div class=\"recommendations\">\n      <strong>Priority Action Items:</strong>\n      <ul>\n        ${report.executive_summary.action_items.map((item) => `<li>${item}</li>`).join('')}\n      </ul>\n    </div>\n    `\n        : ''\n    }\n  </div>\n\n  <!-- Performance Metrics -->\n  <div class=\"section\">\n    <h2>Performance Metrics</h2>\n    <div class=\"metrics-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Total Spend</div>\n        <div class=\"metric-value\">$${report.summary.total_spend.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Impressions</div>\n        <div class=\"metric-value\">${report.summary.total_impressions.toLocaleString()}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Conversions</div>\n        <div class=\"metric-value\">${Math.round(report.summary.total_conversions)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">ROAS</div>\n        <div class=\"metric-value\">${report.summary.avg_roas.toFixed(2)}x</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CTR</div>\n        <div class=\"metric-value\">${(report.summary.avg_ctr * 100).toFixed(2)}%</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CPC</div>\n        <div class=\"metric-value\">$${report.summary.avg_cpc.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">CPA</div>\n        <div class=\"metric-value\">$${report.summary.avg_cpa.toFixed(2)}</div>\n      </div>\n      <div class=\"metric-card\">\n        <div class=\"metric-label\">Click Through Rate</div>\n        <div class=\"metric-value\">${report.summary.total_clicks.toLocaleString()}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Charts -->\n  ${\n    options.includeCharts && report.charts.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Performance Trends</h2>\n    ${report.charts\n      .map(\n        (chart) => `\n      <div>\n        <h3 style=\"font-size: 16px; margin-bottom: 10px;\">${chart.title}</h3>\n        <div class=\"chart-placeholder\">Chart: ${chart.title}</div>\n      </div>\n    `\n      )\n      .join('')}\n  </div>\n  `\n      : ''\n  }\n\n  <!-- Top Campaigns -->\n  ${\n    report.top_campaigns.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Top Performing Campaigns</h2>\n    <table class=\"table\">\n      <thead>\n        <tr>\n          <th>Campaign Name</th>\n          <th>Spend</th>\n          <th>Conversions</th>\n          <th>ROAS</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${report.top_campaigns\n          .slice(0, 10)\n          .map(\n            (c) => `\n          <tr>\n            <td>${c.name}</td>\n            <td>$${c.spend.toFixed(2)}</td>\n            <td>${Math.round(c.conversions)}</td>\n            <td>${c.roas.toFixed(2)}x</td>\n          </tr>\n        `\n          )\n          .join('')}\n      </tbody>\n    </table>\n  </div>\n  `\n      : ''\n  }\n\n  <!-- Recommendations -->\n  ${\n    report.recommendations.length > 0\n      ? `\n  <div class=\"section\">\n    <h2>Recommendations</h2>\n    ${report.recommendations\n      .slice(0, 5)\n      .map(\n        (rec) => `\n      <div class=\"recommendation-item\">\n        <div class=\"recommendation-priority priority-${rec.priority}\">${rec.priority.toUpperCase()}</div>\n        <div class=\"recommendation-title\">${rec.title}</div>\n        <p style=\"margin: 5px 0; color: #666;\">${rec.description}</p>\n        <p style=\"margin: 5px 0; font-size: 13px; color: #999;\">\n          <strong>Implementation:</strong> ${rec.implementation_instructions}\n        </p>\n        <p style=\"margin: 5px 0; font-size: 13px; color: #999;\">\n          <strong>Estimated Impact:</strong> ${rec.estimated_impact}%\n        </p>\n      </div>\n    `\n      )\n      .join('')}\n  </div>\n  `\n      : ''\n  }\n\n  <div class=\"footer\">\n    <p>MetaCoach &bull; Automated Performance Report</p>\n    <p>For questions or support, contact your account manager.</p>\n  </div>\n</body>\n</html>\n    `\n  }\n\n  /**\n   * Export report as PDF\n   * Note: In a real implementation, you would use a library like pdfkit or html2pdf\n   * For now, this returns the HTML that can be converted to PDF\n   */\n  async exportAsPDF(report: ClientReport, options?: PDFExportOptions): Promise<Blob> {\n    const mergedOptions = { ...this.defaultOptions, ...options }\n    const html = this.generateHTML(report, mergedOptions)\n\n    // In a real implementation, you would use a PDF library here\n    // For now, we're returning a Blob that contains the HTML\n    // In production, use: html2pdf, pdfkit, or call a server-side PDF conversion service\n\n    const htmlBlob = new Blob([html], { type: 'text/html' })\n    return htmlBlob\n  }\n\n  /**\n   * Generate PDF as data URI (for downloads)\n   */\n  async generatePDFDataUri(report: ClientReport, options?: PDFExportOptions): Promise<string> {\n    const blob = await this.exportAsPDF(report, options)\n    return URL.createObjectURL(blob)\n  }\n\n  /**\n   * Validate PDF before delivery\n   */\n  validatePDF(pdfData: Blob): {\n    isValid: boolean\n    fileSizeKB: number\n    issues: string[]\n  } {\n    const issues: string[] = []\n    const fileSizeKB = pdfData.size / 1024\n\n    if (fileSizeKB > 5000) {\n      issues.push('PDF file size exceeds 5MB limit')\n    }\n\n    if (pdfData.size === 0) {\n      issues.push('PDF is empty')\n    }\n\n    if (!pdfData.type.includes('pdf') && !pdfData.type.includes('octet-stream')) {\n      issues.push('Invalid PDF file type')\n    }\n\n    return {\n      isValid: issues.length === 0,\n      fileSizeKB,\n      issues,\n    }\n  }\n}\n\nexport default new PDFExporter()\n","structuredPatch":[],"originalFile":null}}
