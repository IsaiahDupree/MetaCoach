up', () => {\n    it('should successfully create a new user', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(201)\n      expect(data.success).toBe(true)\n      expect(data.user).toBeDefined()\n      expect(data.user.email).toBe('test@example.com')\n    })\n\n    it('should fail with invalid email format', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'invalid-email',\n          password: 'TestPassword123',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n\n    it('should fail with short password', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'short',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n\n    it('should fail with missing fullName', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n  })\n\n  describe('POST /api/auth/login', () => {\n    it('should successfully authenticate user and return token', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      expect(response.status).toBe(200)\n    })\n\n    it('should fail with invalid credentials', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'WrongPassword',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      // Response status depends on implementation\n      expect([400, 401]).toContain(response.status)\n    })\n\n    it('should fail with missing email', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      expect(response.status).toBe(400)\n    })\n  })\n\n  describe('POST /api/auth/logout', () => {\n    it('should successfully clear auth token', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/logout', {\n        method: 'POST',\n        headers: {\n          cookie: 'auth-token=test-token',\n        },\n      })\n\n      const response = await logoutHandler(req)\n      expect(response.status).toBe(200)\n    })\n  })\n\n  describe('POST /api/auth/forgot-password', () => {\n    it('should handle forgot password request', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/forgot-password', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n        }),\n      })\n\n      const response = await forgotPasswordHandler(req)\n      expect([200, 400]).toContain(response.status)\n    })\n\n    it('should fail with missing email', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/forgot-password', {\n        method: 'POST',\n        body: JSON.stringify({}),\n      })\n\n      const response = await forgotPasswordHandler(req)\n      expect(response.status).toBe(400)\n    })\n  })\n})\n","structuredPatch":[{"oldStart":14,"oldLines":6,"newStart":14,"newLines":25,"lines":[" describe('Auth Endpoints', () => {","   beforeEach(() => {","     jest.clearAllMocks()","+    mockSupabaseAdmin.mockReturnValue({","+      auth: {","+        admin: {","+          createUser: jest.fn().mockResolvedValue({","+            data: { user: { id: 'test-id', email: 'test@example.com' } },","+            error: null,","+          }),","+          deleteUser: jest.fn().mockResolvedValue({ error: null }),","+        },","+        signInWithPassword: jest.fn().mockResolvedValue({","+          data: { user: { id: 'test-id', email: 'test@example.com' }, session: { access_token: 'test-token' } },","+          error: null,","+        }),","+      },","+      from: jest.fn(() => ({","+        insert: jest.fn().mockResolvedValue({ data: null, error: null }),","+        select: jest.fn(),","+      })),","+    })","   })"," ","   describe('POST /api/auth/signup', () => {"]}],"userModified":false,"replaceAll":false}}
