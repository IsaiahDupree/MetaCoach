{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01WcFFvHohGzRxAmpUdDH3LW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BSGX2qLGrM7kXFPKwDTPHf","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/accounts/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { createProtectedRoute } from '@/lib/auth-middleware'\nimport { MetaClient } from '@/lib/meta'\n\nconst handler = async (req: NextRequest & { userId?: string }) => {\n  try {\n    if (!req.userId) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401 }\n      )\n    }\n\n    const supabase = supabaseAdmin()\n\n    // Get user's linked Meta ad accounts from database\n    const { data: accounts, error } = await supabase\n      .from('meta_accounts')\n      .select('id, account_name, account_currency, account_timezone, is_active, access_token, token_expires_at')\n      .eq('user_id', req.userId)\n      .eq('is_active', true)\n\n    if (error) {\n      return NextResponse.json(\n        { error: 'Failed to fetch accounts' },\n        { status: 500 }\n      )\n    }\n\n    if (!accounts || accounts.length === 0) {\n      return NextResponse.json(\n        {\n          success: true,\n          data: [],\n          message: 'No linked Meta ad accounts found. Please connect an account.',\n        },\n        { status: 200 }\n      )\n    }\n\n    // Enrich account data with current balance and status from Meta API\n    const enrichedAccounts = await Promise.all(\n      accounts.map(async (account) => {\n        try {\n          // Check if token is still valid\n          const now = new Date()\n          const expiresAt = new Date(account.token_expires_at || now)\n\n          if (expiresAt < now) {\n            // Token has expired\n            return {\n              id: account.id,\n              name: account.account_name,\n              currency: account.account_currency,\n              timezone: account.account_timezone,\n              status: 'token_expired',\n              balance: null,\n              requiresReauth: true,\n            }\n          }\n\n          // Fetch current account details from Meta API\n          const client = new MetaClient(account.access_token)\n          const response = await client.getAdAccounts()\n          const metaAccount = response.find((acc: any) => acc.id === account.id)\n\n          return {\n            id: account.id,\n            name: account.account_name,\n            currency: account.account_currency || metaAccount?.currency,\n            timezone: account.account_timezone || metaAccount?.timezone_name,\n            status: metaAccount?.account_status || 'unknown',\n            balance: metaAccount?.amount_spent,\n            requiresReauth: false,\n          }\n        } catch (error) {\n          console.error(`Error enriching account ${account.id}:`, error)\n          // Return basic info if API call fails\n          return {\n            id: account.id,\n            name: account.account_name,\n            currency: account.account_currency,\n            timezone: account.account_timezone,\n            status: 'unknown',\n            balance: null,\n            requiresReauth: false,\n          }\n        }\n      })\n    )\n\n    return NextResponse.json(\n      {\n        success: true,\n        data: enrichedAccounts,\n        count: enrichedAccounts.length,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Error fetching accounts:', error)\n    return NextResponse.json(\n      { error: 'An error occurred while fetching accounts' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const GET = createProtectedRoute(handler)\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":2035,"cache_read_input_tokens":138162,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2035},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"2db749b1-efa3-41cb-93fd-425e19950786"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BSGX2qLGrM7kXFPKwDTPHf","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/accounts/route.ts"}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"1811db3b-3ffe-41a0-9273-6192e502bba7","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/accounts/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { createProtectedRoute } from '@/lib/auth-middleware'\nimport { MetaClient } from '@/lib/meta'\n\nconst handler = async (req: NextRequest & { userId?: string }) => {\n  try {\n    if (!req.userId) {\n      return NextResponse.json(\n        { error: 'Unauthorized' },\n        { status: 401 }\n      )\n    }\n\n    const supabase = supabaseAdmin()\n\n    // Get user's linked Meta ad accounts from database\n    const { data: accounts, error } = await supabase\n      .from('meta_accounts')\n      .select('id, account_name, account_currency, account_timezone, is_active, access_token, token_expires_at')\n      .eq('user_id', req.userId)\n      .eq('is_active', true)\n\n    if (error) {\n      return NextResponse.json(\n        { error: 'Failed to fetch accounts' },\n        { status: 500 }\n      )\n    }\n\n    if (!accounts || accounts.length === 0) {\n      return NextResponse.json(\n        {\n          success: true,\n          data: [],\n          message: 'No linked Meta ad accounts found. Please connect an account.',\n        },\n        { status: 200 }\n      )\n    }\n\n    // Enrich account data with current balance and status from Meta API\n    const enrichedAccounts = await Promise.all(\n      accounts.map(async (account) => {\n        try {\n          // Check if token is still valid\n          const now = new Date()\n          const expiresAt = new Date(account.token_expires_at || now)\n\n          if (expiresAt < now) {\n            // Token has expired\n            return {\n              id: account.id,\n              name: account.account_name,\n              currency: account.account_currency,\n              timezone: account.account_timezone,\n              status: 'token_expired',\n              balance: null,\n              requiresReauth: true,\n            }\n          }\n\n          // Fetch current account details from Meta API\n          const client = new MetaClient(account.access_token)\n          const response = await client.getAdAccounts()\n          const metaAccount = response.find((acc: any) => acc.id === account.id)\n\n          return {\n            id: account.id,\n            name: account.account_name,\n            currency: account.account_currency || metaAccount?.currency,\n            timezone: account.account_timezone || metaAccount?.timezone_name,\n            status: metaAccount?.account_status || 'unknown',\n            balance: metaAccount?.amount_spent,\n            requiresReauth: false,\n          }\n        } catch (error) {\n          console.error(`Error enriching account ${account.id}:`, error)\n          // Return basic info if API call fails\n          return {\n            id: account.id,\n            name: account.account_name,\n            currency: account.account_currency,\n            timezone: account.account_timezone,\n            status: 'unknown',\n            balance: null,\n            requiresReauth: false,\n          }\n        }\n      })\n    )\n\n    return NextResponse.json(\n      {\n        success: true,\n        data: enrichedAccounts,\n        count: enrichedAccounts.length,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Error fetching accounts:', error)\n    return NextResponse.json(\n      { error: 'An error occurred while fetching accounts' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const GET = createProtectedRoute(handler)\n","structuredPatch":[],"originalFile":null}}
