{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015fLLaM7JUMAaihZHH166qQ","type":"tool_result","content":"     1→'use client'\n     2→\n     3→import { useEffect, useState } from 'react'\n     4→import { formatNumber } from '@/lib/utils'\n     5→\n     6→interface Page {\n     7→  id: string\n     8→  name: string\n     9→  instagram_business_account: {\n    10→    id: string\n    11→  }\n    12→}\n    13→\n    14→interface MediaItem {\n    15→  id: string\n    16→  caption?: string\n    17→  media_type: string\n    18→  media_url?: string\n    19→  thumbnail_url?: string\n    20→  permalink?: string\n    21→  timestamp: string\n    22→  insights?: {\n    23→    reach?: number\n    24→    likes?: number\n    25→    comments?: number\n    26→    shares?: number\n    27→    saves?: number\n    28→  }\n    29→}\n    30→\n    31→export default function DashboardPage() {\n    32→  const [pages, setPages] = useState<Page[]>([])\n    33→  const [selectedPage, setSelectedPage] = useState<Page | null>(null)\n    34→  const [media, setMedia] = useState<MediaItem[]>([])\n    35→  const [loading, setLoading] = useState(false)\n    36→  const [error, setError] = useState<string | null>(null)\n    37→\n    38→  // Fetch user's Facebook pages\n    39→  useEffect(() => {\n    40→    async function fetchPages() {\n    41→      try {\n    42→        const res = await fetch('/api/meta/me')\n    43→        if (!res.ok) throw new Error('Failed to fetch pages')\n    44→        const data = await res.json()\n    45→        setPages(data.pages)\n    46→        if (data.pages.length === 1) {\n    47→          setSelectedPage(data.pages[0])\n    48→        }\n    49→      } catch (err: any) {\n    50→        setError(err.message)\n    51→      }\n    52→    }\n    53→    fetchPages()\n    54→  }, [])\n    55→\n    56→  // Fetch media when page is selected\n    57→  useEffect(() => {\n    58→    if (!selectedPage) return\n    59→\n    60→    async function fetchMedia(