ateData.implemented_at = new Date().toISOString()\n    }\n\n    const { error } = await supabase\n      .from('meta_coach_recommendations')\n      .update(updateData)\n      .eq('id', recommendationId)\n\n    if (error) {\n      console.error('Error updating recommendation:', error)\n      return NextResponse.json(\n        { error: 'Failed to update recommendation' },\n        { status: 500 }\n      )\n    }\n\n    return NextResponse.json(\n      {\n        success: true,\n        message: isImplemented ? 'Recommendation marked as implemented' : 'Implementation status updated',\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Error updating recommendation:', error)\n    return NextResponse.json(\n      { error: 'An error occurred' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const POST = createProtectedRoute(handler)\nexport const PATCH = createProtectedRoute(handler)\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1429,"cache_read_input_tokens":157207,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1429},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"e51cbf14-1fb9-4921-86de-3b0ab2759a74"}
