{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01G6x75HAreFqJnni4SHGdv6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0143xs7ofHDwATyovUGhVH5t","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/__tests__/api/auth.test.ts","content":"import { POST as signupHandler } from '@/app/api/auth/signup/route'\nimport { POST as loginHandler } from '@/app/api/auth/login/route'\nimport { POST as logoutHandler } from '@/app/api/auth/logout/route'\nimport { POST as forgotPasswordHandler } from '@/app/api/auth/forgot-password/route'\nimport { NextRequest } from 'next/server'\n\n// Mock Supabase\njest.mock('@/lib/supabase', () => ({\n  supabaseAdmin: jest.fn(() => ({\n    auth: {\n      admin: {\n        createUser: jest.fn(),\n        deleteUser: jest.fn(),\n      },\n    },\n    from: jest.fn(() => ({\n      insert: jest.fn(() => Promise.resolve({ data: null, error: null })),\n      select: jest.fn(),\n    })),\n  })),\n}))\n\ndescribe('Auth Endpoints', () => {\n  beforeEach(() => {\n    jest.clearAllMocks()\n  })\n\n  describe('POST /api/auth/signup', () => {\n    it('should successfully create a new user', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(201)\n      expect(data.success).toBe(true)\n      expect(data.user).toBeDefined()\n      expect(data.user.email).toBe('test@example.com')\n    })\n\n    it('should fail with invalid email format', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'invalid-email',\n          password: 'TestPassword123',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n\n    it('should fail with short password', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'short',\n          fullName: 'Test User',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n\n    it('should fail with missing fullName', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/signup', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await signupHandler(req)\n      const data = await response.json()\n\n      expect(response.status).toBe(400)\n      expect(data.error).toBeDefined()\n    })\n  })\n\n  describe('POST /api/auth/login', () => {\n    it('should successfully authenticate user and return token', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      expect(response.status).toBe(200)\n    })\n\n    it('should fail with invalid credentials', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n          password: 'WrongPassword',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      // Response status depends on implementation\n      expect([400, 401]).toContain(response.status)\n    })\n\n    it('should fail with missing email', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/login', {\n        method: 'POST',\n        body: JSON.stringify({\n          password: 'TestPassword123',\n        }),\n      })\n\n      const response = await loginHandler(req)\n      expect(response.status).toBe(400)\n    })\n  })\n\n  describe('POST /api/auth/logout', () => {\n    it('should successfully clear auth token', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/logout', {\n        method: 'POST',\n        headers: {\n          cookie: 'auth-token=test-token',\n        },\n      })\n\n      const response = await logoutHandler(req)\n      expect(response.status).toBe(200)\n    })\n  })\n\n  describe('POST /api/auth/forgot-password', () => {\n    it('should handle forgot password request', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/forgot-password', {\n        method: 'POST',\n        body: JSON.stringify({\n          email: 'test@example.com',\n        }),\n      })\n\n      const response = await forgotPasswordHandler(req)\n      expect([200, 400]).toContain(response.status)\n    })\n\n    it('should fail with missing email', async () => {\n      const req = new NextRequest('http://localhost:4545/api/auth/forgot-password', {\n        method: 'POST',\n        body: JSON.stringify({}),\n      })\n\n      const response = await forgotPasswordHandler(req)\n      expect(response.status).toBe(400)\n    })\n  })\n})\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":373,"cache_read_input_tokens":100253,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens"