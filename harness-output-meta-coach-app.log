{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012BkL7iG9b4c4ii5eQv871n","type":"tool_result","content":"     1→import { supabaseAdmin } from './supabase'\n     2→\n     3→export interface Recommendation {\n     4→  id: string\n     5→  meta_account_id: string\n     6→  recommendation_type: 'budget' | 'creative' | 'audience' | 'targeting'\n     7→  title: string\n     8→  description: string\n     9→  confidence_score: number\n    10→  estimated_impact: number\n    11→  estimated_effort: 'low' | 'medium' | 'high'\n    12→  implementation_instructions: string\n    13→  priority: 'high' | 'medium' | 'low'\n    14→}\n    15→\n    16→export interface PerformanceData {\n    17→  impressions: number\n    18→  clicks: number\n    19→  spend: number\n    20→  actions: number\n    21→  action_value: number\n    22→  ctr: number\n    23→  cpc: number\n    24→  cpa: number\n    25→  roas: number\n    26→}\n    27→\n    28→export class RecommendationEngine {\n    29→  private supabase = supabaseAdmin()\n    30→\n    31→  /**\n    32→   * Generate recommendations for an ad account\n    33→   */\n    34→  async generateRecommendations(accountId: string): Promise<Recommendation[]> {\n    35→    const recommendations: Recommendation[] = []\n    36→\n    37→    // Get ad performance data for the last 30 days\n    38→    const thirtyDaysAgo = new Date()\n    39→    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n    40→\n    41→    const { data: metrics } = await this.supabase\n    42→      .from('meta_ad_performance')\n    43→      .select(\n    44→        `\n    45→        meta_ad_id,\n    46→        date,\n    47→        impressions,\n    48→        clicks,\n    49→        spend,\n    50→        actions,\n    51→        action_value,\n    52→        ctr,\n    53→        cpc,\n    54→        cpa,\n    55→        roas,\n    56→        meta_ads(\n    57→          id,\n    58→          meta_ad_set_id,\n    59→          meta_ad_sets(\n    60→            meta_account_id\n    61→          )\n    62→        )\n    63→      `\n    64→      )\n    65→      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n    66→\n    67→    if (!metrics || metrics.length === 0) {\n    68→      return recommendations\n    69→    }\n    70→\n    71→    // Analyze performance and generate recommendations\n    72→    recommendations.push(...this.generateBudgetRecommendations(metrics))\n    73→    recommendations.push(...this.generateCreativeRecommendations(metrics))\n    74→    recommendations.push(...this.generateAudienceRecommendations(metrics))\n    75→\n    76→    return recommendations\n    77→  }\n    78→\n    79→  /**\n    80→   * Generate budget optimization recommendations\n    81→   */\n    82→  private generateBudgetRecommendations(metrics: any[]): Recommendation[] {\n    83→    const recommendations: Recommendation[] = []\n    84→\n    85→    // Group metrics by ad set\n    86→    const adSetMetrics: { [key: string]: any[] } = {}\n    87→    metrics.forEach((metric) => {\n    88→      const adSetId = metric.meta_ads?.meta_ad_set_id\n    89→      if (adSetId) {\n    90→        if (!adSetMetrics[adSetId]) {\n    91→          adSetMetrics[adSetId] = []\n    92→        }\n    93→        adSetMetrics[adSetId].push(metric)\n    94→      }\n    95→    })\n    96→\n    97→    // Analyze each ad set\n    98→    Object.entries(adSetMetrics).forEach(([adSetId, adSetMetrics]) => {\n    99→      const avgRoas = adSetMetrics.reduce((sum, m) => sum + (m.roas || 0), 0) / adSetMetrics.length\n   100→      const avgCtr = adSetMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / adSetMetrics.length\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"fdcadbf4-e3a6-4453-9929-9162b1752ce2","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/recommendation-engine.ts","content":"import { supabaseAdmin } from './supabase'\n\nexport interface Recommendation {\n  id: string\n  meta_account_id: string\n  recommendation_type: 'budget' | 'creative' | 'audience' | 'targeting'\n  title: string\n  description: string\n  confidence_score: number\n  estimated_impact: number\n  estimated_effort: 'low' | 'medium' | 'high'\n  implementation_instructions: string\n  priority: 'high' | 'medium' | 'low'\n}\n\nexport interface PerformanceData {\n  impressions: number\n  clicks: number\n  spend: number\n  actions: number\n  action_value: number\n  ctr: number\n  cpc: number\n  cpa: number\n  roas: number\n}\n\nexport class RecommendationEngine {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Generate recommendations for an ad account\n   */\n  async generateRecommendations(accountId: string): Promise<Recommendation[]> {\n    const recommendations: Recommendation[] = []\n\n    // Get ad performance data for the last 30 days\n    const thirtyDaysAgo = new Date()\n    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n\n    const { data: metrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select(\n        `\n        meta_ad_id,\n        date,\n        impressions,\n        clicks,\n        spend,\n        actions,\n        action_value,\n        ctr,\n        cpc,\n        cpa,\n        roas,\n        meta_ads(\n          id,\n          meta_ad_set_id,\n          meta_ad_sets(\n            meta_account_id\n          )\n        )\n      `\n      )\n      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n\n    if (!metrics || metrics.length === 0) {\n      return recommendations\n    }\n\n    // Analyze performance and generate recommendations\n    recommendations.push(...this.generateBudgetRecommendations(metrics))\n    recommendations.push(...this.generateCreativeRecommendations(metrics))\n    recommendations.push(...this.generateAudienceRecommendations(metrics))\n\n    return recommendations\n  }\n\n  /**\n   * Generate budget optimization recommendations\n   */\n  private generateBudgetRecommendations(metrics: any[]): Recommendation[] {\n    const recommendations: Recommendation[] = []\n\n    // Group metrics by ad set\n    const adSetMetrics: { [key: string]: any[] } = {}\n    metrics.forEach((metric) => {\n      const adSetId = metric.meta_ads?.meta_ad_set_id\n      if (adSetId) {\n        if (!adSetMetrics[adSetId]) {\n          adSetMetrics[adSetId] = []\n        }\n        adSetMetrics[adSetId].push(metric)\n      }\n    })\n\n    // Analyze each ad set\n    Object.entries(adSetMetrics).forEach(([adSetId, adSetMetrics]) => {\n      const avgRoas = adSetMetrics.reduce((sum, m) => sum + (m.roas || 0), 0) / adSetMetrics.length\n      const avgCtr = adSetMetrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / adSetMetrics.length","numLines":100,"startLine":1,"totalLines":274}}}
