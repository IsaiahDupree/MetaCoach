et('from') || new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString()\n    62→    const to = searchParams.get('to') || new Date().toISOString()\n    63→    const requestedMetrics = searchParams.get('metrics')?.split(',') || []\n    64→\n    65→    const client = new MetaClient(token)\n    66→\n    67→    // Get pages\n    68→    const pages = await client.getPages()\n    69→    if (!pages || pages.length === 0) {\n    70→      return NextResponse.json<MetricsResponse>({\n    71→        service: 'meta',\n    72→        period: { from, to },\n    73→        summary: {\n    74→          total_posts: 0,\n    75→          total_reach: 0,\n    76→          total_engagement: 0,\n    77→          avg_engagement_rate: 0,\n    78→          analyzed_posts: 0,\n    79→        },\n    80→        metrics: [],\n    81→      })\n    82→    }\n    83→\n    84→    const page = pages[0]\n    85→    \n    86→    // Get Instagram Business Account\n    87→    const igUserId = await client.getInstagramBusinessAccountId(page.id)\n    88→    if (!igUserId) {\n    89→      return NextResponse.json(\n    90→        { error: 'No Instagram Business Account found' },\n    91→        { status: 404 }\n    92→      )\n    93→    }\n    94→\n    95→    // Fetch media in the time period\n    96→    const allMedia = await client.getMedia(igUserId, 100)\n    97→    const fromDate = new Date(from)\n    98→    const toDate = new Date(to)\n    99→    \n   100→    const mediaInPeriod = allMedia.filter((m) => {\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"0a7a6962-707b-432a-94ba-10b2e85c8b93","uuid":"ba987b8b-dc7b-45fc-91f9-c686fbecd235","tool_use_result":{"type":"