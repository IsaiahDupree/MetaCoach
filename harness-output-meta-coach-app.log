{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01PZXPovkwzTz5kHPeG7SYKg","type":"message","role":"assistant","content":[{"type":"text","text":"**Implementing ALERT-001 & ALERT-002: Alert System**"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":2742,"cache_read_input_tokens":138625,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2742},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"4aa68de9-5623-47a0-a9cc-ba23b8e574d9"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01PZXPovkwzTz5kHPeG7SYKg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MrjcCE44jLVmCgiZs9drja","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/alert-engine.ts","content":"import { supabaseAdmin } from './supabase'\nimport { emailService } from './email-service'\n\nexport interface PerformanceAlert {\n  id: string\n  meta_account_id: string\n  alert_type: 'anomaly' | 'budget_overspend' | 'low_performance' | 'high_cpc'\n  title: string\n  description: string\n  severity: 'critical' | 'warning' | 'info'\n  metric: string\n  current_value: number\n  threshold_value: number\n  created_at: string\n  acknowledged: boolean\n}\n\nexport interface AlertThreshold {\n  id: string\n  meta_account_id: string\n  alert_type: 'anomaly' | 'budget_overspend' | 'low_performance' | 'high_cpc'\n  metric: string\n  threshold: number\n  operator: '>' | '<' | '=' | '!='\n  enabled: boolean\n}\n\nexport interface AlertConfiguration {\n  meta_account_id: string\n  email_recipients: string[]\n  sms_recipients?: string[]\n  enable_performance_alerts: boolean\n  enable_budget_alerts: boolean\n  performance_alert_delay_minutes?: number\n  budget_alert_threshold_percent?: number\n}\n\nexport class AlertEngine {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Check for performance anomalies\n   */\n  async checkPerformanceAnomalies(accountId: string): Promise<PerformanceAlert[]> {\n    const alerts: PerformanceAlert[] = []\n\n    // Fetch current metrics\n    const { data: currentMetrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('date', { ascending: false })\n      .limit(7)\n\n    if (!currentMetrics || currentMetrics.length === 0) return alerts\n\n    // Get historical metrics (30 days ago)\n    const thirtyDaysAgo = new Date()\n    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n\n    const { data: historicalMetrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n      .lte('date', new Date(thirtyDaysAgo.getTime() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0])\n\n    if (!historicalMetrics) return alerts\n\n    // Calculate metrics\n    const currentAvg = this.calculateMetricsAverage(currentMetrics)\n    const historicalAvg = this.calculateMetricsAverage(historicalMetrics)\n\n    // Check for significant drops\n    const ctrDrop = ((historicalAvg.ctr - currentAvg.ctr) / historicalAvg.ctr) * 100\n    if (ctrDrop > 20) {\n      alerts.push({\n        id: `alert_${Date.now()}_ctr`,\n        meta_account_id: accountId,\n        alert_type: 'anomaly',\n        title: 'Significant CTR Drop Detected',\n        description: `Click-through rate has dropped ${ctrDrop.toFixed(1)}% compared to 30-day average. This may indicate audience fatigue or targeting issues.`,\n        severity: 'warning',\n        metric: 'ctr',\n        current_value: currentAvg.ctr,\n        threshold_value: historicalAvg.ctr,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Check for ROAS decline\n    const roasDrop = ((historicalAvg.roas - currentAvg.roas) / historicalAvg.roas) * 100\n    if (roasDrop > 30) {\n      alerts.push({\n        id: `alert_${Date.now()}_roas`,\n        meta_account_id: accountId,\n        alert_type: 'low_performance',\n        title: 'ROAS Below Average',\n        description: `Return on ad spend has declined ${roasDrop.toFixed(1)}%. Consider reviewing targeting, creative, or budget allocation.`,\n        severity: 'critical',\n        metric: 'roas',\n        current_value: currentAvg.roas,\n        threshold_value: historicalAvg.roas,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Check for CPC increase\n    const cpcIncrease = ((currentAvg.cpc - historicalAvg.cpc) / historicalAvg.cpc) * 100\n    if (cpcIncrease > 25) {\n      alerts.push({\n        id: `alert_${Date.now()}_cpc`,\n        meta_account_id: accountId,\n        alert_type: 'high_cpc',\n        title: 'Cost Per Click Increased',\n        description: `CPC has increased ${cpcIncrease.toFixed(1)}%, indicating higher competition or lower relevance.`,\n        severity: 'warning',\n        metric: 'cpc',\n        current_value: currentAvg.cpc,\n        threshold_value: historicalAvg.cpc,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Store alerts in database\n    for (const alert of alerts) {\n      await this.storeAlert(alert)\n    }\n\n    return alerts\n  }\n\n  /**\n   * Check for budget overspend\n   */\n  async checkBudgetOverspend(accountId: string): Promise<PerformanceAlert[]> {\n    const alerts: PerformanceAlert[] = []\n\n    // Fetch campaigns with budget data\n    const { data: campaigns } = await this.supabase\n      .from('meta_campaigns')\n      .select('*, meta_ad_performance(spend, actions)')\n      .eq('meta_account_id', accountId)\n\n    if (!campaigns) return alerts\n\n    for (const campaign of campaigns) {\n      const totalSpend = campaign.meta_ad_performance?.reduce((sum: number, p: any) => sum + (p.spend || 0), 0) || 0\n\n      // Get daily budget if available\n      const dailyBudget = (campaign as any).daily_budget || 0\n      if (dailyBudget > 0) {\n        const daysSinceStart = 1\n        const budgetLimit = dailyBudget * daysSinceStart\n        const percentOfBudget = (totalSpend / budgetLimit) * 100\n\n        if (percentOfBudget > 100) {\n          alerts.push({\n            id: `alert_${Date.now()}_budget`,\n            meta_account_id: accountId,\n            alert_type: 'budget_overspend',\n            title: `Budget Overspend - ${campaign.name}`,\n            description: `Campaign has spent ${percentOfBudget.toFixed(1)}% of daily budget. Current spend: $${totalSpend.toFixed(2)}, Daily budget: $${dailyBudget.toFixed(2)}.`,\n            severity: 'critical',\n            metric: 'daily_budget',\n            current_value: totalSpend,\n            threshold_value: dailyBudget,\n            created_at: new Date().toISOString(),\n            acknowledged: false,\n          })\n        } else if (percentOfBudget > 80) {\n          alerts.push({\n            id: `alert_${Date.now()}_budget_warn`,\n            meta_account_id: accountId,\n            alert_type: 'budget_overspend',\n            title: `Budget Warning - ${campaign.name}`,\n            description: `Campaign has spent ${percentOfBudget.toFixed(1)}% of daily budget. Approaching limit.`,\n            severity: 'warning',\n            metric: 'daily_budget',\n            current_value: totalSpend,\n            threshold_value: dailyBudget,\n            created_at: new Date().toISOString(),\n            acknowledged: false,\n          })\n        }\n      }\n    }\n\n    // Store alerts\n    for (const alert of alerts) {\n      await this.storeAlert(alert)\n    }\n\n    return alerts\n  }\n\n  /**\n   * Send alert notifications\n   */\n  async sendAlertNotifications(alerts: PerformanceAlert[], config: AlertConfiguration): Promise<void> {\n    if (alerts.length === 0 || !config.email_recipients.length) return\n\n    const emailBody = this.generateAlertEmailBody(alerts)\n\n    for (const recipient of config.email_recipients) {\n      await emailService.sendReportEmail([recipient], {\n        title: 'Performance Alert',\n        period: new Date().toLocaleDateString(),\n        metrics: {\n          alert_count: alerts.length,\n          critical_count: alerts.filter((a) => a.severity === 'critical').length,\n        },\n        attachment: {\n          filename: 'alerts.txt',\n          content: emailBody,\n        },\n      })\n    }\n  }\n\n  /**\n   * Generate alert email body\n   */\n  private generateAlertEmailBody(alerts: PerformanceAlert[]): string {\n    let body = 'Performance Alerts\\n'\n    body += '==================\\n\\n'\n\n    const criticalAlerts = alerts.filter((a) => a.severity === 'critical')\n    const warningAlerts = alerts.filter((a) => a.severity === 'warning')\n    const infoAlerts = alerts.filter((a) => a.severity === 'info')\n\n    if (criticalAlerts.length > 0) {\n      body += 'CRITICAL ALERTS\\n'\n      body += criticalAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    if (warningAlerts.length > 0) {\n      body += 'WARNINGS\\n'\n      body += warningAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    if (infoAlerts.length > 0) {\n      body += 'INFO\\n'\n      body += infoAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    return body\n  }\n\n  /**\n   * Store alert in database\n   */\n  private async storeAlert(alert: PerformanceAlert): Promise<void> {\n    await this.supabase.from('meta_alerts').insert([alert])\n  }\n\n  /**\n   * Get recent alerts for account\n   */\n  async getAlerts(accountId: string, limit: number = 10): Promise<PerformanceAlert[]> {\n    const { data } = await this.supabase\n      .from('meta_alerts')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('created_at', { ascending: false })\n      .limit(limit)\n\n    return data || []\n  }\n\n  /**\n   * Acknowledge an alert\n   */\n  async acknowledgeAlert(alertId: string): Promise<void> {\n    await this.supabase.from('meta_alerts').update({ acknowledged: true }).eq('id', alertId)\n  }\n\n  /**\n   * Create or update alert threshold\n   */\n  async setAlertThreshold(threshold: AlertThreshold): Promise<AlertThreshold> {\n    const { data, error } = await this.supabase\n      .from('meta_alert_thresholds')\n      .upsert([threshold], { onConflict: 'id' })\n      .select()\n      .single()\n\n    if (error) throw error\n    return data\n  }\n\n  /**\n   * Get alert configuration for account\n   */\n  async getAlertConfig(accountId: string): Promise<AlertConfiguration | null> {\n    const { data } = await this.supabase\n      .from('meta_alert_configurations')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .single()\n\n    return data || null\n  }\n\n  /**\n   * Update alert configuration\n   */\n  async updateAlertConfig(accountId: string, config: Partial<AlertConfiguration>): Promise<AlertConfiguration> {\n    const { data, error } = await this.supabase\n      .from('meta_alert_configurations')\n      .update(config)\n      .eq('meta_account_id', accountId)\n      .select()\n      .single()\n\n    if (error) throw error\n    return data\n  }\n\n  /**\n   * Calculate average metrics\n   */\n  private calculateMetricsAverage(metrics: any[]): {\n    ctr: number\n    cpc: number\n    roas: number\n    spend: number\n  } {\n    if (metrics.length === 0) {\n      return { ctr: 0, cpc: 0, roas: 0, spend: 0 }\n    }\n\n    const ctr = metrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / metrics.length\n    const cpc = metrics.reduce((sum, m) => sum + (m.cpc || 0), 0) / metrics.length\n    const roas = metrics.reduce((sum, m) => sum + (m.roas || 0), 0) / metrics.length\n    const spend = metrics.reduce((sum, m) => sum + (m.spend || 0), 0)\n\n    return { ctr, cpc, roas, spend }\n  }\n}\n\nexport const emailService = {}\nexport default new AlertEngine()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":2742,"cache_read_input_tokens":138625,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2742},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"0fcbf64d-c888-4102-bd78-ed52acb99ebd"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MrjcCE44jLVmCgiZs9drja","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/MetaCoach/lib/alert-engine.ts"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"3d84f243-bc08-4b64-b44e-ed20b3482b66","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/alert-engine.ts","content":"import { supabaseAdmin } from './supabase'\nimport { emailService } from './email-service'\n\nexport interface PerformanceAlert {\n  id: string\n  meta_account_id: string\n  alert_type: 'anomaly' | 'budget_overspend' | 'low_performance' | 'high_cpc'\n  title: string\n  description: string\n  severity: 'critical' | 'warning' | 'info'\n  metric: string\n  current_value: number\n  threshold_value: number\n  created_at: string\n  acknowledged: boolean\n}\n\nexport interface AlertThreshold {\n  id: string\n  meta_account_id: string\n  alert_type: 'anomaly' | 'budget_overspend' | 'low_performance' | 'high_cpc'\n  metric: string\n  threshold: number\n  operator: '>' | '<' | '=' | '!='\n  enabled: boolean\n}\n\nexport interface AlertConfiguration {\n  meta_account_id: string\n  email_recipients: string[]\n  sms_recipients?: string[]\n  enable_performance_alerts: boolean\n  enable_budget_alerts: boolean\n  performance_alert_delay_minutes?: number\n  budget_alert_threshold_percent?: number\n}\n\nexport class AlertEngine {\n  private supabase = supabaseAdmin()\n\n  /**\n   * Check for performance anomalies\n   */\n  async checkPerformanceAnomalies(accountId: string): Promise<PerformanceAlert[]> {\n    const alerts: PerformanceAlert[] = []\n\n    // Fetch current metrics\n    const { data: currentMetrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('date', { ascending: false })\n      .limit(7)\n\n    if (!currentMetrics || currentMetrics.length === 0) return alerts\n\n    // Get historical metrics (30 days ago)\n    const thirtyDaysAgo = new Date()\n    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)\n\n    const { data: historicalMetrics } = await this.supabase\n      .from('meta_ad_performance')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .gte('date', thirtyDaysAgo.toISOString().split('T')[0])\n      .lte('date', new Date(thirtyDaysAgo.getTime() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0])\n\n    if (!historicalMetrics) return alerts\n\n    // Calculate metrics\n    const currentAvg = this.calculateMetricsAverage(currentMetrics)\n    const historicalAvg = this.calculateMetricsAverage(historicalMetrics)\n\n    // Check for significant drops\n    const ctrDrop = ((historicalAvg.ctr - currentAvg.ctr) / historicalAvg.ctr) * 100\n    if (ctrDrop > 20) {\n      alerts.push({\n        id: `alert_${Date.now()}_ctr`,\n        meta_account_id: accountId,\n        alert_type: 'anomaly',\n        title: 'Significant CTR Drop Detected',\n        description: `Click-through rate has dropped ${ctrDrop.toFixed(1)}% compared to 30-day average. This may indicate audience fatigue or targeting issues.`,\n        severity: 'warning',\n        metric: 'ctr',\n        current_value: currentAvg.ctr,\n        threshold_value: historicalAvg.ctr,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Check for ROAS decline\n    const roasDrop = ((historicalAvg.roas - currentAvg.roas) / historicalAvg.roas) * 100\n    if (roasDrop > 30) {\n      alerts.push({\n        id: `alert_${Date.now()}_roas`,\n        meta_account_id: accountId,\n        alert_type: 'low_performance',\n        title: 'ROAS Below Average',\n        description: `Return on ad spend has declined ${roasDrop.toFixed(1)}%. Consider reviewing targeting, creative, or budget allocation.`,\n        severity: 'critical',\n        metric: 'roas',\n        current_value: currentAvg.roas,\n        threshold_value: historicalAvg.roas,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Check for CPC increase\n    const cpcIncrease = ((currentAvg.cpc - historicalAvg.cpc) / historicalAvg.cpc) * 100\n    if (cpcIncrease > 25) {\n      alerts.push({\n        id: `alert_${Date.now()}_cpc`,\n        meta_account_id: accountId,\n        alert_type: 'high_cpc',\n        title: 'Cost Per Click Increased',\n        description: `CPC has increased ${cpcIncrease.toFixed(1)}%, indicating higher competition or lower relevance.`,\n        severity: 'warning',\n        metric: 'cpc',\n        current_value: currentAvg.cpc,\n        threshold_value: historicalAvg.cpc,\n        created_at: new Date().toISOString(),\n        acknowledged: false,\n      })\n    }\n\n    // Store alerts in database\n    for (const alert of alerts) {\n      await this.storeAlert(alert)\n    }\n\n    return alerts\n  }\n\n  /**\n   * Check for budget overspend\n   */\n  async checkBudgetOverspend(accountId: string): Promise<PerformanceAlert[]> {\n    const alerts: PerformanceAlert[] = []\n\n    // Fetch campaigns with budget data\n    const { data: campaigns } = await this.supabase\n      .from('meta_campaigns')\n      .select('*, meta_ad_performance(spend, actions)')\n      .eq('meta_account_id', accountId)\n\n    if (!campaigns) return alerts\n\n    for (const campaign of campaigns) {\n      const totalSpend = campaign.meta_ad_performance?.reduce((sum: number, p: any) => sum + (p.spend || 0), 0) || 0\n\n      // Get daily budget if available\n      const dailyBudget = (campaign as any).daily_budget || 0\n      if (dailyBudget > 0) {\n        const daysSinceStart = 1\n        const budgetLimit = dailyBudget * daysSinceStart\n        const percentOfBudget = (totalSpend / budgetLimit) * 100\n\n        if (percentOfBudget > 100) {\n          alerts.push({\n            id: `alert_${Date.now()}_budget`,\n            meta_account_id: accountId,\n            alert_type: 'budget_overspend',\n            title: `Budget Overspend - ${campaign.name}`,\n            description: `Campaign has spent ${percentOfBudget.toFixed(1)}% of daily budget. Current spend: $${totalSpend.toFixed(2)}, Daily budget: $${dailyBudget.toFixed(2)}.`,\n            severity: 'critical',\n            metric: 'daily_budget',\n            current_value: totalSpend,\n            threshold_value: dailyBudget,\n            created_at: new Date().toISOString(),\n            acknowledged: false,\n          })\n        } else if (percentOfBudget > 80) {\n          alerts.push({\n            id: `alert_${Date.now()}_budget_warn`,\n            meta_account_id: accountId,\n            alert_type: 'budget_overspend',\n            title: `Budget Warning - ${campaign.name}`,\n            description: `Campaign has spent ${percentOfBudget.toFixed(1)}% of daily budget. Approaching limit.`,\n            severity: 'warning',\n            metric: 'daily_budget',\n            current_value: totalSpend,\n            threshold_value: dailyBudget,\n            created_at: new Date().toISOString(),\n            acknowledged: false,\n          })\n        }\n      }\n    }\n\n    // Store alerts\n    for (const alert of alerts) {\n      await this.storeAlert(alert)\n    }\n\n    return alerts\n  }\n\n  /**\n   * Send alert notifications\n   */\n  async sendAlertNotifications(alerts: PerformanceAlert[], config: AlertConfiguration): Promise<void> {\n    if (alerts.length === 0 || !config.email_recipients.length) return\n\n    const emailBody = this.generateAlertEmailBody(alerts)\n\n    for (const recipient of config.email_recipients) {\n      await emailService.sendReportEmail([recipient], {\n        title: 'Performance Alert',\n        period: new Date().toLocaleDateString(),\n        metrics: {\n          alert_count: alerts.length,\n          critical_count: alerts.filter((a) => a.severity === 'critical').length,\n        },\n        attachment: {\n          filename: 'alerts.txt',\n          content: emailBody,\n        },\n      })\n    }\n  }\n\n  /**\n   * Generate alert email body\n   */\n  private generateAlertEmailBody(alerts: PerformanceAlert[]): string {\n    let body = 'Performance Alerts\\n'\n    body += '==================\\n\\n'\n\n    const criticalAlerts = alerts.filter((a) => a.severity === 'critical')\n    const warningAlerts = alerts.filter((a) => a.severity === 'warning')\n    const infoAlerts = alerts.filter((a) => a.severity === 'info')\n\n    if (criticalAlerts.length > 0) {\n      body += 'CRITICAL ALERTS\\n'\n      body += criticalAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    if (warningAlerts.length > 0) {\n      body += 'WARNINGS\\n'\n      body += warningAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    if (infoAlerts.length > 0) {\n      body += 'INFO\\n'\n      body += infoAlerts.map((a) => `- ${a.title}: ${a.description}`).join('\\n')\n      body += '\\n\\n'\n    }\n\n    return body\n  }\n\n  /**\n   * Store alert in database\n   */\n  private async storeAlert(alert: PerformanceAlert): Promise<void> {\n    await this.supabase.from('meta_alerts').insert([alert])\n  }\n\n  /**\n   * Get recent alerts for account\n   */\n  async getAlerts(accountId: string, limit: number = 10): Promise<PerformanceAlert[]> {\n    const { data } = await this.supabase\n      .from('meta_alerts')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .order('created_at', { ascending: false })\n      .limit(limit)\n\n    return data || []\n  }\n\n  /**\n   * Acknowledge an alert\n   */\n  async acknowledgeAlert(alertId: string): Promise<void> {\n    await this.supabase.from('meta_alerts').update({ acknowledged: true }).eq('id', alertId)\n  }\n\n  /**\n   * Create or update alert threshold\n   */\n  async setAlertThreshold(threshold: AlertThreshold): Promise<AlertThreshold> {\n    const { data, error } = await this.supabase\n      .from('meta_alert_thresholds')\n      .upsert([threshold], { onConflict: 'id' })\n      .select()\n      .single()\n\n    if (error) throw error\n    return data\n  }\n\n  /**\n   * Get alert configuration for account\n   */\n  async getAlertConfig(accountId: string): Promise<AlertConfiguration | null> {\n    const { data } = await this.supabase\n      .from('meta_alert_configurations')\n      .select('*')\n      .eq('meta_account_id', accountId)\n      .single()\n\n    return data || null\n  }\n\n  /**\n   * Update alert configuration\n   */\n  async updateAlertConfig(accountId: string, config: Partial<AlertConfiguration>): Promise<AlertConfiguration> {\n    const { data, error } = await this.supabase\n      .from('meta_alert_configurations')\n      .update(config)\n      .eq('meta_account_id', accountId)\n      .select()\n      .single()\n\n    if (error) throw error\n    return data\n  }\n\n  /**\n   * Calculate average metrics\n   */\n  private calculateMetricsAverage(metrics: any[]): {\n    ctr: number\n    cpc: number\n    roas: number\n    spend: number\n  } {\n    if (metrics.length === 0) {\n      return { ctr: 0, cpc: 0, roas: 0, spend: 0 }\n    }\n\n    const ctr = metrics.reduce((sum, m) => sum + (m.ctr || 0), 0) / metrics.length\n    const cpc = metrics.reduce((sum, m) => sum + (m.cpc || 0), 0) / metrics.length\n    const roas = metrics.reduce((sum, m) => sum + (m.roas || 0), 0) / metrics.length\n    const spend = metrics.reduce((sum, m) => sum + (m.spend || 0), 0)\n\n    return { ctr, cpc, roas, spend }\n  }\n}\n\nexport const emailService = {}\nexport default new AlertEngine()\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_019nFay3iSnLUKj9HgTfZnCC","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now let me implement the monitoring system (MONITOR-001 and MONITOR-002). I'll create an error tracking and performance monitoring module.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3640,"cache_read_input_tokens":141367,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3640},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"e7e33dfe-3bba-4df1-95b7-32c0a7dd966f"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_019nFay3iSnLUKj9HgTfZnCC","type":"message","role":"assistant","content":[{"type":"text","text":"**Implementing MONITOR-001 & MONITOR-002: Error Tracking & Performance Monitoring**"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3640,"cache_read_input_tokens":141367,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3640},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"57bf71d9-3483-4dc1-8cf0-47880fe85566"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_019nFay3iSnLUKj9HgTfZnCC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0184teAdiePJL2ZomwANzach","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/monitoring.ts","content":"import { supabaseAdmin } from './supabase'\n\nexport interface ErrorLog {\n  id: string\n  timestamp: string\n  severity: 'error' | 'warning' | 'info'\n  message: string\n  stack_trace?: string\n  context?: {\n    user_id?: string\n    account_id?: string\n    endpoint?: string\n    [key: string]: any\n  }\n  resolved: boolean\n}\n\nexport interface PerformanceMetric {\n  id: string\n  timestamp: string\n  metric_type: 'api_response' | 'database_query' | 'page_load' | 'chart_render'\n  duration_ms: number\n  endpoint?: string\n  status?: number\n  success: boolean\n  context?: {\n    [key: string]: any\n  }\n}\n\nexport class ErrorTracker {\n  private supabase = supabaseAdmin()\n  private errors: ErrorLog[] = []\n  private maxErrors = 100\n\n  /**\n   * Log an error\n   */\n  async logError(\n    message: string,\n    error?: Error,\n    context?: ErrorLog['context']\n  ): Promise<void> {\n    const errorLog: ErrorLog = {\n      id: `error_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n      severity: 'error',\n      message,\n      stack_trace: error?.stack,\n      context,\n      resolved: false,\n    }\n\n    // Store in memory\n    this.errors.push(errorLog)\n    if (this.errors.length > this.maxErrors) {\n      this.errors.shift()\n    }\n\n    // Store in database\n    try {\n      await this.supabase.from('meta_error_logs').insert([errorLog])\n    } catch (dbError) {\n      console.error('Failed to log error to database:', dbError)\n    }\n\n    // Log to console in development\n    if (process.env.NODE_ENV === 'development') {\n      console.error(`[${errorLog.severity.toUpperCase()}] ${message}`, error, context)\n    }\n  }\n\n  /**\n   * Log a warning\n   */\n  async logWarning(message: string, context?: ErrorLog['context']): Promise<void> {\n    const warningLog: ErrorLog = {\n      id: `warn_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n      severity: 'warning',\n      message,\n      context,\n      resolved: false,\n    }\n\n    this.errors.push(warningLog)\n\n    try {\n      await this.supabase.from('meta_error_logs').insert([warningLog])\n    } catch (dbError) {\n      console.error('Failed to log warning to database:', dbError)\n    }\n  }\n\n  /**\n   * Get error frequency (for alerting on high error rates)\n   */\n  getErrorFrequency(timeWindowMinutes: number = 60): {\n    total: number\n    critical: number\n    last_error?: string\n  } {\n    const cutoffTime = new Date(Date.now() - timeWindowMinutes * 60 * 1000)\n\n    const recentErrors = this.errors.filter(\n      (e) => new Date(e.timestamp) > cutoffTime\n    )\n\n    return {\n      total: recentErrors.length,\n      critical: recentErrors.filter((e) => e.severity === 'error').length,\n      last_error: recentErrors.length > 0 ? recentErrors[recentErrors.length - 1].message : undefined,\n    }\n  }\n\n  /**\n   * Get logs from database\n   */\n  async getLogs(\n    limit: number = 50,\n    severity?: 'error' | 'warning' | 'info'\n  ): Promise<ErrorLog[]> {\n    let query = this.supabase.from('meta_error_logs').select('*').order('timestamp', { ascending: false }).limit(limit)\n\n    if (severity) {\n      query = query.eq('severity', severity)\n    }\n\n    const { data } = await query\n\n    return data || []\n  }\n\n  /**\n   * Mark error as resolved\n   */\n  async resolveError(errorId: string): Promise<void> {\n    await this.supabase.from('meta_error_logs').update({ resolved: true }).eq('id', errorId)\n  }\n\n  /**\n   * Clear old logs (retention policy)\n   */\n  async clearOldLogs(retentionDays: number = 30): Promise<number> {\n    const cutoffDate = new Date(Date.now() - retentionDays * 24 * 60 * 60 * 1000)\n\n    const { error, data } = await this.supabase\n      .from('meta_error_logs')\n      .delete()\n      .lt('timestamp', cutoffDate.toISOString())\n      .select()\n\n    if (error) throw error\n\n    return (data as any)?.length || 0\n  }\n}\n\nexport class PerformanceMonitor {\n  private supabase = supabaseAdmin()\n  private metrics: PerformanceMetric[] = []\n  private maxMetrics = 1000\n\n  /**\n   * Record API response time\n   */\n  async recordApiMetric(\n    endpoint: string,\n    durationMs: number,\n    status: number,\n    success: boolean\n  ): Promise<void> {\n    const metric: PerformanceMetric = {\n      id: `perf_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n      metric_type: 'api_response',\n      duration_ms: durationMs,\n      endpoint,\n      status,\n      success,\n    }\n\n    this.metrics.push(metric)\n    if (this.metrics.length > this.maxMetrics) {\n      this.metrics.shift()\n    }\n\n    // Store in database\n    try {\n      await this.supabase.from('meta_performance_metrics').insert([metric])\n    } catch (dbError) {\n      console.error('Failed to log performance metric:', dbError)\n    }\n\n    // Alert if response time is too high\n    if (durationMs > 1000) {\n      console.warn(`[PERF WARN] ${endpoint} took ${durationMs}ms`)\n    }\n  }\n\n  /**\n   * Record database query time\n   */\n  async recordDatabaseMetric(\n    query: string,\n    durationMs: number,\n    success: boolean\n  ): Promise<void> {\n    const metric: PerformanceMetric = {\n      id: `db_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n      metric_type: 'database_query',\n      duration_ms: durationMs,\n      success,\n      context: { query: query.substring(0, 100) },\n    }\n\n    this.metrics.push(metric)\n\n    if (durationMs > 500) {\n      console.warn(`[DB WARN] Query took ${durationMs}ms`)\n    }\n  }\n\n  /**\n   * Record page load time\n   */\n  recordPageLoadMetric(durationMs: number, pagePath: string): void {\n    const metric: PerformanceMetric = {\n      id: `page_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n      metric_type: 'page_load',\n      duration_ms: durationMs,\n      success: durationMs < 3000,\n      context: { page: pagePath },\n    }\n\n    this.metrics.push(metric)\n\n    if (durationMs > 2000) {\n      console.warn(`[PAGE WARN] ${pagePath} took ${durationMs}ms to load`)\n    }\n  }\n\n  /**\n   * Get performance summary\n   */\n  getPerformanceSummary(timeWindowMinutes: number = 60): {\n    avg_response_time_ms: number\n    p95_response_time_ms: number\n    p99_response_time_ms: number\n    error_rate_percent: number\n    total_requests: number\n  } {\n    const cutoffTime = new Date(Date.now() - timeWindowMinutes * 60 * 1000)\n    const recent = this.metrics.filter((m) => new Date(m.timestamp) > cutoffTime)\n\n    if (recent.length === 0) {\n      return {\n        avg_response_time_ms: 0,\n        p95_response_time_ms: 0,\n        p99_response_time_ms: 0,\n        error_rate_percent: 0,\n        total_requests: 0,\n      }\n    }\n\n    const durations = recent.map((m) => m.duration_ms).sort((a, b) => a - b)\n    const avg = durations.reduce((a, b) => a + b, 0) / durations.length\n    const p95 = durations[Math.floor(durations.length * 0.95)]\n    const p99 = durations[Math.floor(durations.length * 0.99)]\n    const failures = recent.filter((m) => !m.success).length\n    const errorRate = (failures / recent.length) * 100\n\n    return {\n      avg_response_time_ms: parseFloat(avg.toFixed(2)),\n      p95_response_time_ms: p95,\n      p99_response_time_ms: p99,\n      error_rate_percent: parseFloat(errorRate.toFixed(2)),\n      total_requests: recent.length,\n    }\n  }\n\n  /**\n   * Get metrics from database\n   */\n  async getMetrics(\n    limit: number = 100,\n    metricType?: PerformanceMetric['metric_type']\n  ): Promise<PerformanceMetric[]> {\n    let query = this.supabase\n      .from('meta_performance_metrics')\n      .select('*')\n      .order('timestamp', { ascending: false })\n      .limit(limit)\n\n    if (metricType) {\n      query = query.eq('metric_type', metricType)\n    }\n\n    const { data } = await query\n\n    return data || []\n  }\n\n  /**\n   * Get slow endpoints\n   */\n  getSlowEndpoints(limit: number = 5): {\n    endpoint: string\n    avg_duration_ms: number\n    max_duration_ms: number\n    request_count: number\n  }[] {\n    const apiMetrics = this.metrics.filter((m) => m.metric_type === 'api_response' && m.endpoint)\n\n    const grouped: {\n      [key: string]: PerformanceMetric[]\n    } = {}\n\n    apiMetrics.forEach((m) => {\n      if (m.endpoint) {\n        if (!grouped[m.endpoint]) {\n          grouped[m.endpoint] = []\n        }\n        grouped[m.endpoint].push(m)\n      }\n    })\n\n    return Object.entries(grouped)\n      .map(([endpoint, metrics]) => ({\n        endpoint,\n        avg_duration_ms: parseFloat(\n          (metrics.reduce((a, m) => a + m.duration_ms, 0) / metrics.length).toFixed(2)\n        ),\n        max_duration_ms: Math.max(...metrics.map((m) => m.duration_ms)),\n        request_count: metrics.length,\n      }))\n      .sort((a, b) => b.avg_duration_ms - a.avg_duration_ms)\n      .slice(0, limit)\n  }\n\n  /**\n   * Clear old metrics (retention policy)\n   */\n  async clearOldMetrics(retentionDays: number = 30): Promise<number> {\n    const cutoffDate = new Date(Date.now() - retentionDays * 24 * 60 * 60 * 1000)\n\n    const { data } = await this.supabase\n      .from('meta_performance_metrics')\n      .delete()\n      .lt('timestamp', cutoffDate.toISOString())\n      .select()\n\n    return (data as any)?.length || 0\n  }\n}\n\n// Export singleton instances\nexport const errorTracker = new ErrorTracker()\nexport const performanceMonitor = new PerformanceMonitor()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3640,"cache_read_input_tokens":141367,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3640},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"868afca7-e196-4a12-921d-d228b409b0a8"}
