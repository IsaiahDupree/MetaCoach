ampaign[]>([])\n  const [metrics, setMetrics] = useState<MetricSummary | null>(null)\n  const [recommendations, setRecommendations] = useState<Recommendation[]>([])\n  const [performanceData, setPerformanceData] = useState<PerformanceData[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n  const [period, setPeriod] = useState<'7d' | '30d' | '90d'>('30d')\n  const [selectedRecommendation, setSelectedRecommendation] = useState<Recommendation | null>(null)\n  const [showModal, setShowModal] = useState(false)\n\n  // Fetch ad accounts\n  useEffect(() => {\n    async function fetchAccounts() {\n      try {\n        const res = await fetch('/api/meta/accounts')\n        if (!res.ok) throw new Error('Failed to fetch accounts')\n        const data = await res.json()\n        if (data.accounts && data.accounts.length > 0) {\n          setAccounts(data.accounts)\n          setSelectedAccount(data.accounts[0])\n        }\n      } catch (err: any) {\n        setError(err.message)\n      }\n    }\n    fetchAccounts()\n  }, [])\n\n  // Fetch campaigns and metrics when account is selected\n  useEffect(() => {\n    if (!selectedAccount) return\n\n    async function fetchData() {\n      if (!selectedAccount) return\n\n      setLoading(true)\n      setError(null)\n      try {\n        const accountId = selectedAccount.id\n\n        // Fetch campaigns\n        const campaignsRes = await fetch(\n          `/api/meta/ads/campaigns?ad_account_id=${accountId}`\n        )\n        if (campaignsRes.ok) {\n          const campaignsData = await campaignsRes.json()\n          setCampaigns(campaignsData.campaigns || [])\n        }\n\n        // Fetch metrics\n        const daysBack = period === '7d' ? 7 : period === '30d' ? 30 : 90\n        const fromDate = new Date()\n        fromDate.setDate(fromDate.getDate() - daysBack)\n        const toDate = new Date()\n\n        const metricsRes = await fetch(\n          `/api/meta/metrics/fetch?account_id=${accountId}&from=${fromDate.toISOString()}&to=${toDate.toISOString()}`\n        )\n        if (metricsRes.ok) {\n          const metricsData = await metricsRes.json()\n          setMetrics(metricsData.summary)\n        }\n\n        // Fetch recommendations\n        const recsRes = await fetch(\n          `/api/recommendations/list?account_id=${accountId}`\n        )\n        if (recsRes.ok) {\n          const recsData = await recsRes.json()\n          setRecommendations(recsData.recommendations || [])\n        }\n\n        // Generate sample performance data for the chart\n        const daysBack = period === '7d' ? 7 : period === '30d' ? 30 : 90\n        const data: PerformanceData[] = []\n        for (let i = daysBack; i >= 0; i--) {\n          const date = new Date()\n          date.setDate(date.getDate() - i)\n          data.push({\n            date: date.toISOString().split('T')[0],\n            spend: Math.random() * 500 + 100,\n            conversions: Math.floor(Math.random() * 50 + 10),\n            impressions: Math.floor(Math.random() * 10000 + 5000),\n            clicks: Math.floor(Math.random() * 500 + 100),\n          })\n        }\n        setPerformanceData(data)\n      } catch (err: any) {\n        console.error('Error fetching data:', err)\n      } finally {\n        setLoading(false)\n      }\n    }\n\n    fetchData()\n  }, [selectedAccount, period])\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      {/* Header */}\n      <div className=\"bg-white border-b\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <h1 className=\"text-3xl font-bold text-gray-900\">Meta Ads Coach</h1>\n              <p className=\"text-gray-600 mt-1\">Performance insights & recommendations</p>\n            </div>\n            <div className=\"text-right\">\n              {selectedAccount && (\n                <div className=\"text-sm\">\n                  <p className=\"font-semibold\">{selectedAccount.name}</p>\n                  <p className=\"text-gray-600\">{selectedAccount.currency}</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {/* Account Selector & Controls */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\">\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Ad Account\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={selectedAccount?.id || ''}\n              onChange={(e) => {\n                const account = accounts.find((a) => a.id === e.target.value)\n                setSelectedAccount(account || null)\n              }}\n            >\n              <option value=\"\">Select account...</option>\n              {accounts.map((account) => (\n                <option key={account.id} value={account.id}>\n                  {account.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Time Period\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={period}\n              onChange={(e) => setPeriod(e.target.value as '7d' | '30d' | '90d')}\n            >\n              <option value=\"7d\">Last 7 days</option>\n              <option value=\"30d\">Last 30 days</option>\n              <option value=\"90d\">Last 90 days</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-end\">\n            {selectedAccount && (\n              <button\n                onClick={() => window.location.href = '/connect'}\n                className=\"w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n              >\n                Add Account\n              </button>\n            )}\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg\">\n            <p className=\"font-semibold\">Error</p>\n            <p className=\"text-sm\">{error}</p>\n          </div>\n        )}\n\n        {loading ? (\n          <div className=\"text-center py-12\">\n            <p className=\"text-gray-600\">Loading performance data...</p>\n          </div>\n        ) : selectedAccount ? (\n          <>\n            {/* Performance Summary Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n              {metrics && (\n                <>\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Spend</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          ${formatNumber(metrics.spend)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-blue-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Impressions</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {formatNumber(metrics.impressions)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-green-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">ROAS</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {metrics.roas.toFixed(2)}x\n                        </p>\n                      </div>\n                      <TrendingUp className=\"text-purple-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">CTR</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {(metrics.ctr * 100).toFixed(2)}%\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-orange-500\" size={32} />\n                    </div>\n                  </div>\n                </>\n              )}\n            </div>\n\n            {/* Campaigns Table */}\n            <div className=\"bg-white rounded-lg shadow mb-8\">\n              <div className=\"px-6 py-4 border-b\">\n                <h2 className=\"text-lg font-semibold\">Campaigns</h2>\n              </div>\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-gray-50 border-b\">\n                    <tr>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Name\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Status\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Objective\n                      </th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {campaigns.length > 0 ? (\n                      campaigns.slice(0, 10).map((campaign) => (\n                        <tr key={campaign.id} className=\"border-b hover:bg-gray-50\">\n                          <td className=\"px-6 py-4 text-sm text-gray-900\">\n                            {campaign.name}\n                          </td>\n                          <td className=\"px-6 py-4 text-sm\">\n                            <span\n                              className={`px-2 py-1 rounded text-xs font-medium ${\n                                campaign.status === 'ACTIVE'\n                                  ? 'bg-green-100 text-green-800'\n                                  : 'bg-gray-100 text-gray-800'\n                              }`}\n                            >\n                              {campaign.status}\n                            </span>\n                          </td>\n                          <td className=\"px-6 py-4 text-sm text-gray-600\">\n                            {campaign.objective || '—'}\n                          </td>\n                        </tr>\n                      ))\n                    ) : (\n                      <tr>\n                        <td colSpan={3} className=\"px-6 py-8 text-center text-gray-500\">\n                          No campaigns found\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n\n            {/* Recommendations */}\n            {recommendations.length > 0 && (\n              <div className=\"bg-white rounded-lg shadow\">\n                <div className=\"px-6 py-4 border-b\">\n                  <h2 className=\"text-lg font-semibold\">Recommendations</h2>\n                </div>\n                <div className=\"divide-y\">\n                  {recommendations.slice(0, 5).map((rec) => (\n                    <div\n                      key={rec.id}\n                      className=\"px-6 py-4 cursor-pointer hover:bg-gray-50 transition\"\n                      onClick={() => {\n                        setSelectedRecommendation(rec)\n                        setShowModal(true)\n                      }}\n                    >\n                      <div className=\"flex items-start gap-3\">\n                        <AlertCircle\n                          className={\n                            rec.priority === 'high'\n                              ? 'text-red-500'\n                              : rec.priority === 'medium'\n                                ? 'text-yellow-500'\n                                : 'text-blue-500'\n                          }\n                          size={20}\n                        />\n                        <div className=\"flex-1\">\n                          <p className=\"font-semibold text-gray-900\">{rec.title}</p>\n                          <p className=\"text-sm text-gray-600 mt-1\">\n                            {rec.description}\n                          </p>\n                          <div className=\"flex items-center gap-4 mt-2\">\n                            <span className=\"text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded\">\n                              Confidence: {(rec.confidence_score * 100).toFixed(0)}%\n                            </span>\n                            <span className=\"text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded\">\n                              Impact: {(rec.estimated_impact * 100).toFixed(0)}%\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {/* Recommendation Modal */}\n            <RecommendationModal\n              recommendation={selectedRecommendation}\n              isOpen={showModal}\n              onClose={() => setShowModal(false)}\n            />\n          </>\n        ) : (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Select an account to view performance data</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":233,"oldLines":6,"newStart":233,"newLines":7,"lines":["             {/* Performance Summary Cards */}","             <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">","               {metrics && (","+              {metrics && (","                 <>","                   <div className=\"bg-white rounded-lg shadow p-6\">","                     <div className=\"flex items-center justify-between\">"]}],"userModified":false,"replaceAll":false}}
