{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01JReJd929PrpCKK3gd7LZYb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UKUEnvFSjmFc1jbXahruKg","name":"mcp__supabase__apply_migration","input":{"name":"001_initial_schema","query":"\n-- Create users table (extends Supabase auth.users)\nCREATE TABLE IF NOT EXISTS users (\n  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,\n  email TEXT UNIQUE NOT NULL,\n  full_name TEXT,\n  company_name TEXT,\n  timezone TEXT DEFAULT 'UTC',\n  currency TEXT DEFAULT 'USD',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create meta_accounts table for linked Meta ad accounts\nCREATE TABLE IF NOT EXISTS meta_accounts (\n  id TEXT PRIMARY KEY,\n  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n  account_name TEXT NOT NULL,\n  account_currency TEXT,\n  account_timezone TEXT,\n  access_token TEXT,\n  token_expires_at TIMESTAMP WITH TIME ZONE,\n  is_active BOOLEAN DEFAULT TRUE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create campaigns table\nCREATE TABLE IF NOT EXISTS campaigns (\n  id TEXT PRIMARY KEY,\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  campaign_name TEXT NOT NULL,\n  campaign_status TEXT,\n  campaign_objective TEXT,\n  daily_budget DECIMAL(15, 2),\n  lifetime_budget DECIMAL(15, 2),\n  start_date DATE,\n  end_date DATE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ad_sets table\nCREATE TABLE IF NOT EXISTS ad_sets (\n  id TEXT PRIMARY KEY,\n  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  adset_name TEXT NOT NULL,\n  adset_status TEXT,\n  daily_budget DECIMAL(15, 2),\n  lifetime_budget DECIMAL(15, 2),\n  optimization_goal TEXT,\n  targeting JSONB,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ads table\nCREATE TABLE IF NOT EXISTS ads (\n  id TEXT PRIMARY KEY,\n  adset_id TEXT NOT NULL REFERENCES ad_sets(id) ON DELETE CASCADE,\n  ad_name TEXT NOT NULL,\n  ad_status TEXT,\n  creative_id TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ad_performance_metrics table\nCREATE TABLE IF NOT EXISTS ad_performance_metrics (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  ad_id TEXT NOT NULL REFERENCES ads(id) ON DELETE CASCADE,\n  date DATE NOT NULL,\n  impressions BIGINT DEFAULT 0,\n  clicks BIGINT DEFAULT 0,\n  spend DECIMAL(15, 4) DEFAULT 0,\n  actions BIGINT DEFAULT 0,\n  action_value DECIMAL(15, 4) DEFAULT 0,\n  ctr DECIMAL(8, 4),\n  cpc DECIMAL(15, 4),\n  cpa DECIMAL(15, 4),\n  roas DECIMAL(8, 4),\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE(ad_id, date)\n);\n\n-- Create recommendations table\nCREATE TABLE IF NOT EXISTS recommendations (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  recommendation_type TEXT NOT NULL,\n  title TEXT NOT NULL,\n  description TEXT,\n  confidence_score DECIMAL(5, 2),\n  estimated_impact DECIMAL(8, 2),\n  estimated_effort TEXT,\n  implementation_instructions TEXT,\n  is_implemented BOOLEAN DEFAULT FALSE,\n  implemented_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create reports table\nCREATE TABLE IF NOT EXISTS reports (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  report_title TEXT NOT NULL,\n  report_period_start DATE,\n  report_period_end DATE,\n  report_content JSONB,\n  pdf_url TEXT,\n  scheduled_delivery BOOLEAN DEFAULT FALSE,\n  delivery_frequency TEXT,\n  delivery_time TIME,\n  recipients TEXT[] DEFAULT '{}',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create alerts table\nCREATE TABLE IF NOT EXISTS alerts (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  alert_type TEXT NOT NULL,\n  severity TEXT DEFAULT 'info',\n  title TEXT NOT NULL,\n  description TEXT,\n  threshold_value DECIMAL(15, 4),\n  current_value DECIMAL(15, 4),\n  is_resolved BOOLEAN DEFAULT FALSE,\n  resolved_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create indexes for better query performance\nCREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\nCREATE INDEX IF NOT EXISTS idx_meta_accounts_user_id ON meta_accounts(user_id);\nCREATE INDEX IF NOT EXISTS idx_campaigns_meta_account_id ON campaigns(meta_account_id);\nCREATE INDEX IF NOT EXISTS idx_ad_sets_campaign_id ON ad_sets(campaign_id);\nCREATE INDEX IF NOT EXISTS idx_ads_adset_id ON ads(adset_id);\nCREATE INDEX IF NOT EXISTS idx_ad_performance_metrics_ad_id ON ad_performance_metrics(ad_id);\nCREATE INDEX IF NOT EXISTS idx_ad_performance_metrics_date ON ad_performance_metrics(date);\nCREATE INDEX IF NOT EXISTS idx_recommendations_campaign_id ON recommendations(campaign_id);\nCREATE INDEX IF NOT EXISTS idx_reports_meta_account_id ON reports(meta_account_id);\nCREATE INDEX IF NOT EXISTS idx_alerts_meta_account_id ON alerts(meta_account_id);\n\n-- Enable Row Level Security\nALTER TABLE users ENABLE ROW LEVEL SECURITY;\nALTER TABLE meta_accounts ENABLE ROW LEVEL SECURITY;\nALTER TABLE campaigns ENABLE ROW LEVEL SECURITY;\nALTER TABLE ad_sets ENABLE ROW LEVEL SECURITY;\nALTER TABLE ads ENABLE ROW LEVEL SECURITY;\nALTER TABLE ad_performance_metrics ENABLE ROW LEVEL SECURITY;\nALTER TABLE recommendations ENABLE ROW LEVEL SECURITY;\nALTER TABLE reports ENABLE ROW LEVEL SECURITY;\nALTER TABLE alerts ENABLE ROW LEVEL SECURITY;\n\n-- RLS Policies: Users can only see their own data\nCREATE POLICY \"Users can see own data\" ON users\n  FOR SELECT USING (auth.uid() = id);\n\nCREATE POLICY \"Users can update own data\" ON users\n  FOR UPDATE USING (auth.uid() = id);\n\nCREATE POLICY \"Users can see own meta accounts\" ON meta_accounts\n  FOR SELECT USING (user_id = auth.uid());\n\nCREATE POLICY \"Users can see own meta accounts (insert)\" ON meta_accounts\n  FOR INSERT WITH CHECK (user_id = auth.uid());\n\nCREATE POLICY \"Users can see related campaigns\" ON campaigns\n  FOR SELECT USING (\n    meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid())\n  );\n\nCREATE POLICY \"Users can see related ad_sets\" ON ad_sets\n  FOR SELECT USING (\n    campaign_id IN (SELECT id FROM campaigns WHERE meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid()))\n  );\n\nCREATE POLICY \"Users can see related ads\" ON ads\n  FOR SELECT USING (\n    adset_id IN (SELECT id FROM ad_sets WHERE campaign_id IN (SELECT id FROM campaigns WHERE meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid())))\n  );\n\nCREATE POLICY \"Users can see own metrics\" ON ad_performance_metrics\n  FOR SELECT USING (\n    ad_id IN (SELECT id FROM ads WHERE adset_id IN (SELECT id FROM ad_sets WHERE campaign_id IN (SELECT id FROM campaigns WHERE meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid()))))\n  );\n\nCREATE POLICY \"Users can see own recommendations\" ON recommendations\n  FOR SELECT USING (\n    campaign_id IN (SELECT id FROM campaigns WHERE meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid()))\n  );\n\nCREATE POLICY \"Users can see own reports\" ON reports\n  FOR SELECT USING (\n    meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid())\n  );\n\nCREATE POLICY \"Users can see own alerts\" ON alerts\n  FOR SELECT USING (\n    meta_account_id IN (SELECT id FROM meta_accounts WHERE user_id = auth.uid())\n  );\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":254,"cache_read_input_tokens":107773,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":254},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"16ef9659-252e-4d2e-bfb1-9e83e748844e"}
