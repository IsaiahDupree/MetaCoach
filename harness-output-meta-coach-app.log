{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0183HyAVSvKFuHfZ94yt2fMb","type":"tool_result","content":"The file /Users/isaiahdupree/Documents/Software/MetaCoach/__tests__/integration/database.test.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"8ce207b2-a38b-4ed6-bcb7-8d2673b8b1cc","tool_use_result":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/__tests__/integration/database.test.ts","oldString":"  describe('Query Performance', () => {\n    it('should handle queries with proper indexing', async () => {\n      const startTime = Date.now()\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: [], error: null }),\n          eq: jest.fn().mockReturnThis(),\n          gte: jest.fn().mockReturnThis(),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      await supabase.from('meta_ad_performance').select('*').gte('date', '2024-01-01')\n      const endTime = Date.now()\n\n      expect(endTime - startTime).toBeLessThan(1000)\n    })\n  })","newString":"  describe('Query Performance', () => {\n    it('should handle queries with proper indexing', async () => {\n      const startTime = Date.now()\n      const chainedMock = {\n        select: jest.fn().mockReturnValue({\n          gte: jest.fn().mockResolvedValue({ data: [], error: null }),\n        }),\n      }\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => chainedMock),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      await supabase.from('meta_ad_performance').select('*').gte('date', '2024-01-01')\n      const endTime = Date.now()\n\n      expect(endTime - startTime).toBeLessThan(1000)\n    })\n  })","originalFile":"import { supabaseAdmin } from '@/lib/supabase'\n\njest.mock('@/lib/supabase')\n\ndescribe('Database Integration Tests', () => {\n  const mockSupabase = supabaseAdmin as jest.MockedFunction<typeof supabaseAdmin>\n\n  beforeEach(() => {\n    jest.clearAllMocks()\n  })\n\n  describe('CRUD Operations', () => {\n    it('should create a user record', async () => {\n      const mockData = { id: 'user-1', email: 'test@example.com' }\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          insert: jest.fn().mockResolvedValue({ data: mockData, error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('users').insert([mockData])\n\n      expect(result.data).toEqual(mockData)\n      expect(result.error).toBeNull()\n    })\n\n    it('should read user records', async () => {\n      const mockData = [\n        { id: 'user-1', email: 'test1@example.com' },\n        { id: 'user-2', email: 'test2@example.com' },\n      ]\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: mockData, error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('users').select('*')\n\n      expect(result.data).toHaveLength(2)\n      expect(result.error).toBeNull()\n    })\n\n    it('should update a user record', async () => {\n      const mockData = { id: 'user-1', email: 'updated@example.com' }\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          update: jest.fn().mockResolvedValue({ data: mockData, error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('users').update({ email: 'updated@example.com' })\n\n      expect(result.data).toEqual(mockData)\n      expect(result.error).toBeNull()\n    })\n\n    it('should delete a user record', async () => {\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          delete: jest.fn().mockResolvedValue({ data: null, error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('users').delete()\n\n      expect(result.error).toBeNull()\n    })\n  })\n\n  describe('RLS Policies', () => {\n    it('should enforce RLS on sensitive tables', async () => {\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: null, error: { message: 'RLS policy error' } }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('meta_account_tokens').select('*')\n\n      expect(result.error).toBeDefined()\n    })\n  })\n\n  describe('Query Performance', () => {\n    it('should handle queries with proper indexing', async () => {\n      const startTime = Date.now()\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: [], error: null }),\n          eq: jest.fn().mockReturnThis(),\n          gte: jest.fn().mockReturnThis(),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      await supabase.from('meta_ad_performance').select('*').gte('date', '2024-01-01')\n      const endTime = Date.now()\n\n      expect(endTime - startTime).toBeLessThan(1000)\n    })\n  })\n\n  describe('Concurrent Access', () => {\n    it('should handle concurrent reads', async () => {\n      const mockData = { id: 'test-1' }\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: [mockData], error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const promises = Array(5)\n        .fill(null)\n        .map(() => supabase.from('users').select('*'))\n\n      const results = await Promise.all(promises)\n\n      results.forEach((result) => {\n        expect(result.error).toBeNull()\n        expect(result.data).toBeDefined()\n      })\n    })\n  })\n\n  describe('Relationships', () => {\n    it('should handle foreign key relationships', async () => {\n      const mockData = {\n        id: 'campaign-1',\n        meta_account_id: 'account-1',\n        meta_accounts: { id: 'account-1', name: 'Test Account' },\n      }\n\n      mockSupabase.mockReturnValue({\n        from: jest.fn(() => ({\n          select: jest.fn().mockResolvedValue({ data: [mockData], error: null }),\n        })),\n      } as any)\n\n      const supabase = supabaseAdmin()\n      const result = await supabase.from('meta_campaigns').select('*, meta_accounts(*)')\n\n      expect(result.data).toBeDefined()\n      if (result.data && result.data[0]) {\n        expect(result.data[0].meta_accounts).toBeDefined()\n      }\n    })\n  })\n})\n","structuredPatch":[{"oldStart":90,"oldLines":12,"newStart":90,"newLines":13,"lines":["   describe('Query Performance', () => {","     it('should handle queries with proper indexing', async () => {","       const startTime = Date.now()","+      const chainedMock = {","+        select: jest.fn().mockReturnValue({","+          gte: jest.fn().mockResolvedValue({ data: [], error: null }),","+        }),","+      }","       mockSupabase.mockReturnValue({","-        from: jest.fn(() => ({","-          select: jest.fn().mockResolvedValue({ data: [], error: null }),","-          eq: jest.fn().mockReturnThis(),","-          gte: jest.fn().mockReturnThis(),","-        })),","+        from: jest.fn(() => chainedMock),","       } as any)"," ","       const supabase = supabaseAdmin()"]}],"userModified":false,"replaceAll":false}}
