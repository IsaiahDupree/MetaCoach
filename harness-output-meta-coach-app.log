gine.scoreRecommendations(recommendations)\n      const highImpactScore = scored.find((r) => r.id === '1')?.score || 0\n      const lowImpactScore = scored.find((r) => r.id === '2')?.score || 0\n\n      expect(highImpactScore).toBeGreaterThan(lowImpactScore)\n    })\n  })\n\n  describe('generateRecommendations', () => {\n    it('should return an array of recommendations', async () => {\n      // Mock Supabase for this test\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(Array.isArray(recommendations)).toBe(true)\n    })\n\n    it('should include different recommendation types', async () => {\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      const types = recommendations.map((r) => r.type)\n      expect(types.length).toBeGreaterThanOrEqual(0)\n    })\n  })\n})\n","structuredPatch":[{"oldStart":1,"oldLines":204,"newStart":1,"newLines":149,"lines":["-import { RecommendationEngine } from '@/lib/recommendation-engine'","+import { RecommendationEngine, Recommendation } from '@/lib/recommendation-engine'"," ","-describe('RecommendationEngine', () => {","-  let engine: RecommendationEngine","+jest.mock('@/lib/supabase', () => ({","+  supabaseAdmin: jest.fn(() => ({","+    from: jest.fn(() => ({","+      select: jest.fn(() => Promise.resolve({ data: [], error: null })),","+      insert: jest.fn(() => Promise.resolve({ data: null, error: null })),","+    })),","+  })),","+}))"," ","-  beforeEach(() => 