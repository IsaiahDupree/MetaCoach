    try {\n        const igUserId = page.instagram_business_account.id\n        const res = await fetch(`/api/meta/media?ig_user_id=${igUserId}`)\n        if (!res.ok) throw new Error('Failed to fetch media')\n        const data = await res.json()\n        setMedia(data.media)\n      } catch (err: any) {\n        setError(err.message)\n      } finally {\n        setLoading(false)\n      }\n    }\n    fetchMedia(selectedPage)\n  }, [selectedPage])\n\n  if (error) {\n    return (\n      <div className=\"min-h-screen bg-gray-50 p-8\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"bg-red-50 border border-red-200 text-red-800 p-4 rounded\">\n            <p className=\"font-semibold\">Error</p>\n            <p className=\"text-sm\">{error}</p>\n          </div>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 p-8\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"mb-8\">\n          <h1 className=\"text-3xl font-bold\">Instagram Analytics</h1>\n          <p className=\"text-gray-600 mt-2\">\n            View your recent posts and engagement metrics\n          </p>\n        </div>\n\n        {/* Page Selector */}\n        {pages.length > 1 && (\n          <div className=\"mb-6 bg-white rounded-lg shadow p-4\">\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Select Facebook Page\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-md\"\n              value={selectedPage?.id || ''}\n              onChange={(e) => {\n                const page = pages.find((p) => p.id === e.target.value)\n                setSelectedPage(page || null)\n              }}\n            >\n              <option value=\"\">-- Select a page --</option>\n              {pages.map((page) => (\n                <option key={page.id} value={page.id}>\n                  {page.name}\n                </option>\n              ))}\n            </select>\n          </div>\n        )}\n\n        {/* Loading State */}\n        {loading && (\n          <div className=\"text-center py-12\">\n            <p className=\"text-gray-600\">Loading posts...</p>\n          </div>\n        )}\n\n        {/* Media Grid */}\n        {!loading && selectedPage && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {media.map((item) => (\n              <div\n                key={item.id}\n                className=\"bg-white rounded-lg shadow overflow-hidden\"\n              >\n                {/* Thumbnail */}\n                {(item.thumbnail_url || item.media_url) && (\n                  <div className=\"aspect-square bg-gray-100 relative\">\n                    <img\n                      src={item.thumbnail_url || item.media_url}\n                      alt={item.caption || 'Instagram post'}\n                      className=\"w-full h-full object-cover\"\n                    />\n                    <div className=\"absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n                      {item.media_type}\n                    </div>\n                  </div>\n                )}\n\n                {/* Content */}\n                <div className=\"p-4\">\n                  {/* Caption */}\n                  {item.caption && (\n                    <p className=\"text-sm text-gray-700 mb-3 line-clamp-3\">\n                      {item.caption}\n                    </p>\n                  )}\n\n                  {/* Metrics */}\n                  {item.insights && (\n                    <div className=\"grid grid-cols-2 gap-2 text-sm\">\n                      {item.insights.reach !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Reach:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.reach)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.likes !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Likes:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.likes)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.comments !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Comments:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.comments)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.saves !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Saves:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.saves)}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  )}\n\n                  {/* Timestamp */}\n                  <div className=\"mt-3 pt-3 border-t text-xs text-gray-500\">\n                    {new Date(item.timestamp).toLocaleDateString()}\n                  </div>\n\n                  {/* Link */}\n                  {item.permalink && (\n                    <a\n                      href={item.permalink}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"mt-2 block text-sm text-blue-600 hover:text-blue-800\"\n                    >\n                      View on Instagram →\n                    </a>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Empty State */}\n        {!loading && selectedPage && media.length === 0 && (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">No posts found</p>\n          </div>\n        )}\n\n        {/* No Page Selected */}\n        {!loading && !selectedPage && pages.length > 0 && (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Please select a Facebook page</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}","newString":"'use client'\n\nimport { useEffect, useState } from 'react'\nimport { BarChart3, TrendingUp, AlertCircle } from 'lucide-react'\nimport { formatNumber } from '@/lib/utils'\n\ninterface Account {\n  id: string\n  name: string\n  currency: string\n  balance?: number\n}\n\ninterface Campaign {\n  id: string\n  name: string\n  status: string\n  objective?: string\n}\n\ninterface MetricSummary {\n  spend: number\n  impressions: number\n  clicks: number\n  conversions: number\n  ctr: number\n  cpc: number\n  roas: number\n  trend?: {\n    spend: number\n    impressions: number\n    clicks: number\n  }\n}\n\ninterface Recommendation {\n  id: string\n  title: string\n  description: string\n  priority: 'high' | 'medium' | 'low'\n  confidence_score: number\n  estimated_impact: number\n}\n\nexport default function DashboardPage() {\n  const [accounts, setAccounts] = useState<Account[]>([])\n  const [selectedAccount, setSelectedAccount] = useState<Account | null>(null)\n  const [campaigns, setCampaigns] = useState<Campaign[]>([])\n  const [metrics, setMetrics] = useState<MetricSummary | null>(null)\n  const [recommendations, setRecommendations] = useState<Recommendation[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n  const [period, setPeriod] = useState<'7d' | '30d' | '90d'>('30d')\n\n  // Fetch ad accounts\n  useEffect(() => {\n    async function fetchAccounts() {\n      try {\n        const res = await fetch('/api/meta/accounts')\n        if (!res.ok) throw new Error('Failed to fetch accounts')\n        const data = await res.json()\n        if (data.accounts && data.accounts.length > 0) {\n          setAccounts(data.accounts)\n          setSelectedAccount(data.accounts[0])\n        }\n      } catch (err: any) {\n        setError(err.message)\n      }\n    }\n    fetchAccounts()\n  }, [])\n\n  // Fetch campaigns and metrics when account is selected\n  useEffect(() => {\n    if (!selectedAccount) return\n\n    async function fetchData() {\n      setLoading(true)\n      setError(null)\n      try {\n        // Fetch campaigns\n        const campaignsRes = await fetch(\n          `/api/meta/ads/campaigns?ad_account_id=${selectedAccount.id}`\n        )\n        if (campaignsRes.ok) {\n          const campaignsData = await campaignsRes.json()\n          setCampaigns(campaignsData.campaigns || [])\n        }\n\n        // Fetch metrics\n        const daysBack = period === '7d' ? 7 : period === '30d' ? 30 : 90\n        const fromDate = new Date()\n        fromDate.setDate(fromDate.getDate() - daysBack)\n        const toDate = new Date()\n\n        const metricsRes = await fetch(\n          `/api/meta/metrics/fetch?account_id=${selectedAccount.id}&from=${fromDate.toISOString()}&to=${toDate.toISOString()}`\n        )\n        if (metricsRes.ok) {\n          const metricsData = await metricsRes.json()\n          setMetrics(metricsData.summary)\n        }\n\n        // Fetch recommendations\n        const recsRes = await fetch(\n          `/api/recommendations/list?account_id=${selectedAccount.id}`\n        )\n        if (recsRes.ok) {\n          const recsData = await recsRes.json()\n          setRecommendations(recsData.recommendations || [])\n        }\n      } catch (err: any) {\n        console.error('Error fetching data:', err)\n      } finally {\n        setLoading(false)\n      }\n    }\n\n    fetchData()\n  }, [selectedAccount, period])\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      {/* Header */}\n      <div className=\"bg-white border-b\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <h1 className=\"text-3xl font-bold text-gray-900\">Meta Ads Coach</h1>\n              <p className=\"text-gray-600 mt-1\">Performance insights & recommendations</p>\n            </div>\n            <div className=\"text-right\">\n              {selectedAccount && (\n                <div className=\"text-sm\">\n                  <p className=\"font-semibold\">{selectedAccount.name}</p>\n                  <p className=\"text-gray-600\">{selectedAccount.currency}</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {/* Account Selector & Controls */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\">\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Ad Account\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={selectedAccount?.id || ''}\n              onChange={(e) => {\n                const account = accounts.find((a) => a.id === e.target.value)\n                setSelectedAccount(account || null)\n              }}\n            >\n              <option value=\"\">Select account...</option>\n              {accounts.map((account) => (\n                <option key={account.id} value={account.id}>\n                  {account.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Time Period\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={period}\n              onChange={(e) => setPeriod(e.target.value as '7d' | '30d' | '90d')}\n            >\n              <option value=\"7d\">Last 7 days</option>\n              <option value=\"30d\">Last 30 days</option>\n              <option value=\"90d\">Last 90 days</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-end\">\n            {selectedAccount && (\n              <button\n                onClick={() => window.location.href = '/connect'}\n                className=\"w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n              >\n                Add Account\n              </button>\n            )}\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg\">\n            <p className=\"font-semibold\">Error</p>\n            <p className=\"text-sm\">{error}</p>\n          </div>\n        )}\n\n        {loading ? (\n          <div className=\"text-center py-12\">\n            <p className=\"text-gray-600\">Loading performance data...</p>\n          </div>\n        ) : selectedAccount ? (\n          <>\n            {/* Performance Summary Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n              {metrics && (\n                <>\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Spend</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          ${formatNumber(metrics.spend)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-blue-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Impressions</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {formatNumber(metrics.impressions)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-green-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">ROAS</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {metrics.roas.toFixed(2)}x\n                        </p>\n                      </div>\n                      <TrendingUp className=\"text-purple-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">CTR</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {(metrics.ctr * 100).toFixed(2)}%\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-orange-500\" size={32} />\n                    </div>\n                  </div>\n                </>\n              )}\n            </div>\n\n            {/* Campaigns Table */}\n            <div className=\"bg-white rounded-lg shadow mb-8\">\n              <div className=\"px-6 py-4 border-b\">\n                <h2 className=\"text-lg font-semibold\">Campaigns</h2>\n              </div>\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-gray-50 border-b\">\n                    <tr>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Name\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Status\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Objective\n                      </th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {campaigns.length > 0 ? (\n                      campaigns.slice(0, 10).map((campaign) => (\n                        <tr key={campaign.id} className=\"border-b hover:bg-gray-50\">\n                          <td className=\"px-6 py-4 text-sm text-gray-900\">\n                            {campaign.name}\n                          </td>\n                          <td className=\"px-6 py-4 text-sm\">\n                            <span\n                              className={`px-2 py-1 rounded text-xs font-medium ${\n                                campaign.status === 'ACTIVE'\n                                  ? 'bg-green-100 text-green-800'\n                                  : 'bg-gray-100 text-gray-800'\n                              }`}\n                            >\n                              {campaign.status}\n                            </span>\n                          </td>\n                          <td className=\"px-6 py-4 text-sm text-gray-600\">\n                            {campaign.objective || '—'}\n                          </td>\n                        </tr>\n                      ))\n                    ) : (\n                      <tr>\n                        <td colSpan={3} className=\"px-6 py-8 text-center text-gray-500\">\n                          No campaigns found\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n\n            {/* Recommendations */}\n            {recommendations.length > 0 && (\n              <div className=\"bg-white rounded-lg shadow\">\n                <div className=\"px-6 py-4 border-b\">\n                  <h2 className=\"text-lg font-semibold\">Recommendations</h2>\n                </div>\n                <div className=\"divide-y\">\n                  {recommendations.slice(0, 5).map((rec) => (\n                    <div key={rec.id} className=\"px-6 py-4\">\n                      <div className=\"flex items-start gap-3\">\n                        <AlertCircle\n                          className={\n                            rec.priority === 'high'\n                              ? 'text-red-500'\n                              : rec.priority === 'medium'\n                                ? 'text-yellow-500'\n                                : 'text-blue-500'\n                          }\n                          size={20}\n                        />\n                        <div className=\"flex-1\">\n                          <p className=\"font-semibold text-gray-900\">{rec.title}</p>\n                          <p className=\"text-sm text-gray-600 mt-1\">\n                            {rec.description}\n                          </p>\n                          <div className=\"flex items-center gap-4 mt-2\">\n                            <span className=\"text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded\">\n                              Confidence: {(rec.confidence_score * 100).toFixed(0)}%\n                            </span>\n                            <span className=\"text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded\">\n                              Impact: {(rec.estimated_impact * 100).toFixed(0)}%\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n          </>\n        ) : (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Select an account to view performance data</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}","originalFile":"'use client'\n\nimport { useEffect, useState } from 'react'\nimport { formatNumber } from '@/lib/utils'\n\ninterface Page {\n  id: string\n  name: string\n  instagram_business_account: {\n    id: string\n  }\n}\n\ninterface MediaItem {\n  id: string\n  caption?: string\n  media_type: string\n  media_url?: string\n  thumbnail_url?: string\n  permalink?: string\n  timestamp: string\n  insights?: {\n    reach?: number\n    likes?: number\n    comments?: number\n    shares?: number\n    saves?: number\n  }\n}\n\nexport default function DashboardPage() {\n  const [pages, setPages] = useState<Page[]>([])\n  const [selectedPage, setSelectedPage] = useState<Page | null>(null)\n  const [media, setMedia] = useState<MediaItem[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n\n  // Fetch user's Facebook pages\n  useEffect(() => {\n    async function fetchPages() {\n      try {\n        const res = await fetch('/api/meta/me')\n        if (!res.ok) throw new Error('Failed to fetch pages')\n        const data = await res.json()\n        setPages(data.pages)\n        if (data.pages.length === 1) {\n          setSelectedPage(data.pages[0])\n        }\n      } catch (err: any) {\n        setError(err.message)\n      }\n    }\n    fetchPages()\n  }, [])\n\n  // Fetch media when page is selected\n  useEffect(() => {\n    if (!selectedPage) return\n\n    async function fetchMedia(page: Page) {\n      setLoading(true)\n      setError(null)\n      try {\n        const igUserId = page.instagram_business_account.id\n        const res = await fetch(`/api/meta/media?ig_user_id=${igUserId}`)\n        if (!res.ok) throw new Error('Failed to fetch media')\n        const data = await res.json()\n        setMedia(data.media)\n      } catch (err: any) {\n        setError(err.message)\n      } finally {\n        setLoading(false)\n      }\n    }\n    fetchMedia(selectedPage)\n  }, [selectedPage])\n\n  if (error) {\n    return (\n      <div className=\"min-h-screen bg-gray-50 p-8\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"bg-red-50 border border-red-200 text-red-800 p-4 rounded\">\n            <p className=\"font-semibold\">Error</p>\n            <p className=\"text-sm\">{error}</p>\n          </div>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 p-8\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"mb-8\">\n          <h1 className=\"text-3xl font-bold\">Instagram Analytics</h1>\n          <p className=\"text-gray-600 mt-2\">\n            View your recent posts and engagement metrics\n          </p>\n        </div>\n\n        {/* Page Selector */}\n        {pages.length > 1 && (\n          <div className=\"mb-6 bg-white rounded-lg shadow p-4\">\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Select Facebook Page\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-md\"\n              value={selectedPage?.id || ''}\n              onChange={(e) => {\n                const page = pages.find((p) => p.id === e.target.value)\n                setSelectedPage(page || null)\n              }}\n            >\n              <option value=\"\">-- Select a page --</option>\n              {pages.map((page) => (\n                <option key={page.id} value={page.id}>\n                  {page.name}\n                </option>\n              ))}\n            </select>\n          </div>\n        )}\n\n        {/* Loading State */}\n        {loading && (\n          <div className=\"text-center py-12\">\n            <p className=\"text-gray-600\">Loading posts...</p>\n          </div>\n        )}\n\n        {/* Media Grid */}\n        {!loading && selectedPage && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {media.map((item) => (\n              <div\n                key={item.id}\n                className=\"bg-white rounded-lg shadow overflow-hidden\"\n              >\n                {/* Thumbnail */}\n                {(item.thumbnail_url || item.media_url) && (\n                  <div className=\"aspect-square bg-gray-100 relative\">\n                    <img\n                      src={item.thumbnail_url || item.media_url}\n                      alt={item.caption || 'Instagram post'}\n                      className=\"w-full h-full object-cover\"\n                    />\n                    <div className=\"absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n                      {item.media_type}\n                    </div>\n                  </div>\n                )}\n\n                {/* Content */}\n                <div className=\"p-4\">\n                  {/* Caption */}\n                  {item.caption && (\n                    <p className=\"text-sm text-gray-700 mb-3 line-clamp-3\">\n                      {item.caption}\n                    </p>\n                  )}\n\n                  {/* Metrics */}\n                  {item.insights && (\n                    <div className=\"grid grid-cols-2 gap-2 text-sm\">\n                      {item.insights.reach !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Reach:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.reach)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.likes !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Likes:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.likes)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.comments !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Comments:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.comments)}\n                          </span>\n                        </div>\n                      )}\n                      {item.insights.saves !== undefined && (\n                        <div>\n                          <span className=\"text-gray-500\">Saves:</span>{' '}\n                          <span className=\"font-semibold\">\n                            {formatNumber(item.insights.saves)}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  )}\n\n                  {/* Timestamp */}\n                  <div className=\"mt-3 pt-3 border-t text-xs text-gray-500\">\n                    {new Date(item.timestamp).toLocaleDateString()}\n                  </div>\n\n                  {/* Link */}\n                  {item.permalink && (\n                    <a\n                      href={item.permalink}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"mt-2 block text-sm text-blue-600 hover:text-blue-800\"\n                    >\n                      View on Instagram →\n                    </a>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Empty State */}\n        {!loading && selectedPage && media.length === 0 && (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">No posts found</p>\n          </div>\n        )}\n\n        {/* No Page Selected */}\n        {!loading && !selectedPage && pages.length > 0 && (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Please select a Facebook page</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":1,"oldLines":238,"newStart":1,"newLines":366,"lines":[" 'use client'"," "," import { useEffect, useState } from 'react'","+import { BarChart3, TrendingUp, AlertCircle } from 'lucide-react'"," import { formatNumber } from '@/lib/utils'"," ","-interface Page {","+interface Account {","   id: string","   name: string","-  instagram_business_account: {","-    id: string","-  }","+  currency: string","+  balance?: number"," }"," ","-interface MediaItem {","+interface Campaign {","   id: string","-  caption?: string","-  media_type: string","-  media_url?: string","-  thumbnail_url?: string","-  permalink?: string","-  timestamp: string","-  insights?: {","-    reach?: number","-    likes?: number","-    comments?: number","-    shares?: number","-    saves?: number","+  name: string","+  status: string","+  objective?: string","+}","+","+interface MetricSummary {","+  spend: number","+  impressions: number","