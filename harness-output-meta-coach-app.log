{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fj2JNCNK6dMHG8jeSsid17","type":"tool_result","content":"     1→'use client'\n     2→\n     3→import { useEffect, useState } from 'react'\n     4→import { BarChart3, TrendingUp, AlertCircle } from 'lucide-react'\n     5→import { formatNumber } from '@/lib/utils'\n     6→import { RecommendationModal } from '@/components/RecommendationModal'\n     7→import { PerformanceChart, type PerformanceData } from '@/components/PerformanceChart'\n     8→\n     9→interface Account {\n    10→  id: string\n    11→  name: string\n    12→  currency: string\n    13→  balance?: number\n    14→}\n    15→\n    16→interface Campaign {\n    17→  id: string\n    18→  name: string\n    19→  status: string\n    20→  objective?: string\n    21→}\n    22→\n    23→interface MetricSummary {\n    24→  spend: number\n    25→  impressions: number\n    26→  clicks: number\n    27→  conversions: number\n    28→  ctr: number\n    29→  cpc: number\n    30→  roas: number\n    31→  trend?: {\n    32→    spend: number\n    33→    impressions: number\n    34→    clicks: number\n    35→  }\n    36→}\n    37→\n    38→interface Recommendation {\n    39→  id: string\n    40→  title: string\n    41→  description: string\n    42→  priority: 'high' | 'medium' | 'low'\n    43→  confidence_score: number\n    44→  estimated_impact: number\n    45→}\n    46→\n    47→export default function DashboardPage() {\n    48→  const [accounts, setAccounts] = useState<Account[]>([])\n    49→  const [selectedAccount, setSelectedAccount] = useState<Account | null>(null)\n    50→  const [campaigns, setCampaigns] = useState<Campaign[]>([])\n    51→  const [metrics, setMetrics] = useState<MetricSummary | null>(null)\n    52→  const [recommendations, setRecommendations] = useState<Recommendation[]>([])\n    53→  const [performanceData, setPerformanceData] = useState<PerformanceData[]>([])\n    54→  const [loading, setLoading] = useState(false)\n    55→  const [error, setError] = useState<string | null>(null)\n    56→  const [period, setPeriod] = useState<'7d' | '30d' | '90d'>('30d')\n    57→  const [selectedRecommendation, setSelectedRecommendation] = useState<Recommendation | null>(null)\n    58→  const [showModal, setShowModal] = useState(false)\n    59→\n    60→  // Fetch ad accounts\n    61→  useEffect(() => {\n    62→    async function fetchAccounts() {\n    63→      try {\n    64→        const res = await fetch('/api/meta/accounts')\n    65→        if (!res.ok) throw new Error('Failed to fetch accounts')\n    66→        const data = await res.json()\n    67→        if (data.accounts && data.accounts.length > 0) {\n    68→          setAccounts(data.accounts)\n    69→          setSelectedAccount(data.accounts[0])\n    70→        }\n    71→      } catch (err: any) {\n    72→        setError(err.message)\n    73→      }\n    74→    }\n    75→    fetchAccounts()\n    76→  }, [])\n    77→\n    78→  // Fetch campaigns and metrics when account is selected\n    79→  useEffect(() => {\n    80→    if (!selectedAccount) return\n    81→\n    82→    async function fetchData() {\n    83→      if (!selectedAccount) return\n    84→\n    85→      setLoading(true)\n    86→      setError(null)\n    87→      try {\n    88→        const accountId = selectedAccount.id\n    89→\n    90→        // Fetch campaigns\n    91→        const campaignsRes = await fetch(\n    92→          `/api/meta/ads/campaigns?ad_account_id=${accountId}`\n    93→        )\n    94→        if (campaignsRes.ok) {\n    95→          const campaignsData = await campaignsRes.json()\n    96→          setCampaigns(campaignsData.campaigns || [])\n    97→        }\n    98→\n    99→        // Fetch metrics\n   100→        const daysBack = period === '7d' ? 7 : period === '30d' ? 30 : 90\n   101→        const fromDate = new Date()\n   102→        fromDate.setDate(fromDate.getDate() - daysBack)\n   103→        const toDate = new Date()\n   104→\n   105→        const metricsRes = await fetch(\n   106→          `/api/meta/metrics/fetch?account_id=${accountId}&from=${fromDate.toISOString()}&to=${toDate.toISOString()}`\n   107→        )\n   108→        if (metricsRes.ok) {\n   109→          const metricsData = await metricsRes.json()\n   110→          setMetrics(metricsData.summary)\n   111→        }\n   112→\n   113→        // Fetch recommendations\n   114→        const recsRes = await fetch(\n   115→          `/api/recommendations/list?account_id=${accountId}`\n   116→        )\n   117→        if (recsRes.ok) {\n   118→          const recsData = await recsRes.json()\n   119→          setRecommendations(recsData.recommendations || [])\n   120→        }\n   121→\n   122→        // Generate sample performance data for the chart\n   123→        const data: PerformanceData[] = []\n   124→        for (let i = daysBack; i >= 0; i--) {\n   125→          const date = new Date()\n   126→          date.setDate(date.getDate() - i)\n   127→          data.push({\n   128→            date: date.toISOString().split('T')[0],\n   129→            spend: Math.random() * 500 + 100,\n   130→            conversions: Math.floor(Math.random() * 50 + 10),\n   131→            impressions: Math.floor(Math.random() * 10000 + 5000),\n   132→            clicks: Math.floor(Math.random() * 500 + 100),\n   133→          })\n   134→        }\n   135→        setPerformanceData(data)\n   136→      } catch (err: any) {\n   137→        console.error('Error fetching data:', err)\n   138→      } finally {\n   139→        setLoading(false)\n   140→      }\n   141→    }\n   142→\n   143→    fetchData()\n   144→  }, [selectedAccount, period])\n   145→\n   146→  return (\n   147→    <div className=\"min-h-screen bg-gray-50\">\n   148→      {/* Header */}\n   149→      <div className=\"bg-white border-b\">\n   150→        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n   151→          <div className=\"flex items-center justify-between\">\n   152→            <div>\n   153→              <h1 className=\"text-3xl font-bold text-gray-900\">Meta Ads Coach</h1>\n   154→              <p className=\"text-gray-600 mt-1\">Performance insights & recommendations</p>\n   155→            </div>\n   156→            <div className=\"text-right\">\n   157→              {selectedAccount && (\n   158→                <div className=\"text-sm\">\n   159→                  <p className=\"font-semibold\">{selectedAccount.name}</p>\n   160→                  <p className=\"text-gray-600\">{selectedAccount.currency}</p>\n   161→                </div>\n   162→              )}\n   163→            </div>\n   164→          </div>\n   165→        </div>\n   166→      </div>\n   167→\n   168→      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n   169→        {/* Account Selector & Controls */}\n   170→        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\">\n   171→          <div>\n   172→            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n   173→              Ad Account\n   174→            </label>\n   175→            <select\n   176→              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n   177→              value={selectedAccount?.id || ''}\n   178→              onChange={(e) => {\n   179→                const account = accounts.find((a) => a.id === e.target.value)\n   180→                setSelectedAccount(account || null)\n   181→              }}\n   182→            >\n   183→              <option value=\"\">Select account...</option>\n   184→              {accounts.map((account) => (\n   185→                <option key={account.id} value={account.id}>\n   186→                  {account.name}\n   187→                </option>\n   188→              ))}\n   189→            </select>\n   190→          </div>\n   191→\n   192→          <div>\n   193→            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n   194→              Time Period\n   195→            </label>\n   196→            <select\n   197→              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n   198→              value={period}\n   199→              onChange={(e) => setPeriod(e.target.value as '7d' | '30d' | '90d')}\n   200→            >\n   201→              <option value=\"7d\">Last 7 days</option>\n   202→              <option value=\"30d\">Last 30 days</option>\n   203→              <option value=\"90d\">Last 90 days</option>\n   204→            </select>\n   205→          </div>\n   206→\n   207→          <div className=\"flex items-end\">\n   208→            {selectedAccount && (\n   209→              <button\n   210→                onClick={() => window.location.href = '/connect'}\n   211→                className=\"w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n   212→              >\n   213→                Add Account\n   214→              </button>\n   215→            )}\n   216→          </div>\n   217→        </div>\n   218→\n   219→        {error && (\n   220→          <div className=\"mb-6 bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg\">\n   221→            <p className=\"font-semibold\">Error</p>\n   222→            <p className=\"text-sm\">{error}</p>\n   223→          </div>\n   224→        )}\n   225→\n   226→        {loading ? (\n   227→          <div className=\"text-center py-12\">\n   228→            <p className=\"text-gray-600\">Loading performance data...</p>\n   229→          </div>\n   230→        ) : selectedAccount ? (\n   231→          <>\n   232→            {/* Performance Summary Cards */}\n   233→            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n   234→              {metrics && (\n   235→                <>\n   236→                  <div className=\"bg-white rounded-lg shadow p-6\">\n   237→                    <div className=\"flex items-center justify-between\">\n   238→                      <div>\n   239→                        <p className=\"text-gray-600 text-sm\">Spend</p>\n   240→                        <p className=\"text-2xl font-bold text-gray-900\">\n   241→                          ${formatNumber(metrics.spend)}\n   242→                        </p>\n   243→                      </div>\n   244→                      <BarChart3 className=\"text-blue-500\" size={32} />\n   245→                    </div>\n   246→                  </div>\n   247→\n   248→                  <div className=\"bg-white rounded-lg shadow p-6\">\n   249→                    <div className=\"flex items-center justify-between\">\n   250→                      <div>\n   251→                        <p className=\"text-gray-600 text-sm\">Impressions</p>\n   252→                        <p className=\"text-2xl font-bold text-gray-900\">\n   253→                          {formatNumber(metrics.impressions)}\n   254→                        </p>\n   255→                      </div>\n   256→                      <BarChart3 className=\"text-green-500\" size={32} />\n   257→                    </div>\n   258→                  </div>\n   259→\n   260→                  <div className=\"bg-white rounded-lg shadow p-6\">\n   261→                    <div className=\"flex items-center justify-between\">\n   262→                      <div>\n   263→                        <p className=\"text-gray-600 text-sm\">ROAS</p>\n   264→                        <p className=\"text-2xl font-bold text-gray-900\">\n   265→                          {metrics.roas.toFixed(2)}x\n   266→                        </p>\n   267→                      </div>\n   268→                      <TrendingUp className=\"text-purple-500\" size={32} />\n   269→                    </div>\n   270→                  </div>\n   271→\n   272→                  <div className=\"bg-white rounded-lg shadow p-6\">\n   273→                    <div className=\"flex items-center justify-between\">\n   274→                      <div>\n   275→                        <p className=\"text-gray-600 text-sm\">CTR</p>\n   276→                        <p className=\"text-2xl font-bold text-gray-900\">\n   277→                          {(metrics.ctr * 100).toFixed(2)}%\n   278→                        </p>\n   279→                      </div>\n   280→                      <BarChart3 className=\"text-orange-500\" size={32} />\n   281→                    </div>\n   282→                  </div>\n   283→                </>\n   284→              )}\n   285→            </div>\n   286→\n   287→            {/* Performance Chart */}\n   288→            {performanceData.length > 0 && (\n   289→              <div className=\"mb-8\">\n   290→                <PerformanceChart\n   291→                  data={performanceData}\n   292→                  timeframe={period}\n   293→                  onTimeframeChange={setPeriod}\n   294→                />\n   295→              </div>\n   296→            )}\n   297→\n   298→            {/* Campaigns Table */}\n   299→            <div className=\"bg-white rounded-lg shadow mb-8\">\n   300→              <div className=\"px-6 py-4 border-b\">\n   301→                <h2 className=\"text-lg font-semibold\">Campaigns</h2>\n   302→              </div>\n   303→              <div className=\"overflow-x-auto\">\n   304→                <table className=\"w-full\">\n   305→                  <thead className=\"bg-gray-50 border-b\">\n   306→                    <tr>\n   307→                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n   308→                        Name\n   309→                      </th>\n   310→                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n   311→                        Status\n   312→                      </th>\n   313→                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n   314→                        Objective\n   315→                      </th>\n   316→                    </tr>\n   317→                  </thead>\n   318→                  <tbody>\n   319→                    {campaigns.length > 0 ? (\n   320→                      campaigns.slice(0, 10).map((campaign) => (\n   321→                        <tr key={campaign.id} className=\"border-b hover:bg-gray-50\">\n   322→                          <td className=\"px-6 py-4 text-sm text-gray-900\">\n   323→                            {campaign.name}\n   324→                          </td>\n   325→                          <td className=\"px-6 py-4 text-sm\">\n   326→                            <span\n   327→                              className={`px-2 py-1 rounded text-xs font-medium ${\n   328→                                campaign.status === 'ACTIVE'\n   329→                                  ? 'bg-green-100 text-green-800'\n   330→                                  : 'bg-gray-100 text-gray-800'\n   331→                              }`}\n   332→                            >\n   333→                              {campaign.status}\n   334→                            </span>\n   335→                          </td>\n   336→                          <td className=\"px-6 py-4 text-sm text-gray-600\">\n   337→                            {campaign.objective || '—'}\n   338→                          </td>\n   339→                        </tr>\n   340→                      ))\n   341→                    ) : (\n   342→                      <tr>\n   343→                        <td colSpan={3} className=\"px-6 py-8 text-center text-gray-500\">\n   344→                          No campaigns found\n   345→                        </td>\n   346→                      </tr>\n   347→                    )}\n   348→                  </tbody>\n   349→                </table>\n   350→              </div>\n   351→            </div>\n   352→\n   353→            {/* Recommendations */}\n   354→            {recommendations.length > 0 && (\n   355→              <div className=\"bg-white rounded-lg shadow\">\n   356→                <div className=\"px-6 py-4 border-b\">\n   357→                  <h2 className=\"text-lg font-semibold\">Recommendations</h2>\n   358→                </div>\n   359→                <div className=\"divide-y\">\n   360→                  {recommendations.slice(0, 5).map((rec) => (\n   361→                    <div\n   362→                      key={rec.id}\n   363→                      className=\"px-6 py-4 cursor-pointer hover:bg-gray-50 transition\"\n   364→                      onClick={() => {\n   365→                        setSelectedRecommendation(rec)\n   366→                        setShowModal(true)\n   367→                      }}\n   368→                    >\n   369→                      <div className=\"flex items-start gap-3\">\n   370→                        <AlertCircle\n   371→                          className={\n   372→                            rec.priority === 'high'\n   373→                              ? 'text-red-500'\n   374→                              : rec.priority === 'medium'\n   375→                                ? 'text-yellow-500'\n   376→                                : 'text-blue-500'\n   377→                          }\n   378→                          size={20}\n   379→                        />\n   380→                        <div className=\"flex-1\">\n   381→                          <p className=\"font-semibold text-gray-900\">{rec.title}</p>\n   382→                          <p className=\"text-sm text-gray-600 mt-1\">\n   383→                            {rec.description}\n   384→                          </p>\n   385→                          <div className=\"flex items-center gap-4 mt-2\">\n   386→                            <span className=\"text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded\">\n   387→                              Confidence: {(rec.confidence_score * 100).toFixed(0)}%\n   388→                            </span>\n   389→                            <span className=\"text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded\">\n   390→                              Impact: {(rec.estimated_impact * 100).toFixed(0)}%\n   391→                            </span>\n   392→                          </div>\n   393→                        </div>\n   394→                      </div>\n   395→                    </div>\n   396→                  ))}\n   397→                </div>\n   398→              </div>\n   399→            )}\n   400→\n   401→            {/* Recommendation Modal */}\n   402→            <RecommendationModal\n   403→              recommendation={selectedRecommendation}\n   404→              isOpen={showModal}\n   405→              onClose={() => setShowModal(false)}\n   406→            />\n   407→          </>\n   408→        ) : (\n   409→          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n   410→            <p className=\"text-gray-600\">Select an account to view performance data</p>\n   411→          </div>\n   412→        )}\n   413→      </div>\n   414→    </div>\n   415→  )\n   416→}\n   417→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"3597755f-45a0-4b2c-8343-2f5f0668fbca","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/dashboard/page.tsx","content":"'use client'\n\nimport { useEffect, useState } from 'react'\nimport { BarChart3, TrendingUp, AlertCircle } from 'lucide-react'\nimport { formatNumber } from '@/lib/utils'\nimport { RecommendationModal } from '@/components/RecommendationModal'\nimport { PerformanceChart, type PerformanceData } from '@/components/PerformanceChart'\n\ninterface Account {\n  id: string\n  name: string\n  currency: string\n  balance?: number\n}\n\ninterface Campaign {\n  id: string\n  name: string\n  status: string\n  objective?: string\n}\n\ninterface MetricSummary {\n  spend: number\n  impressions: number\n  clicks: number\n  conversions: number\n  ctr: number\n  cpc: number\n  roas: number\n  trend?: {\n    spend: number\n    impressions: number\n    clicks: number\n  }\n}\n\ninterface Recommendation {\n  id: string\n  title: string\n  description: string\n  priority: 'high' | 'medium' | 'low'\n  confidence_score: number\n  estimated_impact: number\n}\n\nexport default function DashboardPage() {\n  const [accounts, setAccounts] = useState<Account[]>([])\n  const [selectedAccount, setSelectedAccount] = useState<Account | null>(null)\n  const [campaigns, setCampaigns] = useState<Campaign[]>([])\n  const [metrics, setMetrics] = useState<MetricSummary | null>(null)\n  const [recommendations, setRecommendations] = useState<Recommendation[]>([])\n  const [performanceData, setPerformanceData] = useState<PerformanceData[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n  const [period, setPeriod] = useState<'7d' | '30d' | '90d'>('30d')\n  const [selectedRecommendation, setSelectedRecommendation] = useState<Recommendation | null>(null)\n  const [showModal, setShowModal] = useState(false)\n\n  // Fetch ad accounts\n  useEffect(() => {\n    async function fetchAccounts() {\n      try {\n        const res = await fetch('/api/meta/accounts')\n        if (!res.ok) throw new Error('Failed to fetch accounts')\n        const data = await res.json()\n        if (data.accounts && data.accounts.length > 0) {\n          setAccounts(data.accounts)\n          setSelectedAccount(data.accounts[0])\n        }\n      } catch (err: any) {\n        setError(err.message)\n      }\n    }\n    fetchAccounts()\n  }, [])\n\n  // Fetch campaigns and metrics when account is selected\n  useEffect(() => {\n    if (!selectedAccount) return\n\n    async function fetchData() {\n      if (!selectedAccount) return\n\n      setLoading(true)\n      setError(null)\n      try {\n        const accountId = selectedAccount.id\n\n        // Fetch campaigns\n        const campaignsRes = await fetch(\n          `/api/meta/ads/campaigns?ad_account_id=${accountId}`\n        )\n        if (campaignsRes.ok) {\n          const campaignsData = await campaignsRes.json()\n          setCampaigns(campaignsData.campaigns || [])\n        }\n\n        // Fetch metrics\n        const daysBack = period === '7d' ? 7 : period === '30d' ? 30 : 90\n        const fromDate = new Date()\n        fromDate.setDate(fromDate.getDate() - daysBack)\n        const toDate = new Date()\n\n        const metricsRes = await fetch(\n          `/api/meta/metrics/fetch?account_id=${accountId}&from=${fromDate.toISOString()}&to=${toDate.toISOString()}`\n        )\n        if (metricsRes.ok) {\n          const metricsData = await metricsRes.json()\n          setMetrics(metricsData.summary)\n        }\n\n        // Fetch recommendations\n        const recsRes = await fetch(\n          `/api/recommendations/list?account_id=${accountId}`\n        )\n        if (recsRes.ok) {\n          const recsData = await recsRes.json()\n          setRecommendations(recsData.recommendations || [])\n        }\n\n        // Generate sample performance data for the chart\n        const data: PerformanceData[] = []\n        for (let i = daysBack; i >= 0; i--) {\n          const date = new Date()\n          date.setDate(date.getDate() - i)\n          data.push({\n            date: date.toISOString().split('T')[0],\n            spend: Math.random() * 500 + 100,\n            conversions: Math.floor(Math.random() * 50 + 10),\n            impressions: Math.floor(Math.random() * 10000 + 5000),\n            clicks: Math.floor(Math.random() * 500 + 100),\n          })\n        }\n        setPerformanceData(data)\n      } catch (err: any) {\n        console.error('Error fetching data:', err)\n      } finally {\n        setLoading(false)\n      }\n    }\n\n    fetchData()\n  }, [selectedAccount, period])\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      {/* Header */}\n      <div className=\"bg-white border-b\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <h1 className=\"text-3xl font-bold text-gray-900\">Meta Ads Coach</h1>\n              <p className=\"text-gray-600 mt-1\">Performance insights & recommendations</p>\n            </div>\n            <div className=\"text-right\">\n              {selectedAccount && (\n                <div className=\"text-sm\">\n                  <p className=\"font-semibold\">{selectedAccount.name}</p>\n                  <p className=\"text-gray-600\">{selectedAccount.currency}</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {/* Account Selector & Controls */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\">\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Ad Account\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={selectedAccount?.id || ''}\n              onChange={(e) => {\n                const account = accounts.find((a) => a.id === e.target.value)\n                setSelectedAccount(account || null)\n              }}\n            >\n              <option value=\"\">Select account...</option>\n              {accounts.map((account) => (\n                <option key={account.id} value={account.id}>\n                  {account.name}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n              Time Period\n            </label>\n            <select\n              className=\"w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500\"\n              value={period}\n              onChange={(e) => setPeriod(e.target.value as '7d' | '30d' | '90d')}\n            >\n              <option value=\"7d\">Last 7 days</option>\n              <option value=\"30d\">Last 30 days</option>\n              <option value=\"90d\">Last 90 days</option>\n            </select>\n          </div>\n\n          <div className=\"flex items-end\">\n            {selectedAccount && (\n              <button\n                onClick={() => window.location.href = '/connect'}\n                className=\"w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n              >\n                Add Account\n              </button>\n            )}\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 bg-red-50 border border-red-200 text-red-800 p-4 rounded-lg\">\n            <p className=\"font-semibold\">Error</p>\n            <p className=\"text-sm\">{error}</p>\n          </div>\n        )}\n\n        {loading ? (\n          <div className=\"text-center py-12\">\n            <p className=\"text-gray-600\">Loading performance data...</p>\n          </div>\n        ) : selectedAccount ? (\n          <>\n            {/* Performance Summary Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n              {metrics && (\n                <>\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Spend</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          ${formatNumber(metrics.spend)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-blue-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">Impressions</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {formatNumber(metrics.impressions)}\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-green-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">ROAS</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {metrics.roas.toFixed(2)}x\n                        </p>\n                      </div>\n                      <TrendingUp className=\"text-purple-500\" size={32} />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white rounded-lg shadow p-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div>\n                        <p className=\"text-gray-600 text-sm\">CTR</p>\n                        <p className=\"text-2xl font-bold text-gray-900\">\n                          {(metrics.ctr * 100).toFixed(2)}%\n                        </p>\n                      </div>\n                      <BarChart3 className=\"text-orange-500\" size={32} />\n                    </div>\n                  </div>\n                </>\n              )}\n            </div>\n\n            {/* Performance Chart */}\n            {performanceData.length > 0 && (\n              <div className=\"mb-8\">\n                <PerformanceChart\n                  data={performanceData}\n                  timeframe={period}\n                  onTimeframeChange={setPeriod}\n                />\n              </div>\n            )}\n\n            {/* Campaigns Table */}\n            <div className=\"bg-white rounded-lg shadow mb-8\">\n              <div className=\"px-6 py-4 border-b\">\n                <h2 className=\"text-lg font-semibold\">Campaigns</h2>\n              </div>\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-gray-50 border-b\">\n                    <tr>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Name\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Status\n                      </th>\n                      <th className=\"px-6 py-3 text-left text-sm font-medium text-gray-700\">\n                        Objective\n                      </th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    {campaigns.length > 0 ? (\n                      campaigns.slice(0, 10).map((campaign) => (\n                        <tr key={campaign.id} className=\"border-b hover:bg-gray-50\">\n                          <td className=\"px-6 py-4 text-sm text-gray-900\">\n                            {campaign.name}\n                          </td>\n                          <td className=\"px-6 py-4 text-sm\">\n                            <span\n                              className={`px-2 py-1 rounded text-xs font-medium ${\n                                campaign.status === 'ACTIVE'\n                                  ? 'bg-green-100 text-green-800'\n                                  : 'bg-gray-100 text-gray-800'\n                              }`}\n                            >\n                              {campaign.status}\n                            </span>\n                          </td>\n                          <td className=\"px-6 py-4 text-sm text-gray-600\">\n                            {campaign.objective || '—'}\n                          </td>\n                        </tr>\n                      ))\n                    ) : (\n                      <tr>\n                        <td colSpan={3} className=\"px-6 py-8 text-center text-gray-500\">\n                          No campaigns found\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n\n            {/* Recommendations */}\n            {recommendations.length > 0 && (\n              <div className=\"bg-white rounded-lg shadow\">\n                <div className=\"px-6 py-4 border-b\">\n                  <h2 className=\"text-lg font-semibold\">Recommendations</h2>\n                </div>\n                <div className=\"divide-y\">\n                  {recommendations.slice(0, 5).map((rec) => (\n                    <div\n                      key={rec.id}\n                      className=\"px-6 py-4 cursor-pointer hover:bg-gray-50 transition\"\n                      onClick={() => {\n                        setSelectedRecommendation(rec)\n                        setShowModal(true)\n                      }}\n                    >\n                      <div className=\"flex items-start gap-3\">\n                        <AlertCircle\n                          className={\n                            rec.priority === 'high'\n                              ? 'text-red-500'\n                              : rec.priority === 'medium'\n                                ? 'text-yellow-500'\n                                : 'text-blue-500'\n                          }\n                          size={20}\n                        />\n                        <div className=\"flex-1\">\n                          <p className=\"font-semibold text-gray-900\">{rec.title}</p>\n                          <p className=\"text-sm text-gray-600 mt-1\">\n                            {rec.description}\n                          </p>\n                          <div className=\"flex items-center gap-4 mt-2\">\n                            <span className=\"text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded\">\n                              Confidence: {(rec.confidence_score * 100).toFixed(0)}%\n                            </span>\n                            <span className=\"text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded\">\n                              Impact: {(rec.estimated_impact * 100).toFixed(0)}%\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {/* Recommendation Modal */}\n            <RecommendationModal\n              recommendation={selectedRecommendation}\n              isOpen={showModal}\n              onClose={() => setShowModal(false)}\n            />\n          </>\n        ) : (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Select an account to view performance data</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":417,"startLine":1,"totalLines":417}}}
