riority\": \"P0\",\n      \"phase\": 4,\n      \"effort\": \"16h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"lib/recommendation-engine.ts\",\n        \"lib/rules.ts\"\n      ],\n      \"acceptance\": [\n        \"Rules engine evaluates performance metrics\",\n        \"Recommendations generated daily\",\n        \"Recommendation types: budget, creative, audience, targeting\",\n        \"Confidence scores assigned\",\n        \"Recommendations ranked by impact\"\n      ],\n      \"dependencies\": [\n        \"PERF-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-002\",\n      \"name\": \"Budget Optimization Recommendations\",\n      \"description\": \"Generate recommendations for budget reallocation and optimization\",\n      \"priority\": \"P0\",\n      \"phase\": 4,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"lib/rules/budget-rules.ts\"\n      ],\n      \"acceptance\": [\n        \"Low-performing campaigns identified\",\n        \"Budget increase recommendations for winners\",\n        \"Budget reduction recommendations for losers\",\n        \"ROI impact estimated\",\n        \"Implementation instructions provided\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-003\",\n      \"name\": \"Creative Refresh Recommendations\",\n      \"description\": \"Recommend creative changes based on ad fatigue and performance\",\n      \"priority\": \"P1\",\n      \"phase\": 4,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"lib/rules/creative-rules.ts\"\n      ],\n      \"acceptance\": [\n        \"Ad fatigue detected from declining CTR\",\n        \"Creative refresh recommended when frequency > 3\",\n        \"Top-performing creatives identified\",\n        \"Underperforming ads flagged\",\n        \"A/B test suggestions provided\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-004\",\n      \"name\": \"Audience Targeting Recommendations\",\n      \"description\": \"Recommend audience and targeting adjustments\",\n      \"priority\": \"P1\",\n      \"phase\": 4,\n      \"effort\": \"8h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"lib/rules/audience-rules.ts\"\n      ],\n      \"acceptance\": [\n        \"High-converting audiences identified\",\n        \"Audience expansion recommendations\",\n        \"Lookalike audience suggestions\",\n        \"Interest/behavior refinements suggested\",\n        \"Targeting conflict warnings\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-005\",\n      \"name\": \"Recommendation Scoring & Ranking\",\n      \"description\": \"Score and rank recommendations by estimated impact\",\n      \"priority\": \"P1\",\n      \"phase\": 4,\n      \"effort\": \"6h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"lib/scoring.ts\"\n      ],\n      \"acceptance\": [\n        \"Impact score calculated (0-100)\",\n        \"Effort/implementation cost estimated\",\n        \"ROI projection provided\",\n        \"Recommendations ranked by impact\",\n        \"Priority color-coded (red/yellow/green)\"\n      ],\n      \"dependencies\": [\n        \"COACH-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"COACH-006\",\n      \"name\": \"Recommendation History & Tracking\",\n      \"description\": \"Store recommendation history and track implementation\",\n      \"priority\": \"P1\",\n      \"phase\": 4,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"coaching\",\n      \"files\": [\n        \"api/recommendations/history.ts\"\n      ],\n      \"acceptance\": [\n        \"All recommendations stored with timestamp\",\n        \"Implementation status tracked\",\n        \"Recommendation effectiveness measured post-implementation\",\n        \"Historical recommendations queryable\",\n        \"Recommendation details versioned\"\n      ],\n      \"dependencies\": [\n        \"COACH-005\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"DASH-001\",\n      \"name\": \"Dashboard Layout & Navigation\",\n      \"description\": \"Build main dashboard UI layout with navigation\",\n      \"priority\": \"P0\",\n      \"phase\": 5,\n      \"effort\": \"6h\",\n      \"passes\": true,\n      \"category\": \"ui\",\n      \"files\": [\n        \"pages/dashboard.tsx\",\n        \"components/Layout.tsx\"\n      ],\n      \"acceptance\": [\n        \"Dashboard loads after login\",\n        \"Navigation menu functional\",\n        \"Responsive on desktop/tablet/mobile\",\n        \"Dark mode toggle works\",\n        \"Performance metrics displayed prominently\"\n      ],\n      \"dependencies\": [\n        \"AUTH-002\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"DASH-002\",\n      \"name\": \"Account Selection & Switching\",\n      \"description\": \"UI for selecting and switching between linked accounts\",\n      \"priority\": \"P0\",\n      \"phase\": 5,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"ui\",\n      \"files\": [\n        \"components/AccountSelector.tsx\"\n      ],\n      \"acceptance\": [\n        \"Dropdown shows all linked accounts\",\n        \"Account switch updates all metrics\",\n        \"Selected account persisted\",\n        \"Account info displayed (currency, timezone)\",\n        \"Edit account settings available\"\n      ],\n      \"dependencies\": [\n        \"META-003\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \