{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01KXJqCChRu8saRsB7fBq2rp","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Good! Recharts installed successfully. Now let me create a performance chart component. Let me create a simple chart that shows spend and conversions over time.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":204,"cache_read_input_tokens":134801,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":204},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"0a7a6962-707b-432a-94ba-10b2e85c8b93","uuid":"6ea0d894-2ddd-4121-ab7e-ec28fb2daa51"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01KXJqCChRu8saRsB7fBq2rp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Gh9joRXUXCAu6Y4R8s9Bcu","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/components/PerformanceChart.tsx","content":"'use client'\n\nimport { useState, useMemo } from 'react'\nimport {\n  LineChart,\n  Line,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  Legend,\n  ResponsiveContainer,\n} from 'recharts'\n\nexport interface PerformanceData {\n  date: string\n  spend: number\n  conversions: number\n  impressions: number\n  clicks: number\n}\n\ninterface PerformanceChartProps {\n  data: PerformanceData[]\n  metric?: 'spend' | 'conversions' | 'impressions' | 'clicks'\n  timeframe?: '7d' | '30d' | '90d'\n  onTimeframeChange?: (timeframe: '7d' | '30d' | '90d') => void\n}\n\nexport function PerformanceChart({\n  data,\n  metric = 'spend',\n  timeframe = '30d',\n  onTimeframeChange,\n}: PerformanceChartProps) {\n  const [selectedMetric, setSelectedMetric] = useState(metric)\n\n  const chartData = useMemo(() => {\n    if (!data || data.length === 0) return []\n\n    return data.map((item) => ({\n      ...item,\n      dateLabel: new Date(item.date).toLocaleDateString('en-US', {\n        month: 'short',\n        day: 'numeric',\n      }),\n    }))\n  }, [data])\n\n  if (!chartData || chartData.length === 0) {\n    return (\n      <div className=\"bg-white rounded-lg shadow p-6 text-center\">\n        <p className=\"text-gray-600\">No data available for the selected period</p>\n      </div>\n    )\n  }\n\n  const metricConfig = {\n    spend: {\n      label: 'Spend ($)',\n      color: '#3b82f6',\n      dataKey: 'spend',\n      yAxisLabel: 'USD',\n    },\n    conversions: {\n      label: 'Conversions',\n      color: '#10b981',\n      dataKey: 'conversions',\n      yAxisLabel: 'Count',\n    },\n    impressions: {\n      label: 'Impressions',\n      color: '#f59e0b',\n      dataKey: 'impressions',\n      yAxisLabel: 'Count',\n    },\n    clicks: {\n      label: 'Clicks',\n      color: '#8b5cf6',\n      dataKey: 'clicks',\n      yAxisLabel: 'Count',\n    },\n  }\n\n  const config = metricConfig[selectedMetric as keyof typeof metricConfig]\n\n  return (\n    <div className=\"bg-white rounded-lg shadow p-6\">\n      <div className=\"flex items-center justify-between mb-6\">\n        <h2 className=\"text-lg font-semibold\">Performance Over Time</h2>\n        <div className=\"flex gap-2\">\n          <select\n            value={selectedMetric}\n            onChange={(e) =>\n              setSelectedMetric(\n                e.target.value as 'spend' | 'conversions' | 'impressions' | 'clicks'\n              )\n            }\n            className=\"px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500\"\n          >\n            <option value=\"spend\">Spend</option>\n            <option value=\"impressions\">Impressions</option>\n            <option value=\"clicks\">Clicks</option>\n            <option value=\"conversions\">Conversions</option>\n          </select>\n\n          {onTimeframeChange && (\n            <select\n              value={timeframe}\n              onChange={(e) => onTimeframeChange(e.target.value as '7d' | '30d' | '90d')}\n              className=\"px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500\"\n            >\n              <option value=\"7d\">Last 7 days</option>\n              <option value=\"30d\">Last 30 days</option>\n              <option value=\"90d\">Last 90 days</option>\n            </select>\n          )}\n        </div>\n      </div>\n\n      <ResponsiveContainer width=\"100%\" height={300}>\n        <LineChart data={chartData} margin={{ top: 5, right: 30, left: 0, bottom: 5 }}>\n          <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#e5e7eb\" />\n          <XAxis\n            dataKey=\"dateLabel\"\n            stroke=\"#6b7280\"\n            style={{ fontSize: '12px' }}\n          />\n          <YAxis\n            stroke=\"#6b7280\"\n            style={{ fontSize: '12px' }}\n            label={{ value: config.yAxisLabel, angle: -90, position: 'insideLeft' }}\n          />\n          <Tooltip\n            contentStyle={{\n              backgroundColor: '#fff',\n              border: '1px solid #e5e7eb',\n              borderRadius: '8px',\n            }}\n            formatter={(value: number) => {\n              if (selectedMetric === 'spend') {\n                return `$${value.toFixed(2)}`\n              }\n              return value.toLocaleString()\n            }}\n          />\n          <Legend />\n          <Line\n            type=\"monotone\"\n            dataKey={config.dataKey}\n            stroke={config.color}\n            name={config.label}\n            dot={false}\n            strokeWidth={2}\n            isAnimationActive={false}\n          />\n        </LineChart>\n      </ResponsiveContainer>\n\n      {/* Chart Summary */}\n      <div className=\"mt-6 pt-6 border-t grid grid-cols-2 sm:grid-cols-4 gap-4\">\n        {chartData.length > 0 && (\n          <>\n            <div>\n              <p className=\"text-xs text-gray-600 uppercase\">Avg {config.label}</p>\n              <p className=\"text-lg font-semibold mt-1\">\n                {selectedMetric === 'spend'\n                  ? `$${(\n                      chartData.reduce((sum, d) => sum + (d[selectedMetric] || 0), 0) /\n                      chartData.length\n                    ).toFixed(2)}`\n                  : Math.round(\n                      chartData.reduce((sum, d) => sum + (d[selectedMetric] || 0), 0) /\n                        chartData.length\n                    ).toLocaleString()}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-gray-600 uppercase\">Peak {config.label}</p>\n              <p className=\"text-lg font-semibold mt-1\">\n                {selectedMetric === 'spend'\n                  ? `$${Math.max(...chartData.map((d) => d[selectedMetric] || 0)).toFixed(2)}`\n                  : Math.max(...chartData.map((d) => d[selectedMetric] || 0)).toLocaleString()}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-gray-600 uppercase\">Total {config.label}</p>\n              <p className=\"text-lg font-semibold mt-1\">\n                {selectedMetric === 'spend'\n                  ? `$${chartData.reduce((sum, d) => sum + (d[selectedMetric] || 0), 0).toFixed(2)}`\n                  : chartData\n                      .reduce((sum, d) => sum + (d[selectedMetric] || 0), 0)\n                      .toLocaleString()}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-gray-600 uppercase\">Data Points</p>\n              <p className=\"text-lg font-semibold mt-1\">{chartData.length}</p>\n            </div>\n          </>\n        )}\n      </div>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":204,"cache_read_input_tokens":134801,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":204},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"0a7a6962-707b-432a-94ba-10b2e85c8b93","uuid":"3e23c7f6-088d-4857-b3ae-9ab01f4f09a7"}
