scription: 'Test',\n          confidence: 0.5,\n          estimatedImpact: 100,\n          effort: 5,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n\n    it('should filter out low-confidence recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'High Confidence',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Low Confidence',\n          description: 'Test',\n          confidence: 0.2,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      // Low confidence recommendations should have lower scores\n      const highConfScore = scored.find((r) => r.id === '1')?.score || 0\n      const lowConfScore = scored.find((r) => r.id === '2')?.score || 0\n\n      expect(highConfScore).toBeGreaterThan(lowConfScore)\n    })\n\n    it('should handle empty recommendations list', () => {\n      const recommendations: any[] = []\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toEqual([])\n    })\n\n    it('should assign higher scores to high-impact recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'High Impact',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 5000,\n          effort: 2,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Low Impact',\n          description: 'Test',\n          confidence: 0.8,\n          estimatedImpact: 100,\n          effort: 2,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n      const highImpactScore = scored.find((r) => r.id === '1')?.score || 0\n      const lowImpactScore = scored.find((r) => r.id === '2')?.score || 0\n\n      expect(highImpactScore).toBeGreaterThan(lowImpactScore)\n    })\n  })\n\n  describe('generateRecommendations', () => {\n    it('should return an array of recommendations', async () => {\n      // Mock Supabase for this test\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(Array.isArray(recommendations)).toBe(true)\n    })\n\n    it('should include different recommendation types', async () => {\n      jest.mock('@/lib/supabase', () => ({\n        supabaseAdmin: jest.fn(() => ({\n          from: jest.fn(() => ({\n            select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n          })),\n        })),\n      }))\n\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      const types = recommendations.map((r) => r.type)\n      expect(types.length).toBeGreaterThanOrEqual(0)\n    })\n  })\n})","newString":"import { RecommendationEngine, Recommendation } from '@/lib/recommendation-engine'\n\njest.mock('@/lib/supabase', () => ({\n  supabaseAdmin: jest.fn(() => ({\n    from: jest.fn(() => ({\n      select: jest.fn(() => Promise.resolve({ data: [], error: null })),\n      insert: jest.fn(() => Promise.resolve({ data: null, error: null })),\n    })),\n  })),\n}))\n\ndescribe('RecommendationEngine', () => {\n  describe('scoreRecommendations', () => {\n    it('should sort recommendations by calculated score', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = [\n        {\n          id: '1',\n          meta_account_id: 'acc1',\n          recommendation_type: 'budget',\n          title: 'High Score Rec',\n          description: 'High confidence and impact',\n          confidence_score: 0.9,\n          estimated_impact: 500,\n          estimated_effort: 'low',\n          implementation_instructions: 'Increase budget to $100',\n          priority: 'high',\n        },\n        {\n          id: '2',\n          meta_account_id: 'acc1',\n          recommendation_type: 'creative',\n          title: 'Low Score Rec',\n          description: 'Low confidence and impact',\n          confidence_score: 0.3,\n          estimated_impact: 50,\n          estimated_effort: 'high',\n          implementation_instructions: 'Refresh creative',\n          priority: 'low',\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toHaveLength(2)\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n\n    it('should handle empty recommendations list', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = []\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toEqual([])\n    })\n\n    it('should rank by confidence * impact / effort', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = [\n        {\n          id: '1',\n          meta_account_id: 'acc1',\n          recommendation_type: 'budget',\n          title: 'Low impact, high confidence',\n          description: 'Test',\n          confidence_score: 0.9,\n          estimated_impact: 100,\n          estimated_effort: 'low',\n          implementation_instructions: 'Test',\n          priority: 'high',\n        },\n        {\n          id: '2',\n          meta_account_id: 'acc1',\n          recommendation_type: 'creative',\n          title: 'High impact, low confidence',\n          description: 'Test',\n          confidence_score: 0.3,\n          estimated_impact: 1000,\n          estimated_effort: 'high',\n          implementation_instructions: 'Test',\n          priority: 'low',\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      // Score formula: confidence * impact / effort_multiplier\n      // Rec 1: (0.9 * 100) / 1 = 90\n      // Rec 2: (0.3 * 1000) / 3 = 100\n      // Rec 2 should rank first\n      expect(scored[0].id).toBe('2')\n    })\n\n    it('should account for effort multiplier in scoring', () => {\n      const engine = new RecommendationEngine()\n      const lowEffortRec: Recommendation = {\n        id: '1',\n        meta_account_id: 'acc1',\n        recommendation_type: 'budget',\n        title: 'Low Effort',\n        description: 'Test',\n        confidence_score: 0.5,\n        estimated_impact: 200,\n        estimated_effort: 'low',\n        implementation_instructions: 'Test',\n        priority: 'high',\n      }\n\n      const highEffortRec: Recommendation = {\n        id: '2',\n        meta_account_id: 'acc1',\n        recommendation_type: 'creative',\n        title: 'High Effort',\n        description: 'Test',\n        confidence_score: 0.5,\n        estimated_impact: 200,\n        estimated_effort: 'high',\n        implementation_instructions: 'Test',\n        priority: 'low',\n      }\n\n      const scored = engine.scoreRecommendations([highEffortRec, lowEffortRec])\n\n      // Low effort should rank higher since effort is in denominator\n      // Low effort: (0.5 * 200) / 1 = 100\n      // High effort: (0.5 * 200) / 3 = 33.33\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n  })\n\n  describe('generateRecommendations', () => {\n    it('should return an array of recommendations', async () => {\n      const engine = new RecommendationEngine()\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(Array.isArray(recommendations)).toBe(true)\n    })\n\n    it('should handle no metrics gracefully', async () => {\n      const engine = new RecommendationEngine()\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(recommendations).toEqual([])\n    })\n  })\n})","originalFile":"import { RecommendationEngine } from '@/lib/recommendation-engine'\n\ndescribe('RecommendationEngine', () => {\n  let engine: RecommendationEngine\n\n  beforeEach(() => {\n    engine = new RecommendationEngine()\n  })\n\n  describe('scoreRecommendations', () => {\n    it('should assign impact scores to recommendations', () => {\n      const recommendations = [\n        {\n          id: '1',\n          type: 'budget' as const,\n          title: 'Increase Budget',\n          description: 'Increase budget for high-performing campaign',\n          confidence: 0.8,\n          estimatedImpact: 500,\n          effort: 1,\n          createdAt: new Date(),\n          status: 'pending' as const,\n          implementationNotes: null,\n          implementedAt: null,\n        },\n        {\n          id: '2',\n          type: 'creative' as const,\n          title: 'Refresh Creative',\n          description: 'Ad fatigue detected',\n    