{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01G8Rc9vmJpxJ2gHJi5Nr3Vj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WaLScDyT9W4axF5tnRYrZD","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/auth/reset-password/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { z } from 'zod'\n\nconst resetPasswordSchema = z.object({\n  token: z.string().min(1, 'Token is required'),\n  password: z.string().min(8, 'Password must be at least 8 characters'),\n})\n\nexport async function POST(req: NextRequest) {\n  try {\n    const body = await req.json()\n    const validated = resetPasswordSchema.parse(body)\n    const { token, password } = validated\n\n    const supabase = supabaseAdmin()\n\n    // Update user password using the recovery token\n    const { error } = await supabase.auth.admin.updateUserById(\n      token, // The token is provided by the client from the reset link\n      { password }\n    )\n\n    if (error) {\n      return NextResponse.json(\n        { error: 'Failed to reset password. Token may be invalid or expired.' },\n        { status: 400 }\n      )\n    }\n\n    return NextResponse.json(\n      { success: true, message: 'Password reset successfully. Please log in with your new password.' },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    if (error instanceof z.ZodError) {\n      return NextResponse.json(\n        { error: 'Validation error', details: error.errors },\n        { status: 400 }\n      )\n    }\n\n    console.error('Reset password error:', error)\n    return NextResponse.json(\n      { error: 'An error occurred during password reset' },\n      { status: 500 }\n    )\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":724,"cache_read_input_token