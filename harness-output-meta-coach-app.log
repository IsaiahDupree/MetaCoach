{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01ScjjcphAKbtd2hySLhLwrC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YAX6UyCroTuvQML6ZTjkGY","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/auth-middleware.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { jwtVerify } from 'jose'\n\nconst JWT_SECRET = new TextEncoder().encode(\n  process.env.SUPABASE_JWT_SECRET || 'your-secret-key'\n)\n\ninterface AuthPayload {\n  sub: string\n  aud: string\n  iat: number\n  exp: number\n  email?: string\n  email_confirmed?: boolean\n  phone_verified?: boolean\n  app_metadata?: any\n  user_metadata?: any\n  role?: string\n  aal?: string\n  amr?: Array<{ method: string; timestamp: number }>\n  session_id?: string\n}\n\nexport async function verifyAuth(req: NextRequest): Promise<{\n  authenticated: boolean\n  userId?: string\n  user?: AuthPayload\n  error?: string\n}> {\n  try {\n    // Get token from header or cookie\n    const authHeader = req.headers.get('authorization')\n    const token = authHeader?.replace('Bearer ', '')\n\n    if (!token) {\n      return {\n        authenticated: false,\n        error: 'Missing authentication token',\n      }\n    }\n\n    // Verify JWT token\n    const verified = await jwtVerify(token, JWT_SECRET)\n    const payload = verified.payload as AuthPayload\n\n    // Check if token is expired\n    const now = Math.floor(Date.now() / 1000)\n    if (payload.exp && payload.exp < now) {\n      return {\n        authenticated: false,\n        error: 'Token has expired',\n      }\n    }\n\n    return {\n      authenticated: true,\n      userId: payload.sub,\n      user: payload,\n    }\n  } catch (error: any) {\n    return {\n      authenticated: false,\n      error: error.message || 'Invalid token',\n    }\n  }\n}\n\nexport function authMiddleware(handler: Function) {\n  return async (req: NextRequest, ...args: any[]) => {\n    const auth = await verifyAuth(req)\n\n    if (!auth.authenticated) {\n      return NextResponse.json(\n        { error: auth.error || 'Unauthorized' },\n        { status: 401 }\n      )\n    }\n\n    // Attach user to request context\n    const requestWithUser = Object.assign(req, {\n      user: auth.user,\n      userId: auth.userId,\n    })\n\n    return handler(requestWithUser, ...args)\n  }\n}\n\n/**\n * Middleware function to check authentication\n * Can be used in Next.js middleware.ts or directly in API routes\n */\nexport async function authMiddlewareHandler(req: NextRequest) {\n  const auth = await verifyAuth(req)\n\n  if (!auth.authenticated) {\n    return NextResponse.json(\n      { error: auth.error || 'Unauthorized' },\n      { status: 401 }\n    )\n  }\n\n  return null // No error, allow request to proceed\n}\n\n/**\n * Helper to create a protected API route\n */\nexport function createProtectedRoute(handler: Function) {\n  return async (req: NextRequest, ...args: any[]) => {\n    const auth = await verifyAuth(req)\n\n    if (!auth.authenticated) {\n      return NextResponse.json(\n        { error: auth.error || 'Unauthorized' },\n        { status: 401 }\n      )\n    }\n\n    // Add auth info to request\n    ;(req as any).userId = auth.userId\n    ;(req as any).user = auth.user\n\n    return handler(req, ...args)\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":608,"cache_read_input_tokens":127714,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":608},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"e3473e05-c962-4f57-b50b-a3f0271abf62"}
