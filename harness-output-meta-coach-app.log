{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CCHPoja7AVufyDH1gaMTUa","type":"tool_result","content":"     1→import { RecommendationEngine, Recommendation } from '@/lib/recommendation-engine'\n     2→\n     3→jest.mock('@/lib/supabase', () => ({\n     4→  supabaseAdmin: jest.fn(() => ({\n     5→    from: jest.fn(() => ({\n     6→      select: jest.fn(() => ({\n     7→        gte: jest.fn(() => Promise.resolve({ data: [], error: null })),\n     8→      })),\n     9→      insert: jest.fn(() => Promise.resolve({ data: null, error: null })),\n    10→    })),\n    11→  })),\n    12→}))\n    13→\n    14→describe('RecommendationEngine', () => {\n    15→  describe('scoreRecommendations', () => {\n    16→    it('should sort recommendations by calculated score', () => {\n    17→      const engine = new RecommendationEngine()\n    18→      const recommendations: Recommendation[] = [\n    19→        {\n    20→          id: '1',\n    21→          meta_account_id: 'acc1',\n    22→          recommendation_type: 'budget',\n    23→          title: 'High Score Rec',\n    24→          description: 'High confidence and impact',\n    25→          confidence_score: 0.9,\n    26→          estimated_impact: 500,\n    27→          estimated_effort: 'low',\n    28→          implementation_instructions: 'Increase budget to $100',\n    29→          priority: 'high',\n    30→        },\n    31→        {\n    32→          id: '2',\n    33→          meta_account_id: 'acc1',\n    34→          recommendation_type: 'creative',\n    35→          title: 'Low Score Rec',\n    36→          description: 'Low confidence and impact',\n    37→          confidence_score: 0.3,\n    38→          estimated_impact: 50,\n    39→          estimated_effort: 'high',\n    40→          implementation_instructions: 'Refresh creative',\n    41→          priority: 'low',\n    42→        },\n    43→      ]\n    44→\n    45→      const scored = engine.scoreRecommendations(recommendations)\n    46→\n    47→      expect(scored).toHaveLength(2)\n    48→      expect(scored[0].id).toBe('1')\n    49→      expect(scored[1].id).toBe('2')\n    50→    })\n    51→\n    52→    it('should handle empty recommendations list', () => {\n    53→      const engine = new RecommendationEngine()\n    54→      const recommendations: Recommendation[] = []\n    55→      const scored = engine.scoreRecommendations(recommendations)\n    56→\n    57→      expect(scored).toEqual([])\n    58→    })\n    59→\n    60→    it('should rank by confidence * impact / effort', () => {\n    61→      const engine = new RecommendationEngine()\n    62→      const recommendations: Recommendation[] = [\n    63→        {\n    64→          id: '1',\n    65→          meta_account_id: 'acc1',\n    66→          recommendation_type: 'budget',\n    67→          title: 'Low impact, high confidence',\n    68→          description: 'Test',\n    69→          confidence_score: 0.9,\n    70→          estimated_impact: 100,\n    71→          estimated_effort: 'low',\n    72→          implementation_instructions: 'Test',\n    73→          priority: 'high',\n    74→        },\n    75→        {\n    76→          id: '2',\n    77→          meta_account_id: 'acc1',\n    78→          recommendation_type: 'creative',\n    79→          title: 'High impact, low confidence',\n    80→          description: 'Test',\n    81→          confidence_score: 0.3,\n    82→          estimated_impact: 1000,\n    83→          estimated_effort: 'high',\n    84→          implementation_instructions: 'Test',\n    85→          priority: 'low',\n    86→        },\n    87→      ]\n    88→\n    89→      const scored = engine.scoreRecommendations(recommendations)\n    90→\n    91→      // Score formula: confidence * impact / effort_multiplier\n    92→      // Rec 1: (0.9 * 100) / 1 = 90\n    93→      // Rec 2: (0.3 * 1000) / 3 = 100\n    94→      // Rec 2 should rank first\n    95→      expect(scored[0].id).toBe('2')\n    96→    })\n    97→\n    98→    it('should account for effort multiplier in scoring', () => {\n    99→      const engine = new RecommendationEngine()\n   100→      const lowEffortRec: Recommendation = {\n   101→        id: '1',\n   102→        meta_account_id: 'acc1',\n   103→        recommendation_type: 'budget',\n   104→        title: 'Low Effort',\n   105→        description: 'Test',\n   106→        confidence_score: 0.5,\n   107→        estimated_impact: 200,\n   108→        estimated_effort: 'low',\n   109→        implementation_instructions: 'Test',\n   110→        priority: 'high',\n   111→      }\n   112→\n   113→      const highEffortRec: Recommendation = {\n   114→        id: '2',\n   115→        meta_account_id: 'acc1',\n   116→        recommendation_type: 'creative',\n   117→        title: 'High Effort',\n   118→        description: 'Test',\n   119→        confidence_score: 0.5,\n   120→        estimated_impact: 200,\n   121→        estimated_effort: 'high',\n   122→        implementation_instructions: 'Test',\n   123→        priority: 'low',\n   124→      }\n   125→\n   126→      const scored = engine.scoreRecommendations([highEffortRec, lowEffortRec])\n   127→\n   128→      // Low effort should rank higher since effort is in denominator\n   129→      // Low effort: (0.5 * 200) / 1 = 100\n   130→      // High effort: (0.5 * 200) / 3 = 33.33\n   131→      expect(scored[0].id).toBe('1')\n   132→      expect(scored[1].id).toBe('2')\n   133→    })\n   134→  })\n   135→\n   136→  describe('generateRecommendations', () => {\n   137→    it('should return an array of recommendations', async () => {\n   138→      const engine = new RecommendationEngine()\n   139→      const recommendations = await engine.generateRecommendations('test-account-id')\n   140→\n   141→      expect(Array.isArray(recommendations)).toBe(true)\n   142→    })\n   143→\n   144→    it('should handle no metrics gracefully', async () => {\n   145→      const engine = new RecommendationEngine()\n   146→      const recommendations = await engine.generateRecommendations('test-account-id')\n   147→\n   148→      expect(recommendations).toEqual([])\n   149→    })\n   150→  })\n   151→})\n   152→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"696953f4-dd80-4e1f-822d-323c8e9dc8c8","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/__tests__/lib/recommendation-engine.test.ts","content":"import { RecommendationEngine, Recommendation } from '@/lib/recommendation-engine'\n\njest.mock('@/lib/supabase', () => ({\n  supabaseAdmin: jest.fn(() => ({\n    from: jest.fn(() => ({\n      select: jest.fn(() => ({\n        gte: jest.fn(() => Promise.resolve({ data: [], error: null })),\n      })),\n      insert: jest.fn(() => Promise.resolve({ data: null, error: null })),\n    })),\n  })),\n}))\n\ndescribe('RecommendationEngine', () => {\n  describe('scoreRecommendations', () => {\n    it('should sort recommendations by calculated score', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = [\n        {\n          id: '1',\n          meta_account_id: 'acc1',\n          recommendation_type: 'budget',\n          title: 'High Score Rec',\n          description: 'High confidence and impact',\n          confidence_score: 0.9,\n          estimated_impact: 500,\n          estimated_effort: 'low',\n          implementation_instructions: 'Increase budget to $100',\n          priority: 'high',\n        },\n        {\n          id: '2',\n          meta_account_id: 'acc1',\n          recommendation_type: 'creative',\n          title: 'Low Score Rec',\n          description: 'Low confidence and impact',\n          confidence_score: 0.3,\n          estimated_impact: 50,\n          estimated_effort: 'high',\n          implementation_instructions: 'Refresh creative',\n          priority: 'low',\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toHaveLength(2)\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n\n    it('should handle empty recommendations list', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = []\n      const scored = engine.scoreRecommendations(recommendations)\n\n      expect(scored).toEqual([])\n    })\n\n    it('should rank by confidence * impact / effort', () => {\n      const engine = new RecommendationEngine()\n      const recommendations: Recommendation[] = [\n        {\n          id: '1',\n          meta_account_id: 'acc1',\n          recommendation_type: 'budget',\n          title: 'Low impact, high confidence',\n          description: 'Test',\n          confidence_score: 0.9,\n          estimated_impact: 100,\n          estimated_effort: 'low',\n          implementation_instructions: 'Test',\n          priority: 'high',\n        },\n        {\n          id: '2',\n          meta_account_id: 'acc1',\n          recommendation_type: 'creative',\n          title: 'High impact, low confidence',\n          description: 'Test',\n          confidence_score: 0.3,\n          estimated_impact: 1000,\n          estimated_effort: 'high',\n          implementation_instructions: 'Test',\n          priority: 'low',\n        },\n      ]\n\n      const scored = engine.scoreRecommendations(recommendations)\n\n      // Score formula: confidence * impact / effort_multiplier\n      // Rec 1: (0.9 * 100) / 1 = 90\n      // Rec 2: (0.3 * 1000) / 3 = 100\n      // Rec 2 should rank first\n      expect(scored[0].id).toBe('2')\n    })\n\n    it('should account for effort multiplier in scoring', () => {\n      const engine = new RecommendationEngine()\n      const lowEffortRec: Recommendation = {\n        id: '1',\n        meta_account_id: 'acc1',\n        recommendation_type: 'budget',\n        title: 'Low Effort',\n        description: 'Test',\n        confidence_score: 0.5,\n        estimated_impact: 200,\n        estimated_effort: 'low',\n        implementation_instructions: 'Test',\n        priority: 'high',\n      }\n\n      const highEffortRec: Recommendation = {\n        id: '2',\n        meta_account_id: 'acc1',\n        recommendation_type: 'creative',\n        title: 'High Effort',\n        description: 'Test',\n        confidence_score: 0.5,\n        estimated_impact: 200,\n        estimated_effort: 'high',\n        implementation_instructions: 'Test',\n        priority: 'low',\n      }\n\n      const scored = engine.scoreRecommendations([highEffortRec, lowEffortRec])\n\n      // Low effort should rank higher since effort is in denominator\n      // Low effort: (0.5 * 200) / 1 = 100\n      // High effort: (0.5 * 200) / 3 = 33.33\n      expect(scored[0].id).toBe('1')\n      expect(scored[1].id).toBe('2')\n    })\n  })\n\n  describe('generateRecommendations', () => {\n    it('should return an array of recommendations', async () => {\n      const engine = new RecommendationEngine()\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(Array.isArray(recommendations)).toBe(true)\n    })\n\n    it('should handle no metrics gracefully', async () => {\n      const engine = new RecommendationEngine()\n      const recommendations = await engine.generateRecommendations('test-account-id')\n\n      expect(recommendations).toEqual([])\n    })\n  })\n})\n","numLines":152,"startLine":1,"totalLines":152}}}
