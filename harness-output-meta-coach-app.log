{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01GyBA1GvpU21bEtHgaT6Q2z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C1srKAvoZiSh3x87Bbf6Rs","name":"Edit","input":{"replace_all":false,"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/sync/campaigns/route.ts","old_string":"          await supabase\n            .from('meta_ad_sets')\n            .upsert(adSetsToUpsert, { onConflict: 'id' })\n            .catch((err) => console.error('Error syncing ad sets:', err))","new_string":"          const { error: adSetError } = await supabase\n            .from('meta_ad_sets')\n            .upsert(adSetsToUpsert, { onConflict: 'id' })\n\n          if (adSetError) {\n            console.error('Error syncing ad sets:', adSetError)\n          }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":517,"cache_read_input_tokens":154845,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":517},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"03e99911-97c0-4f7d-99e1-056a86191c29"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C1srKAvoZiSh3x87Bbf6Rs","type":"tool_result","content":"The file /Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/sync/campaigns/route.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"44b54fb0-359a-42fc-87a5-d74404ada51e","tool_use_result":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/meta/sync/campaigns/route.ts","oldString":"          await supabase\n            .from('meta_ad_sets')\n            .upsert(adSetsToUpsert, { onConflict: 'id' })\n            .catch((err) => console.error('Error syncing ad sets:', err))","newString":"          const { error: adSetError } = await supabase\n            .from('meta_ad_sets')\n            .upsert(adSetsToUpsert, { onConflict: 'id' })\n\n          if (adSetError) {\n            console.error('Error syncing ad sets:', adSetError)\n          }","originalFile":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { createProtectedRoute } from '@/lib/auth-middleware'\nimport { MetaClient } from '@/lib/meta'\n\nconst handler = async (req: NextRequest & { userId?: string }) => {\n  try {\n    if (!req.userId) {\n      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })\n    }\n\n    const supabase = supabaseAdmin()\n    const accountId = req.nextUrl.searchParams.get('account_id')\n\n    if (!accountId) {\n      return NextResponse.json(\n        { error: 'account_id query parameter is required' },\n        { status: 400 }\n      )\n    }\n\n    // Get the Meta account with access token\n    const { data: account, error: accountError } = await supabase\n      .from('meta_accounts')\n      .select('access_token, token_expires_at')\n      .eq('id', accountId)\n      .eq('user_id', req.userId)\n      .single()\n\n    if (accountError || !account) {\n      return NextResponse.json(\n        { error: 'Account not found or unauthorized' },\n        { status: 404 }\n      )\n    }\n\n    // Check if token is expired\n    const now = new Date()\n    const tokenExpires = new Date(account.token_expires_at || now)\n    if (tokenExpires < now) {\n      return NextResponse.json(\n        { error: 'Access token has expired. Please reconnect your account.' },\n        { status: 401 }\n      )\n    }\n\n    // Create Meta client and fetch campaigns\n    const client = new MetaClient(account.access_token)\n    const metaCampaigns = await client.getCampaigns(accountId, 1000)\n\n    if (!metaCampaigns || metaCampaigns.length === 0) {\n      return NextResponse.json(\n        { success: true, synced: 0, message: 'No campaigns found for this account' },\n        { status: 200 }\n      )\n    }\n\n    // Sync campaigns to database\n    const campaignsToUpsert = metaCampaigns.map((campaign: any) => ({\n      id: campaign.id,\n      meta_account_id: accountId,\n      campaign_name: campaign.name,\n      campaign_status: campaign.status,\n      campaign_objective: campaign.objective,\n      daily_budget: campaign.daily_budget ? campaign.daily_budget / 100 : null,\n      lifetime_budget: campaign.lifetime_budget ? campaign.lifetime_budget / 100 : null,\n      start_date: campaign.created_time ? new Date(campaign.created_time).toISOString().split('T')[0] : null,\n      end_date: null,\n    }))\n\n    // Upsert campaigns\n    const { error: syncError } = await supabase\n      .from('campaigns')\n      .upsert(campaignsToUpsert, { onConflict: 'id' })\n\n    if (syncError) {\n      console.error('Error syncing campaigns:', syncError)\n      return NextResponse.json(\n        { error: 'Failed to sync campaigns to database' },\n        { status: 500 }\n      )\n    }\n\n    // Now sync ad sets for each campaign\n    let adSetCount = 0\n    for (const campaign of metaCampaigns) {\n      try {\n        const adSets = await fetch(\n          `https://graph.facebook.com/v21.0/${campaign.id}/adsets`,\n          {\n            method: 'GET',\n            headers: {\n              Authorization: `Bearer ${account.access_token}`,\n            },\n          }\n        )\n          .then((res) => res.json())\n          .catch(() => ({ data: [] }))\n\n        if (adSets.data && Array.isArray(adSets.data)) {\n          const adSetsToUpsert = adSets.data.map((adSet: any) => ({\n            id: adSet.id,\n            campaign_id: campaign.id,\n            ad_set_name: adSet.name,\n            ad_set_status: adSet.status,\n            daily_budget: adSet.daily_budget ? adSet.daily_budget / 100 : null,\n            lifetime_budget: adSet.lifetime_budget ? adSet.lifetime_budget / 100 : null,\n            optimization_goal: adSet.optimization_goal,\n            targeting: adSet.targeting || null,\n          }))\n\n          await supabase\n            .from('meta_ad_sets')\n            .upsert(adSetsToUpsert, { onConflict: 'id' })\n            .catch((err) => console.error('Error syncing ad sets:', err))\n\n          adSetCount += adSets.data.length\n        }\n      } catch (error) {\n        console.error(`Error syncing ad sets for campaign ${campaign.id}:`, error)\n      }\n    }\n\n    return NextResponse.json(\n      {\n        success: true,\n        synced: metaCampaigns.length,\n        adSetsSynced: adSetCount,\n        message: `Synced ${metaCampaigns.length} campaigns and ${adSetCount} ad sets`,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Sync error:', error)\n    return NextResponse.json(\n      { error: 'An error occurred during sync' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const POST = createProtectedRoute(handler)\nexport const GET = createProtectedRoute(handler)\n","structuredPatch":[{"oldStart":109,"oldLines":11,"newStart":109,"newLines":14,"lines":["             targeting: adSet.targeting || null,","           }))"," ","-          await supabase","+          const { error: adSetError } = await supabase","             .from('meta_ad_sets')","             .upsert(adSetsToUpsert, { onConflict: 'id' })","-            .catch((err) => console.error('Error syncing ad sets:', err))"," ","+          if (adSetError) {","+            console.error('Error syncing ad sets:', adSetError)","+          }","+","           adSetCount += adSets.data.length","         }","       } catch (error) {"]}],"userModified":false,"replaceAll":false}}
