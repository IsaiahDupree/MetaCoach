{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_014ZxB67t5Wm2dFVegNCBKXL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B2RM7Ca3HNuvH4qoTYdZyc","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/MetaCoach/app/api/recommendations/generate/route.ts","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\nimport { createProtectedRoute } from '@/lib/auth-middleware'\nimport { RecommendationEngine } from '@/lib/recommendation-engine'\n\nconst handler = async (req: NextRequest & { userId?: string }) => {\n  try {\n    if (!req.userId) {\n      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })\n    }\n\n    const supabase = supabaseAdmin()\n    const accountId = req.nextUrl.searchParams.get('account_id')\n\n    if (!accountId) {\n      return NextResponse.json(\n        { error: 'account_id query parameter is required' },\n        { status: 400 }\n      )\n    }\n\n    // Verify account ownership\n    const { data: account, error: accountError } = await supabase\n      .from('meta_accounts')\n      .select('id')\n      .eq('id', accountId)\n      .eq('user_id', req.userId)\n      .single()\n\n    if (accountError || !account) {\n      return NextResponse.json(\n        { error: 'Account not found or unauthorized' },\n        { status: 404 }\n      )\n    }\n\n    // Generate recommendations using the engine\n    const engine = new RecommendationEngine()\n    let recommendations = await engine.generateRecommendations(accountId)\n\n    // Score and rank recommendations\n    recommendations = engine.scoreRecommendations(recommendations)\n\n    // Store recommendations in database\n    const recsToInsert = recommendations.map((rec) => ({\n      meta_account_id: accountId,\n      recommendation_type: rec.recommendation_type,\n      title: rec.title,\n      description: rec.description,\n      confidence_score: rec.confidence_score,\n      estimated_impact: rec.estimated_impact,\n      estimated_effort: rec.estimated_effort,\n      implementation_instructions: rec.implementation_instructions,\n      is_implemented: false,\n    }))\n\n    if (recsToInsert.length > 0) {\n      const { error: insertError } = await supabase\n        .from('meta_coach_recommendations')\n        .insert(recsToInsert)\n\n      if (insertError) {\n        console.error('Error storing recommendations:', insertError)\n      }\n    }\n\n    return NextResponse.json(\n      {\n        success: true,\n        count: recommendations.length,\n        recommendations: recommendations.slice(0, 10), // Return top 10\n        message: `Generated ${recommendations.length} recommendations`,\n      },\n      { status: 200 }\n    )\n  } catch (error: any) {\n    console.error('Recommendation generation error:', error)\n    return NextResponse.json(\n      { error: 'An error occurred while generating recommendations' },\n      { status: 500 }\n    )\n  }\n}\n\nexport const GET = createProtectedRoute(handler)\nexport const POST = createProtectedRoute(handler)\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":3160,"cache_read_input_tokens":150444,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3160},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"6d7dfb31-5f42-4e27-8e64-42291d7a5910"}
