,\n        period: { from, to },\n        summary: {\n          total_posts: 0,\n          total_reach: 0,\n          total_engagement: 0,\n          avg_engagement_rate: 0,\n          analyzed_posts: 0,\n        },\n        metrics: [],\n      })\n    }\n\n    const page = pages[0]\n    \n    // Get Instagram Business Account\n    const igUserId = await client.getInstagramBusinessAccountId(page.id)\n    if (!igUserId) {\n      return NextResponse.json(\n        { error: 'No Instagram Business Account found' },\n        { status: 404 }\n      )\n    }\n\n    // Fetch media in the time period\n    const allMedia = await client.getMedia(igUserId, 100)\n    const fromDate = new Date(from)\n    const toDate = new Date(to)\n    \n    const mediaInPeriod = allMedia.filter((m) => {","numLines":100,"startLine":1,"totalLines":281}}}
