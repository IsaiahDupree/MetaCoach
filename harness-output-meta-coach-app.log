{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011WwZdUBpjiVt1PEX4BHkht","type":"tool_result","content":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\n\ninterface HealthResponse {\n  status: 'healthy' | 'degraded' | 'unhealthy'\n  timestamp: string\n  version: string\n  services: {\n    database: {\n      status: 'up' | 'down'\n      latency_ms: number\n    }\n  }\n  uptime_ms?: number\n}\n\nconst startTime = Date.now()\n\nexport async function GET(req: NextRequest): Promise<NextResponse<HealthResponse>> {\n  const requestStart = Date.now()\n\n  try {\n    // Check database connectivity\n    const dbStart = Date.now()\n    const supabase = supabaseAdmin()\n\n    // Perform a simple query to verify database connection\n    const { error } = await supabase\n      .from('users')\n      .select('count', { count: 'exact', head: true })\n      .limit(0)\n\n    const dbLatency = Date.now() - dbStart\n\n    if (error && error.code !== 'PGRST116') {\n      // PGRST116 is \"no rows returned\" which is expected for a limit(0) query\n      throw error\n    }\n\n    const responseTime = Date.now() - requestStart\n    let overallStatus: 'healthy' | 'degraded' | 'unhealthy' = 'healthy'\n\n    // Degrade if database latency is high\n    if (dbLatency > 1000) {\n      overallStatus = 'degraded'\n    }\n\n    return NextResponse.json<HealthResponse>(\n      {\n        status: overallStatus,","is_error":false}]},"parent_tool_use_id":null,"session_id":"6a331d24-95f8-4ac4-b133-d876c4186d76","uuid":"e6cf4bcc-3fe7-469b-9fba-aa361cfde71b","tool_use_result":{"stdout":"import { NextRequest, NextResponse } from 'next/server'\nimport { supabaseAdmin } from '@/lib/supabase'\n\ninterface HealthResponse {\n  status: 'healthy' | 'degraded' | 'unhealthy'\n  timestamp: string\n  version: string\n  services: {\n    database: {\n      status: 'up' | 'down'\n      latency_ms: number\n    }\n  }\n  uptime_ms?: number\n}