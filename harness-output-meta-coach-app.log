{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BfUdupV1mygq7xnvXSpQPp","type":"tool_result","content":"     1→import axios from 'axios'\n     2→import type { InstagramMedia, InstagramInsights, MetaOAuthTokenResponse } from './types'\n     3→\n     4→const META_GRAPH_URL = 'https://graph.facebook.com/v21.0'\n     5→\n     6→export class MetaClient {\n     7→  private accessToken: string\n     8→\n     9→  constructor(accessToken: string) {\n    10→    this.accessToken = accessToken\n    11→  }\n    12→\n    13→  // Exchange short-lived token for long-lived token (60 days)\n    14→  static async exchangeForLongLivedToken(shortLivedToken: string): Promise<MetaOAuthTokenResponse> {\n    15→    const response = await axios.get(`${META_GRAPH_URL}/oauth/access_token`, {\n    16→      params: {\n    17→        grant_type: 'fb_exchange_token',\n    18→        client_id: process.env.META_APP_ID!,\n    19→        client_secret: process.env.META_APP_SECRET!,\n    20→        fb_exchange_token: shortLivedToken,\n    21→      },\n    22→    })\n    23→    return response.data\n    24→  }\n    25→\n    26→  // Get Instagram Business Account ID from Facebook Page\n    27→  async getInstagramBusinessAccountId(pageId: string): Promise<string> {\n    28→    const response = await axios.get(`${META_GRAPH_URL}/${pageId}`, {\n    29→      params: {\n    30→        fields: 'instagram_business_account',\n    31→        access_token: this.accessToken,\n    32→      },\n    33→    })\n    34→    return response.data.instagram_business_account?.id\n    35→  }\n    36→\n    37→  // Get user's Instagram Business account ID from a Facebook page\n    38→  async getInstagramBusinessAccount(pageId: string): Promise<string> {\n    39→    const response = await axios.get(\n    40→      `https://graph.facebook.com/v21.0/${pageId}`,\n    41→      {\n    42→        params: {\n    43→          access_token: this.accessToken,\n    44→          fields: 'instagram_business_account',\n    45→        },\n    46→      }\n    47→    )\n    48→    return response.data.instagram_business_account?.id\n    49→  }\n    50→\n    51→  // Get user's Facebook Pages\n    52→  async getPages(): Promise<Array<{ id: string; name: string; access_token?: string }>> {\n    53→    const response = await axios.get(`${META_GRAPH_URL}/me/accounts`, {\n    54→      params: {\n    55→        access_token: this.accessToken,\n    56→        fields: 'id,name,access_token',\n    57→      },\n    58→    })\n    59→    return response.data.data || []\n    60→  }\n    61→\n    62→  // Get user's Instagram media (posts)\n    63→  async getMedia(igUserId: string, limit = 25): Promise<InstagramMedia[]> {\n    64→    const response = await axios.get(`${META_GRAPH_URL}/${igUserId}/media`, {\n    65→      params: {\n    66→        fields: 'id,caption,media_type,media_url,permalink,thumbnail_url,timestamp',\n    67→        limit,\n    68→        access_token: this.accessToken,\n    69→      },\n    70→    })\n    71→    return response.data.data || []\n    72→  }\n    73→\n    74→  // Get insights for a specific media item\n    75→  async getMediaInsights(mediaId: string): Promise<InstagramInsights> {\n    76→    try {\n    77→      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/insights`, {\n    78→        params: {\n    79→          metric: 'reach,likes,comments,shares,saves,plays,total_interactions',\n    80→          access_token: this.accessToken,\n    81→        },\n    82→      })\n    83→      \n    84→      const insights: InstagramInsights = {}\n    85→      response.data.data?.forEach((item: any) => {\n    86→        insights[item.name as keyof InstagramInsights] = item.values?.[0]?.value || 0\n    87→      })\n    88→      \n    89→      return insights\n    90→    } catch (error) {\n    91→      // Some media types don't support insights\n    92→      console.error('Error fetching insights:', error)\n    93→      return {}\n    94→    }\n    95→  }\n    96→\n    97→  // Get comments for a media item\n    98→  async getMediaComments(mediaId: string, limit = 50): Promise<Array<{ id: string; text: string; username: string; timestamp: string }>> {\n    99→    try {\n   100→      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/comments`, {\n   101→        params: {\n   102→          fields: 'id,text,username,timestamp',\n   103→          limit,\n   104→          access_token: this.accessToken,\n   105→        },\n   106→      })\n   107→      return response.data.data || []\n   108→    } catch (error) {\n   109→      console.error('Error fetching comments:', error)\n   110→      return []\n   111→    }\n   112→  }\n   113→\n   114→  // Get short-lived media URL (for ephemeral download)\n   115→  async getMediaUrl(mediaId: string): Promise<string | null> {\n   116→    try {\n   117→      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}`, {\n   118→        params: {\n   119→          fields: 'media_url',\n   120→          access_token: this.accessToken,\n   121→        },\n   122→      })\n   123→      return response.data.media_url || null\n   124→    } catch (error) {\n   125→      console.error('Error fetching media URL:', error)\n   126→      return null\n   127→    }\n   128→  }\n   129→\n   130→  // Get Facebook Page posts\n   131→  async getFacebookPagePosts(pageId: string, limit = 25) {\n   132→    const response = await axios.get(`${META_GRAPH_URL}/${pageId}/posts`, {\n   133→      params: {\n   134→        access_token: this.accessToken,\n   135→        fields: 'id,message,created_time,full_picture,permalink_url,shares,reactions.summary(true),comments.summary(true)',\n   136→        limit,\n   137→      },\n   138→    })\n   139→    return response.data.data || []\n   140→  }\n   141→\n   142→  // Get Facebook Page insights\n   143→  async getFacebookPageInsights(pageId: string, metrics = ['page_impressions', 'page_engaged_users', 'page_fans']) {\n   144→    try {\n   145→      const response = await axios.get(`${META_GRAPH_URL}/${pageId}/insights`, {\n   146→        params: {\n   147→          access_token: this.accessToken,\n   148→          metric: metrics.join(','),\n   149→          period: 'day',\n   150→        },\n   151→      })\n   152→      return response.data.data || []\n   153→    } catch (error) {\n   154→      console.error('Error fetching page insights:', error)\n   155→      return []\n   156→    }\n   157→  }\n   158→\n   159→  // Get ad accounts\n   160→  async getAdAccounts() {\n   161→    const response = await axios.get(`${META_GRAPH_URL}/me/adaccounts`, {\n   162→      params: {\n   163→        access_token: this.accessToken,\n   164→        fields: 'id,name,account_status,currency,timezone_name,amount_spent',\n   165→      },\n   166→    })\n   167→    return response.data.data || []\n   168→  }\n   169→\n   170→  // Get campaigns for an ad account\n   171→  async getCampaigns(adAccountId: string, limit = 25) {\n   172→    const response = await axios.get(`${META_GRAPH_URL}/${adAccountId}/campaigns`, {\n   173→      params: {\n   174→        access_token: this.accessToken,\n   175→        fields: 'id,name,objective,status,effective_status,daily_budget,lifetime_budget,created_time,updated_time',\n   176→        limit,\n   177→      },\n   178→    })\n   179→    return response.data.data || []\n   180→  }\n   181→\n   182→  // Get campaign insights\n   183→  async getCampaignInsights(campaignId: string) {\n   184→    try {\n   185→      const response = await axios.get(`${META_GRAPH_URL}/${campaignId}/insights`, {\n   186→        params: {\n   187→          access_token: this.accessToken,\n   188→          fields: 'impressions,reach,clicks,spend,cpc,cpm,ctr,conversions',\n   189→        },\n   190→      })\n   191→      return response.data.data?.[0] || null\n   192→    } catch (error) {\n   193→      console.error('Error fetching campaign insights:', error)\n   194→      return null\n   195→    }\n   196→  }\n   197→\n   198→  // Get Threads posts (if available)\n   199→  async getThreadsPosts(threadsUserId: string, limit = 25) {\n   200→    try {\n   201→      const response = await axios.get(`${META_GRAPH_URL}/${threadsUserId}/threads`, {\n   202→        params: {\n   203→          access_token: this.accessToken,\n   204→          fields: 'id,text,timestamp,permalink,media_type,media_url,thumbnail_url,is_quote_post',\n   205→          limit,\n   206→        },\n   207→      })\n   208→      return response.data.data || []\n   209→    } catch (error) {\n   210→      // Threads may not be available\n   211→      return []\n   212→    }\n   213→  }\n   214→\n   215→  // Get Threads insights\n   216→  async getThreadsInsights(mediaId: string) {\n   217→    try {\n   218→      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/insights`, {\n   219→        params: {\n   220→          access_token: this.accessToken,\n   221→          metric: 'views,likes,replies,reposts,quotes',\n   222→        },\n   223→      })\n   224→      return response.data.data || []\n   225→    } catch (error) {\n   226→      return []\n   227→    }\n   228→  }\n   229→}\n   230→\n   231→// OAuth helper functions\n   232→export function getMetaAuthUrl(state: string): string {\n   233→  const params = new URLSearchParams({\n   234→    client_id: process.env.META_APP_ID!,\n   235→    redirect_uri: process.env.META_REDIRECT_URL!,\n   236→    state,\n   237→    scope: 'instagram_basic,instagram_manage_insights,pages_read_engagement,pages_show_list,pages_read_user_content,ads_read,business_management,read_insights,public_profile',\n   238→  })\n   239→  return `https://www.facebook.com/v21.0/dialog/oauth?${params.toString()}`\n   240→}\n   241→\n   242→export async function exchangeCodeForToken(code: string): Promise<MetaOAuthTokenResponse> {\n   243→  const response = await axios.get(`${META_GRAPH_URL}/oauth/access_token`, {\n   244→    params: {\n   245→      client_id: process.env.META_APP_ID!,\n   246→      client_secret: process.env.META_APP_SECRET!,\n   247→      redirect_uri: process.env.META_REDIRECT_URL!,\n   248→      code,\n   249→    },\n   250→  })\n   251→  return response.data\n   252→}\n   253→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"4d29208c-3343-49be-931f-735c42911655","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/MetaCoach/lib/meta.ts","content":"import axios from 'axios'\nimport type { InstagramMedia, InstagramInsights, MetaOAuthTokenResponse } from './types'\n\nconst META_GRAPH_URL = 'https://graph.facebook.com/v21.0'\n\nexport class MetaClient {\n  private accessToken: string\n\n  constructor(accessToken: string) {\n    this.accessToken = accessToken\n  }\n\n  // Exchange short-lived token for long-lived token (60 days)\n  static async exchangeForLongLivedToken(shortLivedToken: string): Promise<MetaOAuthTokenResponse> {\n    const response = await axios.get(`${META_GRAPH_URL}/oauth/access_token`, {\n      params: {\n        grant_type: 'fb_exchange_token',\n        client_id: process.env.META_APP_ID!,\n        client_secret: process.env.META_APP_SECRET!,\n        fb_exchange_token: shortLivedToken,\n      },\n    })\n    return response.data\n  }\n\n  // Get Instagram Business Account ID from Facebook Page\n  async getInstagramBusinessAccountId(pageId: string): Promise<string> {\n    const response = await axios.get(`${META_GRAPH_URL}/${pageId}`, {\n      params: {\n        fields: 'instagram_business_account',\n        access_token: this.accessToken,\n      },\n    })\n    return response.data.instagram_business_account?.id\n  }\n\n  // Get user's Instagram Business account ID from a Facebook page\n  async getInstagramBusinessAccount(pageId: string): Promise<string> {\n    const response = await axios.get(\n      `https://graph.facebook.com/v21.0/${pageId}`,\n      {\n        params: {\n          access_token: this.accessToken,\n          fields: 'instagram_business_account',\n        },\n      }\n    )\n    return response.data.instagram_business_account?.id\n  }\n\n  // Get user's Facebook Pages\n  async getPages(): Promise<Array<{ id: string; name: string; access_token?: string }>> {\n    const response = await axios.get(`${META_GRAPH_URL}/me/accounts`, {\n      params: {\n        access_token: this.accessToken,\n        fields: 'id,name,access_token',\n      },\n    })\n    return response.data.data || []\n  }\n\n  // Get user's Instagram media (posts)\n  async getMedia(igUserId: string, limit = 25): Promise<InstagramMedia[]> {\n    const response = await axios.get(`${META_GRAPH_URL}/${igUserId}/media`, {\n      params: {\n        fields: 'id,caption,media_type,media_url,permalink,thumbnail_url,timestamp',\n        limit,\n        access_token: this.accessToken,\n      },\n    })\n    return response.data.data || []\n  }\n\n  // Get insights for a specific media item\n  async getMediaInsights(mediaId: string): Promise<InstagramInsights> {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/insights`, {\n        params: {\n          metric: 'reach,likes,comments,shares,saves,plays,total_interactions',\n          access_token: this.accessToken,\n        },\n      })\n      \n      const insights: InstagramInsights = {}\n      response.data.data?.forEach((item: any) => {\n        insights[item.name as keyof InstagramInsights] = item.values?.[0]?.value || 0\n      })\n      \n      return insights\n    } catch (error) {\n      // Some media types don't support insights\n      console.error('Error fetching insights:', error)\n      return {}\n    }\n  }\n\n  // Get comments for a media item\n  async getMediaComments(mediaId: string, limit = 50): Promise<Array<{ id: string; text: string; username: string; timestamp: string }>> {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/comments`, {\n        params: {\n          fields: 'id,text,username,timestamp',\n          limit,\n          access_token: this.accessToken,\n        },\n      })\n      return response.data.data || []\n    } catch (error) {\n      console.error('Error fetching comments:', error)\n      return []\n    }\n  }\n\n  // Get short-lived media URL (for ephemeral download)\n  async getMediaUrl(mediaId: string): Promise<string | null> {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}`, {\n        params: {\n          fields: 'media_url',\n          access_token: this.accessToken,\n        },\n      })\n      return response.data.media_url || null\n    } catch (error) {\n      console.error('Error fetching media URL:', error)\n      return null\n    }\n  }\n\n  // Get Facebook Page posts\n  async getFacebookPagePosts(pageId: string, limit = 25) {\n    const response = await axios.get(`${META_GRAPH_URL}/${pageId}/posts`, {\n      params: {\n        access_token: this.accessToken,\n        fields: 'id,message,created_time,full_picture,permalink_url,shares,reactions.summary(true),comments.summary(true)',\n        limit,\n      },\n    })\n    return response.data.data || []\n  }\n\n  // Get Facebook Page insights\n  async getFacebookPageInsights(pageId: string, metrics = ['page_impressions', 'page_engaged_users', 'page_fans']) {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${pageId}/insights`, {\n        params: {\n          access_token: this.accessToken,\n          metric: metrics.join(','),\n          period: 'day',\n        },\n      })\n      return response.data.data || []\n    } catch (error) {\n      console.error('Error fetching page insights:', error)\n      return []\n    }\n  }\n\n  // Get ad accounts\n  async getAdAccounts() {\n    const response = await axios.get(`${META_GRAPH_URL}/me/adaccounts`, {\n      params: {\n        access_token: this.accessToken,\n        fields: 'id,name,account_status,currency,timezone_name,amount_spent',\n      },\n    })\n    return response.data.data || []\n  }\n\n  // Get campaigns for an ad account\n  async getCampaigns(adAccountId: string, limit = 25) {\n    const response = await axios.get(`${META_GRAPH_URL}/${adAccountId}/campaigns`, {\n      params: {\n        access_token: this.accessToken,\n        fields: 'id,name,objective,status,effective_status,daily_budget,lifetime_budget,created_time,updated_time',\n        limit,\n      },\n    })\n    return response.data.data || []\n  }\n\n  // Get campaign insights\n  async getCampaignInsights(campaignId: string) {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${campaignId}/insights`, {\n        params: {\n          access_token: this.accessToken,\n          fields: 'impressions,reach,clicks,spend,cpc,cpm,ctr,conversions',\n        },\n      })\n      return response.data.data?.[0] || null\n    } catch (error) {\n      console.error('Error fetching campaign insights:', error)\n      return null\n    }\n  }\n\n  // Get Threads posts (if available)\n  async getThreadsPosts(threadsUserId: string, limit = 25) {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${threadsUserId}/threads`, {\n        params: {\n          access_token: this.accessToken,\n          fields: 'id,text,timestamp,permalink,media_type,media_url,thumbnail_url,is_quote_post',\n          limit,\n        },\n      })\n      return response.data.data || []\n    } catch (error) {\n      // Threads may not be available\n      return []\n    }\n  }\n\n  // Get Threads insights\n  async getThreadsInsights(mediaId: string) {\n    try {\n      const response = await axios.get(`${META_GRAPH_URL}/${mediaId}/insights`, {\n        params: {\n          access_token: this.accessToken,\n          metric: 'views,likes,replies,reposts,quotes',\n        },\n      })\n      return response.data.data || []\n    } catch (error) {\n      return []\n    }\n  }\n}\n\n// OAuth helper functions\nexport function getMetaAuthUrl(state: string): string {\n  const params = new URLSearchParams({\n    client_id: process.env.META_APP_ID!,\n    redirect_uri: process.env.META_REDIRECT_URL!,\n    state,\n    scope: 'instagram_basic,instagram_manage_insights,pages_read_engagement,pages_show_list,pages_read_user_content,ads_read,business_management,read_insights,public_profile',\n  })\n  return `https://www.facebook.com/v21.0/dialog/oauth?${params.toString()}`\n}\n\nexport async function exchangeCodeForToken(code: string): Promise<MetaOAuthTokenResponse> {\n  const response = await axios.get(`${META_GRAPH_URL}/oauth/access_token`, {\n    params: {\n      client_id: process.env.META_APP_ID!,\n      client_secret: process.env.META_APP_SECRET!,\n      redirect_uri: process.env.META_REDIRECT_URL!,\n      code,\n    },\n  })\n  return response.data\n}\n","numLines":253,"startLine":1,"totalLines":253}}}
