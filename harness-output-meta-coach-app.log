{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01Nimbe1wABMpypAnXgC37jf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013n5en1Nz1rWz8R4PUJiSg9","name":"mcp__supabase__apply_migration","input":{"name":"004_ad_performance_schema","query":"\n-- Create ad_sets table if not exists\nCREATE TABLE IF NOT EXISTS ad_sets (\n  id TEXT PRIMARY KEY,\n  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  adset_name TEXT NOT NULL,\n  adset_status TEXT,\n  daily_budget DECIMAL(15, 2),\n  lifetime_budget DECIMAL(15, 2),\n  optimization_goal TEXT,\n  targeting JSONB,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ads table if not exists\nCREATE TABLE IF NOT EXISTS ads (\n  id TEXT PRIMARY KEY,\n  adset_id TEXT NOT NULL REFERENCES ad_sets(id) ON DELETE CASCADE,\n  ad_name TEXT NOT NULL,\n  ad_status TEXT,\n  creative_id TEXT,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create ad_performance_metrics table\nCREATE TABLE IF NOT EXISTS ad_performance_metrics (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  ad_id TEXT NOT NULL REFERENCES ads(id) ON DELETE CASCADE,\n  date DATE NOT NULL,\n  impressions BIGINT DEFAULT 0,\n  clicks BIGINT DEFAULT 0,\n  spend DECIMAL(15, 4) DEFAULT 0,\n  actions BIGINT DEFAULT 0,\n  action_value DECIMAL(15, 4) DEFAULT 0,\n  ctr DECIMAL(8, 4),\n  cpc DECIMAL(15, 4),\n  cpa DECIMAL(15, 4),\n  roas DECIMAL(8, 4),\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE(ad_id, date)\n);\n\n-- Create recommendations table\nCREATE TABLE IF NOT EXISTS recommendations (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  campaign_id TEXT NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  recommendation_type TEXT NOT NULL,\n  title TEXT NOT NULL,\n  description TEXT,\n  confidence_score DECIMAL(5, 2),\n  estimated_impact DECIMAL(8, 2),\n  estimated_effort TEXT,\n  implementation_instructions TEXT,\n  is_implemented BOOLEAN DEFAULT FALSE,\n  implemented_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create alerts table\nCREATE TABLE IF NOT EXISTS alerts (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  meta_account_id TEXT NOT NULL REFERENCES meta_accounts(id) ON DELETE CASCADE,\n  alert_type TEXT NOT NULL,\n  severity TEXT DEFAULT 'info',\n  title TEXT NOT NULL,\n  description TEXT,\n  threshold_value DECIMAL(15, 4),\n  current_value DECIMAL(15, 4),\n  is_resolved BOOLEAN DEFAULT FALSE,\n  resolved_at TIMESTAMP WITH TIME ZONE,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create indexes\nCREATE INDEX IF NOT EXISTS idx_ad_sets_campaign_id ON ad_sets(campaign_id);\nCREATE INDEX IF NOT EXISTS idx_ads_adset_id ON ads(adset_id);\nCREATE INDEX IF NOT EXISTS idx_ad_performance_metrics_ad_id ON ad_performance_metrics(ad_id);\nCREATE INDEX IF NOT EXISTS idx_ad_performance_metrics_date ON ad_performance_metrics(date);\nCREATE INDEX IF NOT EXISTS idx_recommendations_campaign_id ON recommendations(campaign_id);\nCREATE INDEX IF NOT EXISTS idx_alerts_meta_account_id ON alerts(meta_account_id);\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":4141,"cache_read_input_tokens":114885,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4141},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"55793a17-4f50-4b66-a54a-24d9bccc2747","uuid":"24598cb8-12ed-4ae1-940a-cad18d389309"}
