             className={\n                            rec.priority === 'high'\n                              ? 'text-red-500'\n                              : rec.priority === 'medium'\n                                ? 'text-yellow-500'\n                                : 'text-blue-500'\n                          }\n                          size={20}\n                        />\n                        <div className=\"flex-1\">\n                          <p className=\"font-semibold text-gray-900\">{rec.title}</p>\n                          <p className=\"text-sm text-gray-600 mt-1\">\n                            {rec.description}\n                          </p>\n                          <div className=\"flex items-center gap-4 mt-2\">\n                            <span className=\"text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded\">\n                              Confidence: {(rec.confidence_score * 100).toFixed(0)}%\n                            </span>\n                            <span className=\"text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded\">\n                              Impact: {(rec.estimated_impact * 100).toFixed(0)}%\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n          </>\n        ) : (\n          <div className=\"text-center py-12 bg-white rounded-lg shadow\">\n            <p className=\"text-gray-600\">Select an account to view performance data</p>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":330,"oldLines":7,"newStart":330,"newLines":14,"lines":["                 </div>","                 <div className=\"divide-y\">","                   {recommendations.slice(0, 5).map((rec) => (","-                    <div key={rec.id} className=\"px-6 py-4\">","+                    <div","+                      key={rec.id}","+                      className=\"px-6 py-4 cursor-pointer hover:bg-gray-50 transition\"","+                      onClick={() => {","+                        setSelectedRecommendation(rec)","+                        setShowModal(true)","+                      }}","+                    >","                       <div className=\"flex items-start gap-3\">","                         <AlertCircle","                           className={"]},{"oldStart":368,"oldLines":6,"newStart":375,"newLines":19,"lines":["             <p className=\"text-gray-600\">Select an account to view performance data</p>","           </div>","         )}","+","+        {/* Recommendation Modal */}","+        <RecommendationModal","+          recommendation={selectedRecommendation}","+          isOpen={showModal}","+          onClose={() => setShowModal(false)}","+        />","+          </>","+        ) : (","+          <div className=\"text-center py-12 bg-white rounded-lg shadow\">","+            <p className=\"text-gray-600\">Select an account to view performance data</p>","+          </div>","+        )}","       </div>","     </div>","   )"]}],"userModified":false,"replaceAll":false}}
