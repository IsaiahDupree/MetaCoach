{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "headers": [
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/learn",
      "destination": "https://authority-os-iota.vercel.app/api/editorial/public/matrixloop"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://authority-os-iota.vercel.app/api/editorial/public/matrixloop/:path*"
    }
  ]
}
